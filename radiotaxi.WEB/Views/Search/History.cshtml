@model PagedList.IPagedList<radiotaxi.Model.taxiService>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = "Histórico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div id="content-header">
    <div id="breadcrumb"> <a href="/" title="Go to Home" class="tip-bottom"><i class="icon-home"></i> Home</a> <a href="/Search/" class="tip-bottom">Búsqueda</a> </div>
    <h1>Búsqueda de históricos</h1>
</div>
<div class="container-fluid">
    <hr>
    <div class="row-fluid">
        <div class="span12">
            <div class="widget-box">
                <div class="widget-title">
                    <span class="icon"> <i class="icon-align-justify"></i> </span>
                    <h5>Datos de busqueda</h5>
                </div>
                <div class="widget-content nopadding">
                    @using (Html.BeginForm("History", "Search", FormMethod.Get, new { @class = "form-horizontal", id = "historyForm" }))
                    {
                        <div class="control-group">
                            <label class="control-label">Número telefónico :</label>
                            <div class="controls">
                                @Html.TextBox("phoneNumber", ViewBag.phoneNumberValue as string)
                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Número radio taxi</label>
                            <div class="controls">
                                @Html.TextBox("rtNumber", ViewBag.rtNumberValue as string)
                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Fecha Inicial</label>
                            <div class="controls">
                                <div id="datetimepicker2" class="input-append">
                                    @Html.TextBox("datePickUp", ViewBag.datePickUpValue as string)
                                    <span class="add-on timepickerCalendar">
                                        <i class="icon-calendar"></i>
                                    </span>

                                </div>
                                <button type="button" id="reset-date" class="icon-remove-circle"></button>

                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Fecha Final</label>
                            <div class="controls">
                                <div id="datetimepicker2" class="input-append">
                                    @Html.TextBox("datePickUp2", ViewBag.datePickUpValue2 as string)
                                    <span class="add-on timepickerCalendar">
                                        <i class="icon-calendar"></i>
                                    </span>

                                </div>
                                <button title="limpiar fecha" type="button" id="reset-date2" class="icon-remove-circle"></button>
                            </div>
                        </div>
                        <div class="control-group">
                            <label class="control-label">Número de filas</label>
                            <div class="controls">
                                @Html.TextBox("size", ViewBag.sizeValue as string)
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" name="searchd" id="searchd" value="Buscar" class="btn btn-success">Buscar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row-fluid">
        <div class="span12">
            <div class="widget-box">
                <div class="widget-title">
                    <span class="icon"><i class="icon-th"></i></span>
                    <h5>Servicios Radio Taxi</h5>
                </div>
                <div id="dvSearchServicesResult" class="widget-content nopadding">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>
                                    Teléfono Cliente
                                </th>
                                <th>
                                    Fecha solicitado
                                </th>
                                <th>
                                    Hora del Servicio
                                </th>
                                <th>
                                    Origen
                                </th>
                                <th>
                                    Observación
                                </th>
                                <th>
                                    Número RT
                                </th>
                                <th>
                                    Estado
                                </th>
                                <th>
                                    Renovación Automática
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.phoneId)
                                    </td>
                                    <td>
                                        @item.dateRequested.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @item.datePickUp.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.startPoint)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.note)
                                    </td>
                                    <td>
                                        @{
                                string numeros = "*";
                                if (item.rtNumberServices.Count > 0)
                                {
                                    foreach (var rtItem in item.rtNumberServices)
                                    {
                                        numeros = rtItem.rtNumber + ", " + numeros;
                                    }
                                    numeros = numeros.Replace(", *", "");
                                    @Html.Raw(numeros);
                                }
                                else
                                {
                                    @Html.Raw("");
                                }
                                        }
                                    </td>
                                    <td>
                                        @switch (item.statusServiceId)
                                        {
                                            case 1:
                                                @Html.Raw("Asignado");
                                                                     break;
                                            case 2:
                                            @Html.Raw("Pendiente");
                                                                  break;
                                            case 3:
                                            @Html.Raw("Cancelado");
                                                                  break;
                                        }
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.autoRenew)
                                    </td>
                                    <td>
                                        <a href="/TaxiService/Edit/@item.id" class="btn btn-mini btn-primary"><i class="icon-edit"></i></a>
                                        <a href="/TaxiService/Details/@item.id" class="btn btn-mini btn-primary"><i class="icon-cog"></i></a>
                                        <a href="/TaxiService/Delete/@item.id" class=" btn btn-mini btn-primary"><i class="icon-remove"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
            @Html.PagedListPager(Model, page => Url.Action("History",
                              new { page, phoneNumber = ViewBag.phoneNumberValue, rtNumber = ViewBag.rtNumberValue, datePickUp = ViewBag.datePickUpValue, datePickUp2 = ViewBag.datePickUpValue2, size = ViewBag.sizeValue }))
        </div>
        <!--End-Chart-box-->
        <hr />
    </div>
    <!--<div class="row-fluid">
        <div class="span12" id="dvSearchServicesResult">
        </div>
    </div>-->

</div>

@section Scripts {
    @Scripts.Render("~/bundles/formBundle")
    <script>
        //$('.textarea_editor').wysihtml5();
        var time = $('.timepicker').wickedpicker({ twentyFour: true });
        $("#datePickUp").datepicker({ format: 'dd-mm-yyyy', });

        $(document).on('click', ".wickedpicker__close", function () {
            var split = $("#datePickUp").val().split(" ");
            $("#datePickUp").val(split[0]);
            $("#datePickUp").val($("#datePickUp").val() + " " + $(".wickedpicker__controls__control--hours").text());
            $("#datePickUp").val($("#datePickUp").val() + ":" + $(".wickedpicker__controls__control--minutes").text());
            //alert("cancel wicked");
        });

        var time2 = $('.timepicker2').wickedpicker({ close: 'wickedpicker__close2', twentyFour: true });

        $("#datePickUp2").datepicker({ format: 'dd-mm-yyyy', });

        $(document).on('click', ".wickedpicker__close2", function () {
            var split = $("#datePickUp2").val().split(" ");
            $("#datePickUp2").val(split[0]);
            $("#datePickUp2").val($("#datePickUp2").val() + " " + $(".wickedpicker__controls__control--hours").text());
            $("#datePickUp2").val($("#datePickUp2").val() + ":" + $(".wickedpicker__controls__control--minutes").text());
            //alert("cancel wicked");
        });

        $(document).on('click', "#reset-date", function () {
            $('#datePickUp').val("");
        });

        $(document).on('click', "#reset-date2", function () {
            $('#datePickUp2').val("");
        });

    </script>
}