@model radiotaxi.Model.Convenio

@{
    ViewBag.Title = "Detalles convenio";
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-3">

        <div class="row align-items-center">

            <div class="col-lg-6">
                <h5 class="mb-0 fw-bold">Comparación de convenio</h5>
                <small class="text-muted">
                    Busca otro convenio para compararlo con el convenio actual.
                </small>
            </div>

            <div class="col-lg-6">

                <div class="d-flex justify-content-end mb-3"
                     v-if="!mostrarBuscadorComparacion">

                    <button class="btn btn-primary"
                            v-on:click="abrirPanelComparacion">
                        Comparar convenio
                    </button>
                </div>

                <div v-if="mostrarBuscadorComparacion"
                     class="d-flex justify-content-end">

                    <form v-on:submit.prevent="searchagreement(convenioBuscar,'@Model.CargoANum')">

                        <div class="d-flex align-items-center gap-2">

                            <input type="text"
                                   ref="inputConvenioComparar"
                                   class="form-control"
                                   style="width:240px;"
                                   v-model="convenioBuscar"
                                   placeholder="Número de convenio"
                                   autocomplete="off" />

                            <button class="btn btn-primary"
                                    type="submit">
                                Buscar
                            </button>

                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    v-if="mostrarComparacion"
                                    v-on:click="limpiarComparacion">
                                Limpiar
                            </button>

                            <button class="btn btn-outline-danger"
                                    type="button"
                                    v-on:click="cerrarPanelComparacion">
                                Cerrar
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

<div class="row g-4">

    <div class="col-12 col-xl-6">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">

                <div>
                    <h4 class="mb-1 fw-bold">Convenio #@Model.Id_Op</h4>
                    <div class="text-secondary">@Model.Concepto</div>
                </div>

                <div class="d-flex align-items-center">

                    <span class="badge bg-success fs-6 px-3 py-2 me-2">
                        @Model.Status
                    </span>

                    @if (Model.Status == "VIGENTE" && Permissions.allow("Admin"))
                    {
                        <button class="btn btn-danger px-3"
                                v-on:click="cancelconvenio('@Model.Id_Op')">

                            <i class="fa fa-ban me-2"></i>
                            Cancelar convenio

                        </button>
                    }

                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Secretaría</small>
                        <div class="fs-5 fw-semibold">@Model.Secretaria</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Usuario</small>
                        <div class="fs-5 fw-semibold">@Model.Usuario</div>
                        <div class="text-muted">ID: @Model.Id_Usuario</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Cargo a</small>
                        <div class="fs-5 fw-semibold">@(Model.CargoA == 2 ? "Contra" : "Favor")</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Socio</small>
                        <div class="fs-5 fw-semibold">@Model.CargoANum</div>
                        <div class="fs-6">@Model.CargoANombre</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Monto</small>
                        <div class="fs-3 fw-bold text-success">@String.Format("{0:C}", Model.Monto)</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Importe pago</small>
                        <div class="fs-5 fw-semibold">@String.Format("{0:C}", Model.ImportePago)</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Partidas</small>
                        <div class="fs-5 fw-semibold">@String.Format("{0:0}", Model.Partidas)</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Plazo</small>
                        <div class="fs-5 fw-semibold">@String.Format("{0:0}", Model.Plazo)</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Primer vencimiento</small>
                        <div class="fs-5 fw-semibold">@String.Format("{0:dd/MM/yyyy}", Model.PrimerVencimiento)</div>
                    </div>

                    <div class="col-md-6">
                        <small class="fw-semibold text-secondary d-block mb-1">Fecha operación</small>
                        <div class="fs-5 fw-semibold">
                            @String.Format("{0:dd/MM/yyyy}", Model.FechaOp)
                            @String.Format("{0:hh:mm tt}", Model.HoraOp)
                        </div>
                    </div>

                    <div class="col-12">
                        <small class="fw-semibold text-secondary d-block mb-1">Observaciones</small>
                        <p class="mb-0 fs-6 lh-base">@Model.Observaciones</p>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Partidas</h4>
            </div>

            <div class="card-body p-0 pb-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Folio</th>
                                <th>Producto</th>
                                <th class="text-end">Importe</th>
                                <th>Vence</th>
                                <th>Fecha pago</th>
                                <th class="text-center">Estatus</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (KeyValuePair<radiotaxi.Model.ConveniosDetalle, radiotaxi.Model.Inventario> item in ViewBag.dic)
                            {
                                <tr>
                                    <td class="text-center"><strong>@item.Key.Folio</strong></td>
                                    <td>@item.Key.Id_Producto</td>
                                    <td class="text-end">@String.Format("{0:C}", item.Key.Importe)</td>
                                    <td>@String.Format("{0:dd/MM/yyyy}", item.Key.Vence)</td>
                                    <td>@(item.Key.FechaPago == null ? "-" : String.Format("{0:dd/MM/yyyy}", item.Key.FechaPago))</td>
                                    <td class="text-center">
                                        <span class="badge px-2 py-1 @(item.Key.Status == "VIGENTE" ? "bg-success" : item.Key.Status == "CANCELADO" ? "bg-danger" : "bg-secondary")">
                                            @item.Key.Status
                                        </span>
                                    </td>
                                    <td>@(item.Value == null ? "" : item.Value.Descripcion)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <div class="col-12 col-xl-6">



        <template v-if="result">

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h4 class="mb-1 fw-bold">Convenio {{result.convenio.Id_Op}}</h4>
                        <div class="text-secondary">{{result.convenio.Concepto}}</div>
                    </div>
                    <span v-if="result.convenio.Status == 'VIGENTE'" class="badge bg-success fs-6 px-3 py-2 me-2">
                        {{result.convenio.Status}}
                    </span>
                    <span v-else class="badge px-2 py-1 bg-danger ">
                        {{result.convenio.Status}}
                    </span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Secretaría</small>
                            <div class="fs-5 fw-semibold">{{result.convenio.Secretaria}}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Usuario</small>
                            <div class="fs-5 fw-semibold">{{result.convenio.Usuario}}</div>
                            <div class="text-muted">ID: {{result.convenio.Id_Usuario}}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Cargo a</small>
                            <div v-if="result.convenio.CargoA == 2" class="fs-5 fw-semibold">Contra</div>
                            <div v-else class="fs-5 fw-semibold">Favor</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Socio</small>
                            <div class="fs-5 fw-semibold">{{result.convenio.CargoANum}}</div>
                            <div class="fs-6">{{result.convenio.CargoANombre}}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Monto</small>
                            <div class="fs-3 fw-bold text-success">{{ money(result.convenio.Monto) }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Importe pago</small>
                            <div class="fs-5 fw-semibold">{{ money(result.convenio.ImportePago) }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Partidas</small>
                            <div class="fs-5 fw-semibold">{{ numberClean(result.convenio.Partidas) }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Plazo</small>
                            <div class="fs-5 fw-semibold">{{ numberClean(result.convenio.Plazo) }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Primer vencimiento</small>
                            <div class="fs-5 fw-semibold"> {{ dateMx(result.convenio.PrimerVencimiento) }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="fw-semibold text-secondary d-block mb-1">Fecha operación</small>
                            <div class="fs-5 fw-semibold">
                                {{ dateMx(result.convenio.FechaOp) }} {{ timeMx(result.convenio.HoraOp) }}
                            </div>
                        </div>

                        <div class="col-12">
                            <small class="fw-semibold text-secondary d-block mb-1">Observaciones</small>
                            <p class="mb-0 fs-6 lh-base">{{result.convenio.Observaciones}}</p>
                        </div>

                    </div>
                </div>
            </div>

        <div class="card shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Partidas</h4>
            </div>

            <div class="card-body p-0 pb-0">
                <div class="table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Folio</th>
                                <th>Producto</th>
                                <th class="text-end">Importe</th>
                                <th>Vence</th>
                                <th>Fecha pago</th>
                                <th class="text-center">Estatus</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr v-for="partida in result.partidas">
                                <td class="text-center">{{partida.detalle.Folio}}</td>
                                <td>{{partida.detalle.Id_Producto}}</td>
                                <td class="text-end">{{partida.detalle.Importe}}</td>
                                <td>{{ dateMx(partida.detalle.Vence) }}</td>
                                <td>{{ dateMx(partida.detalle.FechaPago) }}</td>
                                <td class="text-center">
                                    <span v-if="partida.detalle.Status == 'VIGENTE'" class="badge px-2 py-1 bg-success">
                                        {{partida.detalle.Status}}
                                    </span>
                                    <span v-if="partida.detalle.Status == 'CANCELADO'" class="badge px-2 py-1 bg-danger">
                                        {{partida.detalle.Status}}
                                    </span>
                                    <span v-else class="badge px-2 py-1 bg-secondary">
                                        {{partida.detalle.Status}}
                                    </span>
                                </td>
                                <td v-if="partida.inventario != null">{{partida.inventario.Descripcion}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        </template>

    </div>

</div>

@section Scripts {
    <script src="~/Content/js/Views/Agreements/agreements.js"></script>
}