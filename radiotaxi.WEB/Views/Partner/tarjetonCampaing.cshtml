                                <a v-on:click="generateTicket('G','@(Model.partnerReference)')" href="#" class="btn btn-success waves-effect btn-label waves-light mb-3"><i class="bx bxs-paper-plane label-icon"></i> Generar Cupón</a>
                                @if (Permissions.allow("Admin, Practi-AdminTurkey"))
