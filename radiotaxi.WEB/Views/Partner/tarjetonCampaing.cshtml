                            <li>
                                <p class="mb-1">
                                    <span class="fw-bold">Vencimiento de poliza:</span> @(ViewBag.emplaactual.vencepoliza != null ? Convert.ToDateTime(ViewBag.emplaactual.vencepoliza).ToString("dd/MM/yyyy"): "")
                                </p>
