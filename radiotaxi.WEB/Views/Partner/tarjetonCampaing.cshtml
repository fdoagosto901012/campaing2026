                                    <a v-on:click="generateTicket('D','@(Model.partnerReference)')" href="#" class="btn btn-success waves-effect btn-label waves-light mb-3"><i class="mdi mdi-food-turkey label-icon"></i> Entregar Pavo</a>
                                }
                            </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-block-helper d-block display-4 mt-2 mb-3 text-danger"></i>
