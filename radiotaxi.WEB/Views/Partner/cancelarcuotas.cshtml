@{
    ViewBag.Title = "Cancelar cuotas sindicales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DATOS DE CONTROL JS -->
<input id="gafet" name="gafet" type="hidden" value="@Model.partnerReference" />
<input id="userId" name="userId" type="hidden" value="@Model.userId" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">@Model.partnerReference</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- end page title -->
<div class="row">
    <div class="col-xl-9 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-start mt-3 mt-sm-0">
                            <div class="flex-lg-shrink-0">
                                <div class="avatar-xl me-3">

                                    @if (Model.urlImage != null)
                                    {
                                        <img src="@(Model.urlImage)" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                    else
                                    {
                                        <img src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div>
                                    <h4 class="font-size-18 mb-1 fw-bolder">@(Model.partnerReference != null ? Model.partnerReference : "")</h4>
                                    <h6 class="font-size-14 mb-1">@(Model.firstName != null ? Model.firstName.ToUpper() : "") @(Model.lastNameF != null ? Model.lastNameF.ToUpper() : "") @(Model.lastNameM != null ? Model.lastNameM.ToUpper() :"")</h6>
                                    <p class="text-muted font-size-13 mb-0"> <span class="fw-bold">Fecha de ingreso:</span>@* @(Model.fechaingreso != null ? Model.fechaingreso.Value.ToString("dd/MM/yyyy") : "")*@</p>
                                    <p class="text-muted font-size-13 "><span class="fw-bold">Número telefónico:</span> @(Model.Telefono != null ? Model.Telefono : "")</p>

                                    <div class="d-flex flex-wrap align-items-start gap-2 gap-lg-3 text-muted font-size-13">
                                        <div><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>Development</div>
                                        <div><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>phyllisgatlin@minia.com</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- FIN PERFIL-->
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-end mt-3 mt-sm-0">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-6">
                                        <span class="text-muted mb-3 lh-1 d-block text-truncate">
                                            Deuda total en cuotas sindicales
                                        </span>
                                        <h4 class="mb-3">
                                            <span>@(ViewBag.amount.ToString("C", new System.Globalization.CultureInfo("es-MX"))) </span> MXN
                                        </h4>
                                    </div>
                                </div>
                                <div class="text-nowrap">
                                    <span class="badge bg-danger-subtle text-danger">@(ViewBag.total)</span>
                                    <span class="ms-1 text-muted font-size-13">Cuotas vencidas</span>
                                </div>
                            </div>
                        </div>
                    </div> <!-- FIN PORCENTAJE-->
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
        <div class="tab-content">
            <div class="tab-pane active" id="general" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Cancelar cuotas sindicales</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <form method="POST" action="/partner/cuotas/sindicales/@(Model.partnerReference)" class="hstack gap-3" v-on:submit="onSubmit">
                                <div class="mb-3 col-3">
                                    <label for="cant" class="form-label" >Cuotas a cancelar</label>
                                    <input type="number" id="cant" name="cant" class="form-control" placeholder="" v-bind:class="{ 'border-danger' : this.errors.has('cant')}" v-validate="'required'">
                                    <small id="emailHelp" class="form-text text-muted"></small>
                                    <span class="text-danger" v-show="this.errors.has('cant')">{{ this.errors.first('cant') }}</span>
                                </div>
                                <div class="mb-3 col-3">
                                    <label for="movimiento" class="form-label">Tipo de movimiento</label>
                                    <select id="movimiento" name="movimiento" class="form-select" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('movimiento')}">
                                        <option selected value="">Selecciona el tipo de movimiento</option>
                                        <option value="CANCELA">Cancelación</option>
                                        <option value="TRANSFE">Transferencia</option>
                                        <option value="CONVENIO">Convenio</option>
                                    </select>
                                    <span class="text-danger" v-show="this.errors.has('movimiento')">{{ this.errors.first('movimiento') }}</span>
                                </div>
                                <div class="mb-3 col-4">
                                    <label for="autoriza" class="form-label">Autoriza</label>
                                    <select id="autoriza" name="autoriza" class="form-select" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('autoriza')}">
                                        <option selected value="">Selecciona quien autoriza la cancelación</option>
                                        <option value="RCB">Ruben Carrillo Buenfil</option>
                                        <option value="SAM">Salomon Alfonso Muñoz</option>
                                        <option value="RZA">Rosy Zapata</option>
                                        <option value="NCG">Neidi Contreras</option>
                                        <option value="LER">Leticia Esteban Reyes</option>
                                        <option value="MDV">Michel Alexis Díaz Valdez</option>
                                    </select>
                                    <span class="text-danger" v-show="this.errors.has('autoriza')">{{ this.errors.first('autoriza') }}</span>

                                </div>
                                <div class=" col-2 d-flex align-items-center justify-content-start">
                                    <button type="submit" class="btn btn-primary mt-2">Cancelar cuotas</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- end card body -->
                </div>
                <!-- end card -->

                <div class="row">
                    <div class="col-6">

                    </div>
                </div>


                <!-- end card -->
            </div>
        </div>
        <!-- end tab content -->


    </div>
    <!-- end col -->

    <div class="col-xl-3 col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Cuotas</h5>
                <div class="table-rep-plugin">
                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                        <table id="tconvenios" class="table table-striped display" style="width:100%" data-page-length='100'>
                            <thead>
                                <tr>
                                    <th data-priority="2">Descripción</th>
                                    <th data-priority="2">Monto</th>
                                </tr>
                            </thead>
                            <tbody id="t-contet">
                                @foreach (radiotaxi.Model.Inventario due in ViewBag.dues)
                                {
                                    <tr>
                                        <td data-priority="2">@(due.Descripcion)</td>
                                        <td data-priority="2">@(due.PrecioConIva.ToString("C", new System.Globalization.CultureInfo("es-MX")))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th data-priority="2">Descripción</th>
                                    <th data-priority="2">Monto</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->
</div>

@section Scripts {
    <!-- form wizard init -->
    <script src="~/Content/js/Views/Partner/cancelarCuotas.js"></script>
}