    };

    /*
    var ctx = document.getElementById('myChart').getContext('2d');
    var myChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: Object.keys(data.days_report.dictionary_assigend),
            datasets: [{
                label: 'Servicios asignados por unidad ',
