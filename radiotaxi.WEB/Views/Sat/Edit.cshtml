@model radiotaxi.Model.Partner
@{
    ViewBag.Title = "Editar operador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DATOS DE CONTROL JS -->
<input id="gafet" name="gafet" type="hidden" value="@Model.partnerReference" />
<input id="userId" name="userId" type="hidden" value="@Model.userId" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18 "><i class="bx bx-user"></i> @Model.partnerReference</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- end page title -->
<div class="row">
    <div class="col-xl-9 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-start mt-3 mt-sm-0">
                            <div class="flex-lg-shrink-0">
                                <div class="avatar-xl me-3">

                                    @if (Model.urlImage != null)
                                    {
                                        <img src="@(Model.urlImage)" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                    else
                                    {
                                        <img src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div>
                                    <h4 class="font-size-18 mb-1 fw-bolder">@(Model.partnerReference != null ? Model.partnerReference : "")</h4>
                                    <h6 class="font-size-14 mb-1">@(Model.firstName != null ? Model.firstName.ToUpper() : "") @(Model.lastNameF != null ? Model.lastNameF.ToUpper() : "") @(Model.lastNameM != null ? Model.lastNameM.ToUpper() : "")</h6>
                                    <p class="text-muted font-size-13 mb-0"> <span class="fw-bold">Fecha de ingreso:</span> @(Model.fechaingreso != null ? Model.fechaingreso.Value.ToString("dd/MM/yyyy") : "")</p>
                                    @if (Permissions.deny("Clinica"))
                                    {
                                        <p class="text-muted font-size-13 "><span class="fw-bold">Número telefónico:</span> @(Model.Telefono != null ? Model.Telefono : "")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div> <!-- FIN PERFIL-->
                </div>
                <ul class="nav nav-tabs-custom card-header-tabs border-top mt-4 d-flex" id="pills-tab" role="tablist">
                    @if (Permissions.deny("Practi-AutoS,Practi-Actas,Practi-Cajas, Practi-AdminTurkey, Clinica, Practi-Finanzas"))
                    {
                        <li class="nav-item ms-auto my-2">
                            <a href="" class="btn btn-success btn-label">
                                <i class="bx bx-download label-icon"></i> Descargar Archivo
                            </a>
                        </li>
                    }
                </ul>

            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="tab-content">
            <div class="tab-pane active" id="general" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"> <i class="fas fa-file-invoice"></i> Fiscal / SAT</h5>
                    </div>
                    <div class="card-body">
                        <form id="" class="formjs" v-on:submit="onSubmit" method="POST" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="rfc">RFC</label>
                                        <input v-validate="'required|alpha_num|min:12|max:13'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('urfc')}" id="urfc" name="urfc" placeholder="Ingrese el RFC" value="@(Model.urfc != null ? Model.urfc : "")">
                                        <small id="emailHelp" class="form-text text-muted"></small>
                                        <span class="text-danger" v-show="this.errors.has('urfc')">{{ this.errors.first('urfc') }}</span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="passSat">Contraseña SAT</label>
                                        <input v-validate="'required'" type="text" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('passSat')}" id="passSat" name="passSat" placeholder="Ingrese su contraseña del SAT" value="">
                                        <small id="emailHelp" class="form-text text-muted"></small>
                                        <span class="text-danger" v-show="this.errors.has('passSat')">{{ this.errors.first('passSat') }}</span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="arch">Archivos</label>
                                        <input v-validate="'required|ext:rar,zip,7zip'" type="file" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('arch')}" id="arch" name="arch" placeholder="Ingrese el CURP" value="">
                                        <small id="emailHelp" class="form-text text-muted"></small>
                                        <span class="text-danger" v-show="this.errors.has('arch')">{{ this.errors.first('arch') }}</span>
                                    </div>
                                </div>
                                <ul class="list-unstyled">
                                    
                                    <li class="float-end">
                                        <input value="Guardar" type="submit" id="SendForm" href="" class="btn btn-success" />
                                    </li>
                                </ul>
                            </div>
                        </form>
                    </div>
                    <!-- end card body -->
                </div>
                <!-- end card -->
            </div>
            <!-- end tab pane -->
        </div>
        <!-- end tab content -->
    </div>
    <!-- end col -->

    <div class="col-xl-3 col-lg-4">

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bx bx-folder"></i>  Documentación importante</h5>

                <div class="flex-wrap gap-2 font-size-14">
                    <ul class="list-unstyled mb-0">
                        <li>
                            @if (Model.urfc != null)
                            {
                                <p class="my-0"><span class="fw-bold">RFC:</span> @Model.urfc</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">RFC:</span> NO REGISTRADO</p>
                            }
                        </li>
                        <li>
                            @if (Model.ine != null)
                            {
                                <p class="my-0"><span class="fw-bold">INE:</span> @Model.ine</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">INE:</span> NO REGISTRADO</p>
                            }
                        </li>
                        <li>
                            @if (Model.curp != null)
                            {
                                <p class="my-0"><span class="fw-bold">CURP:</span> @Model.curp</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">CURP:</span> NO REGISTRADO</p>
                            }
                        </li>
                    </ul>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->
</div>

@section Scripts {
    <!-- form wizard init
    <script src="~/Content/js/pages/form-wizard.init.js"></script>
         -->
    <script src="~/Content/js/Views/Sat/edit.js"></script>
}