@model radiotaxi.Model.card
@{
    ViewBag.Title = "Tarjeton";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@if (ViewBag.message != null)
{
    if (ViewBag.messageType == 200)
    {
        <div class="row">
            <div class="col-md-12">
                <span>@ViewBag.message</span>
            </div>
        </div>
    }
    else if (ViewBag.messageType == 500)
    {
        <div class="row">
            <div class="col-md-12">
                <span>ERROR : @ViewBag.message</span>
            </div>
        </div>
    }
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Tarjeton del operador @(Model.partnerReference != null ? Model.partnerReference  : "") en el taxi No. @(Model.taxi != null ? Model.taxi : "")</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="row">
    <div class="col-xl-9 col-lg-8" style="height:650px;">
        <iframe id="iframe1"
                title="Preview del tarjetón"
                frameborder="0"
                style="display:block;width:100%;height:100%"
                src="/card/generatepdf/@Model.id">
        </iframe>
        <!-- end card -->
    </div>
    <div class="col-xl-3 col-lg-4">
        <div class="card">
            <div class="card-body">
                <h1 class="card-title mb-3 text-lg-center fw-bold display-2">Información del tarjetón</h1>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <span class="fw-bold">Turno:</span>
                        @(Model.turn == 1 ? "Matutino" : " ")
                        @(Model.turn == 2 ? "Vespertino" : " ")
                        @(Model.turn == 3 ? "Ambos" : " ")
                    </li>
                    <li class="list-group-item"><span class="fw-bold">Nota:</span> @(Model.note != null ? Model.note : "")</li>
                    <li class="list-group-item"><span class="fw-bold">Activo:</span> @(Model.isActive == true ? "Si" : "No")</li>
                    <li class="list-group-item"><span class="fw-bold">Entregado:</span> @(Model.deliver == true ? "Si" : "No")</li>
                    <li class="list-group-item"><span class="fw-bold">Fecha de entrega:</span> @Model.deliverDate</li> <!--No deja validar por el tipo date @*@(Model.deliverDate != null ? Model.deliverDate : ""*@)-->
                    <li class="list-group-item"><span class="fw-bold">Baja:</span> @(Model.low == true ? "Si" : "No")</li>
                    <li class="list-group-item"><span class="fw-bold">Fecha de vencimiento:</span> @(Model.expiration_date != null ? Model.expiration_date.Value.ToString("dd/MM/yyy") : "")</li> <!--No deja validar por el tipo date @*@(Model.expiration_date != null ? Model.expiration_date : ""*@)-->
                </ul>
                <div class="mt-4 form-actions d-flex justify-content-around">
                    <a href="~/card/edit/@Model.id" class="btn btn-success waves-effect btn-label waves-light"><i class="bx bx-edit-alt label-icon"></i> Editar</a>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
</div>
@section Scripts
{
    
}