@model radiotaxi.Model.CardPagination
@{
    ViewBag.Title = "Card Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Tarjetones</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Tarjetones</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title  bx bx-search-alt-2"> Búsqueda</h4>
                <p class="card-title-desc">La búsqueda se puede realizar con cualquiera de los siguientes campos.</p>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="/card/" method="POST" class="form-horizontal">
                                <div class="row control-group">
                                    <div class="col">
                                        <label class="form-label control-label">Taxi</label>
                                        <input type="text" class="form-control span11 text-uppercase" name="taxi" placeholder="Ingrese el número del taxi"  value="@(ViewBag.parameters.taxi != null ? ViewBag.parameters.taxi : "")" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Gafet</label>
                                        <input type="text" class="form-control span11 text-uppercase" placeholder="Ingrese el número de gafet del operador" name="gafet" id="gafet" value="@(ViewBag.parameters.gafet != null ? ViewBag.parameters.gafet : "")"  />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Nombre</label>
                                        <input type="text" class="form-control span11 text-uppercase" placeholder="Ingrese el nombre" name="name" id="name" value="@(ViewBag.parameters.name != null ? ViewBag.parameters.name : "")" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Apellido paterno</label>
                                        <input type="text" class="form-control span11 text-uppercase" placeholder="Ingrese el apellido paterno" name="lastName1" id="lastName1" value="@(ViewBag.parameters.lastName1 != null ? ViewBag.parameters.lastName1 : "")"  />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Apellido materno</label>
                                        <input type="text" class="form-control span11 text-uppercase" placeholder="Ingrese el apellido materno" name="lastName2" id="lastName2" value="@(ViewBag.parameters.lastName2 != null ? ViewBag.parameters.lastName2 : "")"  />
                                    </div>
                                </div>
                                <div class="mt-4 form-actions">
                                    <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class="bx bx-search label-icon "></i>Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <h5 class="card-title">Tarjetones totales <span class="text-muted fw-normal ms-2"></span></h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3">
                            <div>
                                <a href="/card/Create" class="btn btn-light"><i class="bx bx-plus me-1"></i> Agregar Tarjeton</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class=" table-rep-plugin">
                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                        <table id="tech-companies-1" class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Tarjetón</th>
                                    <th data-priority="1">Taxi</th>
                                    <th data-priority="1">Opeador</th>
                                    <th data-priority="3">Fecha de alta</th>
                                    <th data-priority="1">Fecha de baja</th>
                                    <th data-priority="3">Horario</th>
                                    <th data-priority="3">Estado</th>
                                    <th data-priority="3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Data)
                                {
                                    <tr>
                                        <th>Tarjeton <span class="co-name">1</span></th>
                                        <td>@(item.taxi != null ? item.taxi : "")</td>
                                        <td>@(item.partnerReference != null ? item.partnerReference : "")</td>
                                        <td>@(item.asignedDate != null ? item.asignedDate.Value.ToString("dd/MM/yyyy"): "" )</td> <!-- @*@(item.asignedDate != null ? item.asignedDate : "") *@-->
                                        <td>@(item.expiration_date != null ? item.expiration_date.Value.ToString("dd/MM/yyyy") : "" )</td><!-- @*@(item.expiration_date != null ? item.expiration_date : "") *@-->
                                        <td>
                                            @(item.turn == 1 ? "Matutino" : " ")
                                            @(item.turn == 2 ? "Vespertino" : " ")
                                            @(item.turn == 3 ? "Ambos" : " ")
                                        </td>
                                        <td>@(item.isActive == true ? "Activado" : "Dado de baja")</td>
                                        <td>
                                            <a href="~/card/edit/@(item.id)" class="btn btn-success waves-effect btn-label waves-light">
                                                <i class="bx bx-edit-alt label-icon"></i> Editar
                                            </a>
                                            <a href="~/card/details/@(item.id)" class="btn btn-success waves-effect btn-label waves-light">
                                                <i class="bx bx-detail label-icon"></i> Detalles
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @*<div class="row justify-content-center">
                            <div class="col-md-12">
                                <nav aria-label="Page navigation example">
                                    @if (Model.EndPage > 1)
                                    {
                                        <ul class="pagination justify-content-center">

                                            @if (Model.CurrentPage > 1)
                                            {
                                                <li class="page-item">
