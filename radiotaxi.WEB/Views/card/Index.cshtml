                                                </li>
                                            }

                                            @if (Model.CurrentPage < Model.TotalPages)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Operator?page=@(Model.CurrentPage + 1)">Siguiente</a>
                                                </li>
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Operator?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == Model.TotalPages)
                                            {
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Operator?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </nav>
                            </div>
                        </div>*@
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end table responsive -->