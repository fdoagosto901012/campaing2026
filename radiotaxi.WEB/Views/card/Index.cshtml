                                                </li>
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Operator?page=@(Model.CurrentPage - 1)">Anterior</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == 1)
                                            {
                                                <li class="page-item ">
                                                    <a class="page-link" href="~/Operator">Primero</a>
                                                </li>
                                            }

                                            <!--Paginación activa-->
                                            @for (var p = Model.StartPage; p <= Model.EndPage; p++)
                                            {
                                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
