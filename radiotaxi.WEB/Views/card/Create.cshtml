
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Tarjetones</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Tarjetones</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-xl-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <h5 class="card-title mb-0">Nuevo tarjetón</h5>
                    <div class="card-body">
                        <div class="p-0">
                            <div class="row justify-content-center">
                                <div class="col">
                                    <div class="mt-1">
                                        <form class="row my-3 ">
                                            <div class="col-md-3">
                                                <div class="col">
                                                    <label for="gafet">Operador</label>
                                                    <input v-validate="'required'" v-model="gafet" name="gafet" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('gafet')}" id="gafet" />
                                                    <small id="emailHelp" class="form-text text-muted"></small>
                                                    <span class="text-danger" v-show="this.errors.has('gafet')">{{ this.errors.first('gafet') }}</span>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="col">
                                                    <label for="taxi">Eco taxi</label>
                                                    <input v-validate="'required'" v-model="taxi" name="taxi" type="text" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('taxi')}" id="taxi" />
                                                    <small id="emailHelp" class="form-text text-muted"></small>
                                                    <span class="text-danger" v-show="this.errors.has('taxi')">{{ this.errors.first('taxi') }}</span>
                                                </div>
                                            </div>
                                            <div class="col-md-1 d-flex">
                                                <div class="col align-content-end">
                                                    <btn v-on:click="searchCar" name="buscar" class="btn btn-success btn-label">
                                                        <i class=" bx bx-search-alt-2 label-icon"></i> Buscar
                                                    </btn>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="col">
                                                    <label for="turno">Turno</label>
                                                    <select v-model="selected" class="form-select form-select" aria-label=".form-select" id="turno">
                                                        <option selected disabled value="">Selecciona el turno del operador</option>
                                                        <option value="1">Matutino</option>
                                                        <option value="2">Vespertino</option>
                                                        <option selected value="3">Ambos</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div v-if="data != null" class="col-md-2 d-flex">
                                                <div class="col align-content-end">
                                                    <btn v-on:click="saveCard" name="guardar" class="btn btn-success waves-effect btn-label waves-light">
                                                        <i class=" bx bx-id-card label-icon"></i> Generar tarjetón
                                                    </btn>
                                                </div>
                                            </div>
                                        </form>
                                        <div class="mt-3">
                                            <div class="card" v-if="data != null">
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-sm">
                                                            <h5 class="card-title mb-3 row">Información del operador</h5>
                                                            <div class="d-flex align-items-start mt-3 mt-sm-0">
                                                                <div class="flex-lg-shrink-0">
                                                                    <div class="avatar-xl me-3">
                                                                        <img v-if="data.Operator.urlImage != null || data.Operator.urlImage != ''" :src="data.Operator.urlImage" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                                                        <img v-else src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                                                    </div>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <div>
                                                                        <h4 class="font-size-18 mb-1 fw-bolder">@*@Model.CHOFER*@ {{data.Operator.NOMBRE}} {{data.Operator.APELLIDOS}}</h4>
                                                                        <h6 class="font-size-14 mb-1">@*@Model.NOMBRE @Model.APELLIDOS*@</h6>
                                                                        <p class="text-muted font-size-13 mb-0"> <span class="fw-bold">Fecha de ingreso:</span> @*@Model.FECHAING*@ {{data.Operator.FECHAING}}</p>
                                                                        <p class="text-muted font-size-13 "><span class="fw-bold">Número telefónico:</span> @*@Model.TELEFONO*@{{data.Operator.TELEFONO}}</p>


                                                                        <div class="d-flex flex-wrap align-items-start gap-2 gap-lg-3 text-muted font-size-13">
                                                                            <div><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>Development</div>
                                                                            <div><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>phyllisgatlin@minia.com</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                        </div> <!-- FIN PERFIL-->

                                                        <div class="col-sm">
                                                            <h5 class="card-title mb-3 row">Información del taxi</h5>
                                                            <div class="flex-grow-1">
                                                                <div>
                                                                    <h4 class="font-size-18 mb-1 fw-bolder">@*@Model.CHOFER*@Económico:  {{data.Car.No_Economico}}</h4>
                                                                    <ul class="list-unstyled mb-0">
                                                                        <li>
                                                                            <p class="my-0"><span class="fw-bold">Status:</span> {{data.Car.Operacion}}</p>
                                                                        </li>
                                                                        <li>
                                                                            <p href="#" class="my-0"><span class="fw-bold">Marca:</span>{{data.Car.Marca}}</p>
                                                                        </li>
                                                                        <li>
                                                                            <p class="my-0"><span class="fw-bold">Modelo:</span> {{data.Car.Modelo}}</p>
                                                                        </li>
                                                                        <li>
                                                                            <p class="my-0"><span class="fw-bold">Año:</span> {{data.Car.AutoAno}}</p>
                                                                        </li>
                                                                        <li>
                                                                            <p class="my-0"><span class="fw-bold">Placas:</span> {{data.Car.Placas}}</p>
                                                                        </li>
                                                                        <li>
                                                                            <p class="my-0"><span class="fw-bold">Serie:</span> {{data.Car.No_Serie}}</p>
                                                                        </li>
                                                                    </ul>
                                                                    <div class="d-flex flex-wrap align-items-start gap-2 gap-lg-3 text-muted font-size-13">
                                                                        <ul class="list-unstyled mb-0">
                                                                            <li>
                                                                                <p class="my-0"><span class="fw-bold">Poliza:</span>{{data.Car.poliza}}</p>
                                                                            </li>
                                                                            <li>
                                                                                <p class="my-0"><span class="fw-bold">Vencimiendo de la poliza:</span> {{data.Car.vencepoliza}}</p>
                                                                            </li>
                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div> <!-- FIN PERFIL-->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- end post -->
                                </div>
                                <!-- end row -->
                            </div>
                        </div>
                        <!-- end card body -->
                    </div>
                    <!-- end card -->

                    <div class="col-xl-12 col-lg-12" style="height:650px;">
                        <iframe id="iframe1"
                                title="Preview del tarjetón"
                                frameborder="0"
                                style="display:block;width:100%;height:100%"
                                src="">
                        </iframe>
                        <!-- end card -->
                    </div>
                </div>
                <!-- end card body -->
            </div>
            <!-- end card -->
        </div>
        <!-- end col -->
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/Views/Cards/Create.js"></script>
}
