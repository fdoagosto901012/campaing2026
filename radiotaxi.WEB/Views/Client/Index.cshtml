                                        <th data-priority="1">Teléfono</th>
                                        @*<th>¿Es de casa?</th>*@
                                        <th data-priority="3">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Data)
                                    {
                                        <tr>

                                            @*<th scope="row">
            <div class="form-check font-size-16">
                <input type="checkbox" class="form-check-input" id="contacusercheck1">
                <label class="form-check-label" for="contacusercheck1"></label>
            </div>
        </th>*@
                                            <th class="co-name">
                                                <img src="~/Content/images/users/avatar-2.jpg" alt="" class="avatar-sm rounded-circle me-2">
                                                <span class="co-name">@Html.DisplayFor(modelItem => item.name) @Html.DisplayFor(modelItem => item.lastname1) @Html.DisplayFor(modelItem => item.lastname2)</span>
                                            </th>
                                            @*<td> @Html.DisplayFor(modelItem => item.address)</td>*@
                                            <td>
                                                <button type="button" class="btn btn-primary position-relative p-0 avatar-sm rounded-circle"
                                                        data-bs-toggle="popover"
                                                        data-bs-trigger="focus"
                                                        title="Dirección"
                                                        data-bs-content="@(item.address)">
                                                    <i class="mdi mdi-google-maps"></i>
                                                </button>
                                                @(" " + item.address.Substring(0, Math.Min(item.address.Length, 20)))...

                                            </td>
