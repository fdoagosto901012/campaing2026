                                            <td>
                                                <i class="bx bx-phone">
                                                    @Html.DisplayFor(modelItem => item.phone)
                                                </i>
                                            </td>
                                            @*
        <td>
            @if (item.isHome == true)
            {
                @Html.Raw("Si");
            }
            else
            {
                @Html.Raw("No");
            }
        </td>
                                            *@
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-link font-size-16 shadow-none py-0 text-muted dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bx bx-dots-horizontal-rounded"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" href="/TaxiService/Create/?phone=@(item.phone)&observation=@(item.blockedReason)&address=@(item.address)"><i class="bx bx-plus"></i> Agregar Servicio</a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="/TaxiService/Create/?phone=@(item.phone)&observation=@(item.blockedReason)&address=@(item.address)"><i class="bx bx-stopwatch"></i> Servicios pendientes</a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="/TaxiService/Create/?phone=@(item.phone)&observation=@(item.blockedReason)&address=@(item.address)"><i class="bx bx-check"></i> Servicios Asignados</a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="/Client/Edit/@(item.phone)"><i class=" bx bx-edit"></i> Editar</a>
                                                        </li>
                                                        <li>
