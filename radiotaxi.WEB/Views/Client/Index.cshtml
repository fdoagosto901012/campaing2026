                                </tbody>
                            </table>
                        </div>

                        <div class="row justify-content-center">
                            <div class="col-md-12">
                                <nav aria-label="Page navigation example">
                                    @if (Model.EndPage > 1)
                                    {
                                        <ul class="pagination justify-content-center">

                                            @if (Model.CurrentPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Client">Primero</a>
                                                </li>
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Client?page=@(Model.CurrentPage - 1)">Anterior</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == 1)
                                            {
                                                <li class="page-item ">
                                                    <a class="page-link" href="~/Client">Primero</a>
                                                </li>
                                            }

                                            <!--Paginación activa-->
                                            @for (var p = Model.StartPage; p <= Model.EndPage; p++)
                                            {
                                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                                    <a class="page-link" href="~/Client?page=@p">@p</a>
                                                </li>
                                            }

                                            @if (Model.CurrentPage < Model.TotalPages)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Client?page=@(Model.CurrentPage + 1)">Siguiente</a>
                                                </li>
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Client?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == Model.TotalPages)
                                            {
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Client?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </nav>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end table responsive -->
    