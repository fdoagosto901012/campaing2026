@model radiotaxi.Model.ClientPagination
@{
    ViewBag.Title = "Clientes Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Clientes</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                        <li class="breadcrumb-item active">Clientes</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- end page title -->

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title  bx bx-search-alt-2"> Búsqueda</h4>
                    <p class="card-title-desc">La búsqueda se puede realizar con cualquiera de los siguientes campos.</p>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-lg-12">
                            <div>
                                <form action="/Client/" method="POST" class="form-horizontal">
                                    <div class="row control-group">
                                        <div class="col-md-3 mb-3 ">
                                            <label class="form-label control-label">Número telefónico</label>
                                            <input type="text" class="form-control span11"name="phoneNumber" id="phoneNumber" value="@(ViewBag.parameters.phoneNumber)" placeholder="Ingrese el número telefónico"/>
                                        </div>
                                        <div class="col-md-3 mb-3 ">
                                            <label class="form-label control-label">Nombre</label>
                                            <input type="text" class="form-control span11" placeholder="Ingrese el apellido nombre" name="name" id="name" value="@(ViewBag.parameters.name)"/>
                                        </div>
                                        <div class="col-md-3 mb-3 ">
                                            <label class="form-label control-label">Apellido paterno</label>
                                            <input type="text" class="form-control span11" placeholder="Ingrese el apellido paterno" name="lastName1" id="lastName1" value="@(ViewBag.parameters.lastName1)"/>
                                        </div>
                                        <div class="col-md-3 mb-3 ">
                                            <label class="form-label control-label">Apellido materno</label>
                                            <input type="text" class="form-control span11" placeholder="Ingrese el apellido materno" name="lastName2" id="lastName2" value="@(ViewBag.parameters.lastName2)"/>
                                        </div>
                                    </div>
                                    <div class="mt-4 form-actions">
                                        <button type="submit" value="Buscar" class="btn btn-primary w-md btn-success">Buscar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <h5 class="card-title">Clientes totales <span class="text-muted fw-normal ms-2">@(ViewBag.totalClients)</span></h5>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3">
                                <div>
                                    <a href="/Client/Create" class="btn btn-light"><i class="bx bx-plus me-1"></i> Agregar cliente</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class=" table-rep-plugin">
                        <div class="table-responsive mb-0" data-pattern="priority-columns">
