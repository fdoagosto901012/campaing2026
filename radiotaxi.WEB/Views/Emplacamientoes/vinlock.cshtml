@model radiotaxi.Model.Emplacamiento
@{
    ViewBag.Title = "VIN BLOQUEADO";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column justify-content-center align-items-center text-center"
         style="min-height: calc(100vh - 180px); padding: 1rem; background-color: #ffffff;">
        <h4 class="text-uppercase display-6">¡VIN bloqueado!</h4>
        <i class="mdi mdi-block-helper text-danger" style="font-size: 150px;"></i>
        <h4 class="text-uppercase display-7">¡Información del bloqueo!</h4>
        <ul class="list-unstyled mb-0 fs-5">
            <li>
                <p class="mb-1"><span class="fw-bold">VIN:</span> @Model.No_Serie</p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Motor: </span> @Model.Motor</p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Placas: </span> @Model.Placas</p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Vehiculo: </span> @Model.Marca @Model.Modelo @Model.AutoAno</p>
            </li>

            <li>
                <p class="mb-1">
                    <span class="fw-bold">Número económico:</span> @Model.No_Economico.ToString("0")
                </p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Nombre:</span> @Model.Nombre @Model.Nombre2 @Model.Paterno @Model.Materno</p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Responsable:</span> @Model.EconoResp @Model.Responsable</p>
            </li>
            <li>
                <p class="mb-1"><span class="fw-bold">Teléfono del responsable:</span> @Model.resp_celular / @Model.resp_telefono</p>
            </li>

        </ul>
        <div class="mt-5 text-center">
            <a class="btn btn-primary waves-effect waves-light" onclick="history.back();">Regresar</a>
        </div>
    </div>
</div>