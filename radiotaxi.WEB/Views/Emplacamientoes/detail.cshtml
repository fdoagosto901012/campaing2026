@model radiotaxi.Model.Partner
@{
    ViewBag.Title = "Emplacamiento " + Model.partnerReference;
}

<!-- DATOS DE CONTROL JS -->
<input id="gafet" name="gafet" type="hidden" value="@Model.partnerReference" />
<input id="userId" name="userId" type="hidden" value="@Model.userId" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18 "><i class="bx bx-user"></i> @Model.partnerReference | Emplacamiento</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- end page title -->
<div class="row">
    <div class="col-xl-9 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-start mt-3 mt-sm-0">
                            <div class="flex-lg-shrink-0">
                                <div class="avatar-xl me-3">

                                    @if (Model.urlImage != null && Permissions.deny("Practi-BasicView"))
                                    {
                                        <img src="@Model.urlImage"
                                             alt=""
                                             class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                    else
                                    {
                                        <img src="~/Content/images/users/empty.png"
                                             alt=""
                                             class="avatar-xl rounded-circle me-2 img-thumbnail">
                                    }
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div>
                                    <h4 class="font-size-18 mb-1 fw-bolder">@(Model.partnerReference != null ? Model.partnerReference : "")</h4>
                                    <h6 class="font-size-14 mb-1">@(Model.firstName != null ? Model.firstName.ToUpper() : "") @(Model.lastNameF != null ? Model.lastNameF.ToUpper() : "") @(Model.lastNameM != null ? Model.lastNameM.ToUpper() : "")</h6>
                                    <p class="text-muted font-size-13 mb-0"> <span class="fw-bold">Fecha de ingreso:</span> @(Model.fechaingreso != null ? Model.fechaingreso.Value.ToString("dd/MM/yyyy") : "")</p>
                                    @if (Permissions.allow("Admin"))
                                    {
                                        <p class="text-muted font-size-13 "><span class="fw-bold">Número telefónico:</span> @(Model.Telefono != null ? Model.Telefono : "")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs-custom card-header-tabs border-top mt-4" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link px-3 active" data-bs-toggle="tab" href="#general" role="tab">General</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" data-bs-toggle="tab" href="#finanzas" role="tab">Finanzas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 " data-bs-toggle="tab" href="#historico" role="tab">Historico</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 " data-bs-toggle="tab" href="#movimientos" role="tab">Movimientos</a>
                    </li>

                    @if (Permissions.allow("Admin,Practi-Emplacamiento"))
                    {
                        <li class="nav-item ms-auto my-auto ">

                            @if (ViewBag.emplaactual.Operacion != "EMPLACADO" && ViewBag.emplaactual.Protegido != true || Permissions.allow("Admin"))
                            {
                                <a href="/emplacamiento/crear/@Model.partnerReference" class="btn btn-success btn-label mb-3">
                                    <i class="bx bx-car label-icon"></i> Emplacar
                                </a>
                            }


                            @if (ViewBag.emplaactual.Operacion == "EMPLACADO" && ViewBag.emplaactual.Protegido != true || Permissions.allow("Admin,Practi-Emplacamiento"))
                            {
                                <a href="/emplacamiento/Editar/@(((int)ViewBag.emplaactual.Id_Op))" class="btn btn-success btn-label mb-3">
                                    <i class="bx bx-car label-icon"></i> Editar
                                </a>

                            }
                            <div class="btn-group mb-3">
                                <button type="button" class="btn btn-success waves-light waves-effect dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Más <i class="mdi mdi-dots-vertical ms-2"></i>
                                </button>
                                <div class="dropdown-menu">

                                    @if (Permissions.allow("Admin,Practi-Emplacamiento") && ViewBag.emplaactual.Operacion == "EMPLACADO")
                                    {
                                        <a href="/emplacamiento/baja/@(((int)ViewBag.emplaactual.Id_Op))" class="dropdown-item">Dar de baja</a>
                                    }

                                    @if (Permissions.allow("Admin,Practi-Emplacamiento") && ViewBag.emplaactual != null)
                                    {
                                        foreach (radiotaxi.Model.EmplaMovimiento item in ViewBag.movimientos)
                                        {
                                            <a href="/emplacamiento/movimiento/@(((int)ViewBag.emplaactual.Id_Op))/@(item.Id_Mov)" class="dropdown-item">@(item.Movimiento)</a>
                                        }
                                    }


                                    <div class="dropdown-divider"></div>

                                    @if (Permissions.allow("Admin,Practi-Emplacamiento") && ViewBag.emplaactual.Operacion == "EMPLACADO")
                                    {
                                        <a href="/emplacamiento/movimiento/@(((int)ViewBag.emplaactual.Id_Op))/61" class="dropdown-item">REIMPRESIÓN DE ALTA</a>
                                    }
                                    else if (Permissions.allow("Admin,Practi-Emplacamiento") && ViewBag.emplaactual.Operacion != "EMPLACADO")
                                    {
                                        <a href="/emplacamiento/movimiento/@(((int)ViewBag.bajaactual.Id_Op))/10" class="dropdown-item">REIMPRESIÓN DE BAJA</a>
                                    }
                                </div>
                            </div>

                        </li>
                    }


                </ul>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="tab-content">
            <div class="tab-pane active" id="general" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"> <i class="bx bx-info-circle"></i> Información general</h5>
                    </div>
                    <div class="card-body">
                        <div>
                            <div class="pb-3">
                                <div class="row">
                                    <div class="col-md-2">
                                        <div>
                                            <h5 class="font-size-15"><span>Fecha de nacimiento :</span></h5>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="text-muted">
                                            @if (Model.birthDate != null)
                                            {
                                                <p class="my-0"> @Model.birthDate.ToString("dd/MM/yyyy")</p>
                                            }
                                            else
                                            {
                                                <p class="my-0"> NO REGISTRADO</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-2">
                                        <div>
                                            <h5 class="font-size-15"><span>Lugar de nacimiento :</span></h5>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="text-muted">
                                            @if (Model.birthPlace != null)
                                            {
                                                <p class="my-0"> @Model.birthPlace.ToUpper()</p>
                                            }
                                            else
                                            {
                                                <p class="my-0"> NO REGISTRADO</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-2">
                                        <div>
                                            <h5 class="font-size-15"><span>Sexo :</span></h5>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="text-muted">

                                            <p class="my-0">@(Model.sex == 0 ? "No registrado" : Model.sex == 1 ? "Masculino" : "Femenino") </p>

                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-2">
                                        <div>
                                            <h5 class="font-size-15"><span>Ciudad actual :</span></h5>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="text-muted">
                                            @if (Model.userAddresses != null && Model.userAddresses.Count() > 0)
                                            {
                                                try
                                                {
                                                    <p class="my-0">@Model.userAddresses.FirstOrDefault().city.name</p>
                                                }
                                                catch (Exception)
                                                {
                                                    <span>Error al cargar la direccion</span>
                                                }

                                            }
                                            else
                                            {
                                                <p class="my-0"> NO REGISTRADO</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (Permissions.deny("Clinica, Practi-BasicView"))
                                {
                                    <div class="row">
                                        <div class="col-md-2">
                                            <div>
                                                <h5 class="font-size-15"><span>Domicilio actual :</span></h5>
                                            </div>
                                        </div>
                                        <div class="col-md-10">
                                            <div class="text-muted">
                                                @if (Model.userAddresses != null && Model.userAddresses.Count() > 0)
                                                {
                                                    try
                                                    {
                                                        <p>
                                                            @(Model.userAddresses.FirstOrDefault().address + ", " + Model.userAddresses.FirstOrDefault().address2 + ", " + Model.userAddresses.FirstOrDefault().colony + ", SM " + Model.userAddresses.FirstOrDefault().supermanzana + ", MZ " + Model.userAddresses.FirstOrDefault().manzana + ", LT " + Model.userAddresses.FirstOrDefault().lote + ", Calle " + Model.userAddresses.FirstOrDefault().street + ", CP " + Model.userAddresses.FirstOrDefault().postalCode)
                                                        </p>
                                                    }
                                                    catch (Exception)
                                                    {
                                                        <span>Error al cargar la direccion</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="my-0"> NO REGISTRADO</p>
                                                }
                                            </div>
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    </div>
                    <!-- end card body -->
                </div>
                <!-- end card -->
            </div>
            <!-- end tab pane -->

        </div>
        <!-- end tab content -->

        <div class="tab-content">
            <div class="tab-pane" id="finanzas" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"> <i class="bx bx-dollar"></i> Finanzas</h5>
                    </div>
                    <div class="card-body">
                        <!-- Nav tabs -->
                        <ul class="nav nav-pills nav-justified" role="tablist">
                            <li class="nav-item waves-effect waves-light">
                                <a class="nav-link active" data-bs-toggle="tab" href="#deudas" role="tab">
                                    <span class="d-block d-sm-none"><i class="fas fa-home"></i></span>
                                    <span class="d-none d-sm-block"><i class="fas fa-file-invoice-dollar"></i>  Deudas</span>
                                </a>
                            </li>
                            <li class="nav-item waves-effect waves-light">
                                <a class="nav-link" data-bs-toggle="tab" href="#pagos" role="tab">
                                    <span class="d-block d-sm-none"><i class="far fa-user"></i></span>
                                    <span class="d-none d-sm-block"><i class="bx bx-dollar"></i>  Pagos</span>
                                </a>
                            </li>

                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content p-3 text-muted">

                            <div class="tab-pane active" id="deudas" role="tabpanel">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-body">

                                                <table class="table">
                                                    <tr>
                                                        <td>CLAVE</td>
                                                        <td>Cargo</td>
                                                        <td>Debe</td>
                                                        <td>Precio unitario</td>
                                                        <td>Total</td>
                                                    </tr>

                                                    @foreach (radiotaxi.Model.caja_cargos_DTO cargo in ViewBag.debs)
                                                    {

                                                        <tr>
                                                            <td>@(cargo.CLAVE)</td>
                                                            <td>@(cargo.CARGO)</td>
                                                            <td>@(cargo.DEBE)</td>
                                                            <td>@(cargo.PRECIO.ToString("C", new System.Globalization.CultureInfo("es-MX")))</td>
                                                            <td class="mb-0 fw-bold">@((cargo.PRECIO * cargo.DEBE).ToString("C", new System.Globalization.CultureInfo("es-MX")))</td>
                                                        </tr>
                                                    }
                                                </table>
                                                <div class="row g-1 align-items-center">

                                                    <div class="col-8 col-md-8">

                                                    </div>
                                                    <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                                        <p class="mb-0 p-0 fw-bolder h5">Total:</p>
                                                    </div>
                                                    <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                                        <p class="mb-0 fw-bolder h5 p-0">@(ViewBag.amountdebs.ToString("C", new System.Globalization.CultureInfo("es-MX")))</p>
                                                    </div>
                                                </div>
                                                @*<span>Total debe : @(ViewBag.amountdebs)</span>*@

                                            </div>
                                        </div>
                                        <!-- end card -->
                                    </div> <!-- end col -->
                                </div>
                            </div>
                            <div class="tab-pane" id="pagos" role="tabpanel">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-body">

                                                <div class="table-rep-plugin">
                                                    <div class="table-responsive mb-0">
                                                        <table id="" class="table table-striped" style="width:100%" data-page-length='100'>
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Ticket</th>
                                                                    <th class="text-center">Fecha</th>
                                                                    <th class="text-center">Total</th>
                                                                    <th class="text-center">Acciones</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="">
                                                                @foreach (radiotaxi.Model.Venta _sale in ViewBag.sales)
                                                                {
                                                                    <tr>
                                                                        <td class="text-center">@(_sale.Id_Op)</td>
                                                                        <td class="text-center">@(_sale.FechaOp)</td>
                                                                        <td class="text-center mb-0 fw-bold">@(_sale.CostoTotal.ToString("C", new System.Globalization.CultureInfo("es-MX")))</td>
                                                                        <td class="text-center">
                                                                            <a href="/ticket/detalle/@(_sale.Id_Op)" class="btn btn-success waves-effect btn-label waves-light" target="_blank">
                                                                                <i class="bx bx-show label-icon"></i> Ver más
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <th class="text-center">Ticket</th>
                                                                    <th class="text-center">Fecha</th>
                                                                    <th class="text-center">Total</th>
                                                                    <th class="text-center">Acciones</th>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- end card -->
                                    </div> <!-- end col -->
                                </div>
                            </div>
                        </div>

                    </div><!-- end card-body -->
                </div>
                <!-- end card -->
            </div>
            <!-- end tab pane -->

        </div>
        <!-- HISTORICO TAB -->

        <div class="tab-content">
            <div class="tab-pane" id="historico" role="tabpanel">
                <!--
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"> <i class="bx bx-info-circle"></i> Historico</h5>
                </div>
                <div class="card-body">
                    <div>
                        <h3>Historico....</h3>
                        <table>
                            <tr>
                                <td>Nombre Soc</td>
                                <td>Operación</td>
                                <td>Marca</td>
                                <td>Modelo</td>
                                <td>Año</td>
                                <td></td>
                            </tr>
                            @foreach (radiotaxi.Model.Emplacamiento item in ViewBag.emplaHist)
                            {
                                <tr>
                                    <td>@(item.Nombre)</td>
                                    <td>@(item.Operacion)</td>
                                    <td>@(item.Marca)</td>
                                    <td>@(item.Modelo)</td>
                                    <td>@(item.AutoAno)</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
