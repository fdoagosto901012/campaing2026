            -->
                <!-- end card -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0"> <i class="bx bx-history"></i> Historico</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-rep-plugin">
                                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                                        <table id="thistorico" class="table table-striped display" style="width:100%" data-page-length='100'>
                                            <thead>
                                                <tr>
                                                    <th data-priority="2">Nombre Socio</th>
                                                    <th data-priority="2">Operación</th>
                                                    <th data-priority="2">Fecha de operación</th>
                                                    <th data-priority="2">Eco. Responsable</th>
                                                    <th data-priority="2">Responsable</th>
                                                    <th data-priority="2">Observaciones</th>
                                                    <th data-priority="1">Marca</th>
                                                    <th data-priority="2">Modelo</th>
                                                    <th data-priority="2">Año</th>
                                                    <th data-priority="2">Placas</th>
                                                    <th data-priority="2">N° de motor</th>
                                                    <th data-priority="2">N° de serie</th>
                                                    <th data-priority="2">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="">
                                                @foreach (radiotaxi.Model.Emplacamiento item in ViewBag.emplaHist)
                                                {
                                                    <tr class="@(item.Operacion == "EMPLACADO" ? "fw-bold" : "")">
                                                        <td>@(item.Nombre)</td>
                                                        <td>@(item.Operacion)</td>
                                                        <td>@(item.FechaOp.HasValue ? item.FechaOp.Value.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("es-ES")) : "")</td>
                                                        <td>@(item.EconoResp)</td>
                                                        <td>@(item.Responsable)</td>
                                                        <td>@(item.Observaciones.ToUpper())</td>
                                                        <td>@(item.Marca)</td>
                                                        <td>@(item.Modelo)</td>
                                                        <td>@(item.AutoAno)</td>
                                                        <td>@(item.Placas)</td>
                                                        <td>@(item.Motor)</td>
                                                        <td>@(item.No_Serie)</td>

                                                        @if (item.Operacion == "EMPLACADO")
                                                        {
                                                            <td>
                                                                <a href="/emplacamiento/Editar/@(item.Id_Op.ToString().Replace(".0000", ""))" class="btn btn-success waves-effect btn-label waves-light">
                                                                    <i class="bx bx-edit-alt label-icon"></i> Editar
                                                                </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <a href="/emplacamiento/renderpdf/@(item.Id_Op.ToString().Replace(".0000", ""))/@(item.Id_Mov)" class="btn btn-success waves-effect btn-label waves-light" target="_blank">
                                                                    <i class="bx bx-printer label-icon"></i> Reimprimir Baja
                                                                </a>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th data-priority="2">Nombre Socio</th>
                                                    <th data-priority="2">Operación</th>
                                                    <th data-priority="2">Fecha de operación</th>
                                                    <th data-priority="2">Eco. Responsable</th>
                                                    <th data-priority="2">Responsable</th>
                                                    <th data-priority="2">Observaciones</th>
                                                    <th data-priority="1">Marca</th>
                                                    <th data-priority="2">Modelo</th>
                                                    <th data-priority="2">Año</th>
                                                    <th data-priority="2">Placas</th>
                                                    <th data-priority="2">N° de motor</th>
                                                    <th data-priority="2">N° de serie</th>
                                                    <th data-priority="2">Acciones</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end card -->
                    </div> <!-- end col -->
                </div>
            </div>
            <!-- end tab pane -->
        </div>
        <!-- end tab content -->

        <!-- MOVIMIENTOS TAB -->

        <div class="tab-content">
            <div class="tab-pane" id="movimientos" role="tabpanel">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0"> <i class="bx bx-history"></i> Movimientos</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-rep-plugin">
                                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                                        <table id="thistorico" class="table table-striped display" style="width:100%" data-page-length='100'>
                                            <thead>
                                                <tr>
                                                    <th data-priority="2">Movimiento</th>
                                                    <th data-priority="2">Eco. Responsable</th>
                                                    <th data-priority="2">Responsable</th>
                                                    <th data-priority="2">Gestor</th>
                                                    <th data-priority="2">Fecha de movimiento</th>

                                                </tr>
                                            </thead>
                                            <tbody id="">
                                                @foreach (radiotaxi.Model.emplaBitacora item in ViewBag.bitacoras)
                                                {

                                                    <tr>
                                                        <td>@(item.action)</td>
                                                        <td>@(item.postbitacoa != null ? item.postbitacoa.EconoResp : "NO REGISTRADO" )</td>
                                                        <td>@(item.postbitacoa != null ? item.postbitacoa.Responsable : "NO REGISTRADO" )</td>
                                                        <td>@(item.postbitacoa != null ? item.postbitacoa.Observaciones : "NO REGISTRADO" )</td>

                                                        <td>@(item.movDate.Value.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("es-ES")))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th data-priority="2">Movimiento</th>
                                                    <th data-priority="2">Eco. Responsable</th>
                                                    <th data-priority="2">Responsable</th>
                                                    <th data-priority="2">Gestor</th>
                                                    <th data-priority="2">Fecha de movimiento</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end card -->
                    </div> <!-- end col -->
                </div>
            </div>
            <!-- end tab pane -->
        </div>
        <!-- end tab content -->
    </div>
    <!-- end col -->

    <div class="col-xl-3 col-lg-4">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-3 font-size-18"><i class="bx bx-car"></i> Emplacamiento</h3>
                <div class="flex-wrap gap-2 font-size-16">
                    @if (ViewBag.emplaactual != null)
                    {
                        if (((radiotaxi.Model.Emplacamiento)ViewBag.emplaactual).Operacion != "EMPLACADO")
                        {
                            <h5 class="card-title mb-3">
                                <i class="bx bxs-downvote text-danger"></i>
                                <span class="badge bg-danger-subtle text-danger">Vehículo : <strong>BAJA</strong> - @(((DateTime)ViewBag.emplaactual.FechaOp).ToShortDateString()) </span>
                            </h5>
                        }
                        else
                        {
                            <h5 class="card-title mb-3">
                                <i class="bx bxs-upvote text-success"></i>
                                <span class="badge bg-success-subtle text-success">
                                    Vehículo : <strong>ALTA</strong> - @(((DateTime)ViewBag.emplaactual.FechaOp).ToShortDateString())
                                </span>
                            </h5>

                        }
                        if (ViewBag.emplaactual.Bloqueado == true)
                        {
                            <div class="row">
                                <div class="col-xl-12">
                                    <div class="alert alert-danger" role="alert">
                                        <i class=" bx bx-block"></i> <i class=" bx bx-car"></i> El VIN del vehiculo esta Bloqueado, favor de comunicarse con sistemas.
                                    </div>
                                </div><!-- end col -->
                            </div>

                        }

                        if (ViewBag.emplaactual.Protegido == true)
                        {
                            <div class="row">
                                <div class="col-xl-12">
                                    <div class="alert alert-danger" role="alert">
                                        <i class=" bx bx-block"></i> <i class=" bx bx-car"></i> El número económico esta protegido, favor de comunicarse con sistemas.
                                    </div>
                                </div><!-- end col -->
                            </div>
                        }
                <ul class="list-unstyled mb-0">
                    <li>
                        <p class="mb-1"><span class="fw-bold">Marca:</span> @(ViewBag.emplaactual.Marca)</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Modelo:</span> @(ViewBag.emplaactual.Modelo)</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Año del vehiculo:</span> @(ViewBag.emplaactual.AutoAno)</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Responsable:</span> @(ViewBag.emplaactual.Responsable)</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Eco/Gafet del responsable:</span> @(ViewBag.emplaactual.EconoResp)</p>
                    </li>
                    @if (Permissions.deny("Practi-BasicView"))
                    {
                        <li>
                            <p class="mb-1"><span class="fw-bold">Teléfono del responsable:</span> @(ViewBag.emplaactual.resp_telefono)</p>
                        </li>
                        <li>
                            <p class="mb-1"><span class="fw-bold">Celular del Responsable:</span> @(ViewBag.emplaactual.resp_celular)</p>
                        </li>
                    }
                    <li>
                        <p class="mb-1"><span class="fw-bold">Placas:</span> @(ViewBag.emplaactual.Placas.ToUpper())</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Motor:</span> @(ViewBag.emplaactual.Motor.ToUpper())</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">N° de serie:</span> @(ViewBag.emplaactual.No_Serie.ToUpper())</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Capacidad:</span> @(ViewBag.emplaactual.Capacidad) PASAJEROS MÁS CONDUCTOR</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Poliza:</span> @(ViewBag.emplaactual.poliza != null ? ViewBag.emplaactual.poliza.ToUpper() : "")</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Tipo de poliza:</span> @(ViewBag.emplaactual.tipopoliza != null ? ViewBag.emplaactual.tipopoliza.ToUpper() : "")</p>
                    </li>
                    <li>
                        <p class="mb-1"><span class="fw-bold">Aseguradora:</span> @(ViewBag.emplaactual.aseguradora)</p>
                    </li>
                    <li>
                        <span class="fw-bold">Vencimiento de poliza:</span> @(ViewBag.emplaactual.vencepoliza != null ? Convert.ToDateTime(ViewBag.emplaactual.vencepoliza).ToString("dd/MM/yyyy"): "")
                    </li>
                </ul>
                        <hr />
                        <p class="mb-1"><span class="fw-bold">Observaciones:</span> @(ViewBag.emplaactual.Observaciones.ToUpper())</p>
                        <p>
                            <span class="fw-bold">Fecha de operación :</span>
                             @(((DateTime)ViewBag.emplaactual.FechaOp).ToShortDateString())
                        </p>
                    }

                </div>
            </div>
            <!-- end card body -->
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bx bx-folder"></i>  Documentación importante</h5>

                <div class="flex-wrap gap-2 font-size-14">
                    <ul class="list-unstyled mb-0">
                        <li>
                            @if (Model.ine != null)
                            {
                                <p class="my-0"><span class="fw-bold">INE:</span> @Model.ine.ToUpper()</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">INE:</span> NO REGISTRADO</p>
                            }
                        </li>
                        <li>
                            @if (Model.urfc != null)
                            {
                                <p class="my-0"><span class="fw-bold">RFC:</span> @Model.urfc.ToUpper()</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">RFC:</span> NO REGISTRADO</p>
                            }
                        </li>
                        <li>
                            @if (Model.curp != null)
                            {
                                <p class="my-0"><span class="fw-bold">CURP:</span> @Model.curp.ToUpper()</p>
                            }
                            else
                            {
                                <p class="my-0"><span class="fw-bold">CURP:</span> NO REGISTRADO</p>
                            }
                        </li>
                    </ul>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->
</div>

@section Scripts {
    <script src="~/Content/js/Views/Emplacamiento/details.js"></script>
}