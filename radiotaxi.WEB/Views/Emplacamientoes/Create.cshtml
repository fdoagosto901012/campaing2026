                                    <option value="0">N/A</option>
                                    @foreach (radiotaxi.Model.EmplaMarca marca in ViewBag.marcas)
                                    {
                                        <option value="@(marca.Id_Marca)">@(marca.Marca)</option>
                                    }
                                </select>
                                <small id="emailHelp" class="form-text text-muted"></small>
                                <span class="text-danger" v-show="this.errors.has('Id_Marca')">{{ this.errors.first('Id_Marca') }}</span>
                            </div>

                            <div class="col-md-5">
                                <label for="Id_Modelo" class="control-label col-md-2">Modelo</label>
                                <select id="Id_Modelo" name="Id_Modelo" class="form-control" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('Id_Modelo')}">
                                    <option value="0">N/A</option>
                                    @foreach (radiotaxi.Model.EmplaModelo modelo in ViewBag.modelos)
                                    {
                                        <option value="@(modelo.Id_Modelo)">@(modelo.Modelo)</option>
                                    }
                                </select>
                                <small id="emailHelp" class="form-text text-muted"></small>
                                <span class="text-danger" v-show="this.errors.has('Id_Modelo')">{{ this.errors.first('Id_Modelo') }}</span>
                            </div>

                            <div class="col-md-2">
