@{
    ViewBag.Title = "Económico protegido";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column justify-content-center align-items-center text-center"
         style="min-height: calc(100vh - 180px); padding: 1rem; background-color: #ffffff;">
        <i class="mdi mdi-shield-alert text-info" style="font-size: 280px;"></i>
        <h4 class="text-uppercase display-3">¡Número económico protegido!</h4>
        <h4 class="text-uppercase display-6">¡No se puede realizar ningun movimiento, modificación o edición!</h4>
        
        <div class="mt-5 text-center">
            <a class="btn btn-primary waves-effect waves-light" onclick="history.back();">Regresar</a>
        </div>
    </div>
</div>
