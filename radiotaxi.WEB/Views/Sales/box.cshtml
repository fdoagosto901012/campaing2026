            <p class="text-center">Para registrarse, envia un mensaje a los números: 9989371528 o 9988962606</p>
        </div>
    </div>
</div>

<div id="messagemodal" class="modal fade" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bloqueo</h5>
                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="messagecontent">

                </p>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

@section Scripts {
    <script src="~/Content/js/Views/Sales/box.js"></script>
    <script src="~/Content/js/pages/materialdesign.init.js"></script>
}