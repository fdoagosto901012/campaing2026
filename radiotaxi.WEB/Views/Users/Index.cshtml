@model radiotaxi.Model.UserLogPagination
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Usuarios</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Usuarios / Accesos</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title  bx bx-search-alt-2"> Búsqueda</h4>
                <p class="card-title-desc">La búsqueda se puede realizar con cualquiera de los siguientes campos.</p>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="/users/" method="POST" class="form-horizontal">
                                <div class="row control-group">
                                    <div class="col">
                                        <label class="form-label control-label">Gafet</label>
                                        <input type="text" class="form-control span11" placeholder="Ingrese el número de gafet del operador" name="gafet" id="gafet" value="@ViewBag.parameters.gafet" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Nombre</label>
                                        <input type="text" class="form-control span11" placeholder="Ingrese el nombre" name="name" id="name" value="@ViewBag.parameters.name" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label control-label">Apellidos</label>
                                        <input type="text" class="form-control span11" placeholder="Ingrese el apellido paterno" name="lastName1" id="lastName1" value="@ViewBag.parameters.lastName1" />
                                    </div>
                                </div>
                                <div class="mt-4 form-actions">
                                    <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class="bx bx-search label-icon "></i>Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <h5 class="card-title">Usuarios totales <span class="text-muted fw-normal ms-2"></span></h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3">
                            <div>
                                <a href="/users/Create" class="btn btn-light"><i class="bx bx-plus me-1"></i> Agregar Usuario</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class=" table-rep-plugin">
                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                        <table id="tech-companies-1" class="table table-striped">
                            <thead>
                                <tr>
                                    <th data-priority="1">Eco/Gafet</th>
                                    <th data-priority="1">Nombre</th>
                                    <th data-priority="3">Apellidos</th>
                                    <th data-priority="1">Fecha creación</th>
                                    <th data-priority="1">Ultimo login</th>
                                    <th data-priority="3">Role</th>
                                    <th data-priority="3">Estado</th>
                                    <th data-priority="3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Data)
                                {
                                    <tr>
                                        <td>@(item.partnerReference)</td>
                                        <td>@(item.firstName)</td>
                                        <td>@(item.lastName)</td>
                                        <td>@(item.createdDt)</td>
                                        <td>
                                            @(item.lastLoginDt)
                                        </td>
                                        <td>@(item.RoleName)</td>
                                        <td>
                                            <a href="~/users/edit/@(item.userId)" class="btn btn-success waves-effect btn-label waves-light">
                                                <i class="bx bx-edit-alt label-icon"></i> Editar
                                            </a>
                                            <a href="~/users/details/@(item.userId)" class="btn btn-success waves-effect btn-label waves-light">
                                                <i class="bx bx-detail label-icon"></i> Detalles
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row justify-content-center">
                            <div class="col-md-12">
                                <nav aria-label="Page navigation example">
                                    @if (Model.EndPage > 1)
                                    {
                                        <ul class="pagination justify-content-center">

                                            @if (Model.CurrentPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Users">Primero</a>
                                                </li>
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Users?page=@(Model.CurrentPage - 1)">Anterior</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == 1)
                                            {
                                                <li class="page-item ">
                                                    <a class="page-link" href="~/Users">Primero</a>
                                                </li>
                                            }

                                            <!--Paginación activa-->
                                            @for (var p = Model.StartPage; p <= Model.EndPage; p++)
                                            {
                                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                                    <a class="page-link" href="~/Users?page=@p">@p</a>
                                                </li>
                                            }

                                            @if (Model.CurrentPage < Model.TotalPages)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="~/Users?page=@(Model.CurrentPage + 1)">Siguiente</a>
                                                </li>
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Users?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                            else if (Model.CurrentPage == Model.TotalPages)
                                            {
                                                <li class="page-item next">
                                                    <a class="page-link" href="~/Users?page=@(Model.TotalPages)">Último</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </nav>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end table responsive -->