@model radiotaxi.Model.CutResults
@{
ViewBag.Title = "Reporte de familias";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Finanzas</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Reporte familias</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title  bx bx-search-alt-2"> Búsqueda</h4>
                <p class="card-title-desc">La búsqueda se puede realizar con cualquiera de los siguientes campos.</p>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="/finance/families/" method="POST" class="form-horizontal">
                                <div class="row control-group">
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Fecha inicial</label>
                                        <input type="date" class="form-control span11" name="start" id="start" value=""/>
                                    </div>
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Fecha final</label>
                                        <input type="date" class="form-control span11" name="end" id="end" value="" />
                                    </div>
                                    <div class="col-md-3 mb-3 ">
                                        <!--
                                        <label for="families">Familias</label>
                                        <select id="families" name="sex" class="form-select" multiple>
                                            <option value="1">Familia 1</option>
                                            <option value="2">Familia 2</option>
                                            <option value="3">Familia 3</option>
                                            <option value="4">Familia 4</option>
                                            <option value="5">Familia 5</option>
                                            <option value="6">Familia 6</option>
                                            <option value="7">Familia 7</option>
                                            <option value="8">Familia 8</option>
                                            <option value="9">Familia 9</option>
                                            <option value="10">Familia 10</option>
                                        </select>
                                        -->
                                    </div>
                                </div>
                                <div class="mt-4 form-actions">
                                    <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class="bx bx-search label-icon "></i>Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-rep-plugin">
                    <div class="table-responsive mb-0" data-pattern="priority-columns">
                        <table id="general" class="table table-striped display" style="width:100%" data-page-length='100'>
                            <thead>
                                <tr>
                                    <th data-priority="date1">SKU</th>
                                    <th data-priority="date1">Concepto</th>
                                    
                                    @foreach (var day in Model.days)
                                    {
                                        <th data-priority="date1">@(day.date_id.ToString("dd/MM/yyyy"))</th>
                                    }
                                    <th data-priority="final">Total</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var family in Model.Familias)
                                {
                                    <tr>
                                        <td>@(family.Id_Familia)</td>
                                        <td>@(family.Familia1)</td>
                                        @{
                                            decimal total = 0;
                                        }
                                        @foreach (var day in Model.days)
                                        {
                                            var a = Model.Cuts.Where(x => x.Id_Familia == family.Id_Familia && x.date_id == day.date_id).FirstOrDefault();

                                            if (a != null)
                                            {
                                                <td>
                                                    <a target="_blank" href="/finance/families/@(a.date_id.ToString("yyyyMMdd"))/@(a.Id_Familia)" data-date_id="@(a.date_id)" data-Id_Familia="@(a.Id_Familia)">
                                                        @(a != null ? String.Format(System.Globalization.CultureInfo.GetCultureInfo("es-MX"), "{0:0.00}", a.CORTE_CAJA) : "0.00")

                                                    </a>
                                                </td>
                                                total += (a.CORTE_CAJA != null ? (decimal)a.CORTE_CAJA : 0);
                                            }
                                            else { 
                                                <td>
                                                    00.0
                                                </td>
                                            }
                                        }
                                        <td>@(String.Format(System.Globalization.CultureInfo.GetCultureInfo("es-MX"), "{0:0.00}", total))</td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- end card -->
    </div> <!-- end col -->
</div>

@section Scripts {
    <!-- Required datatable js
    <script src="~/Content/libs/DataTablesPDF/jquery-3.7.1.js"></script>
    <script src="~/Content/js/Views/Finance/main.js"></script>
    <script src="~/Content/libs/DataTablesPDF/buttons.dataTables.js"></script>
    <script src="~/Content/libs/DataTablesPDF/buttons.html5.min.js"></script>
    <script src="~/Content/libs/DataTablesPDF/dataTables.buttons.js"></script>
    <script src="~/Content/libs/DataTablesPDF/dataTables.js"></script>
    <script src="~/Content/libs/DataTablesPDF/jszip.min.js"></script>
    <script src="~/Content/libs/DataTablesPDF/pdfmake.min.js"></script>
    <script src="~/Content/libs/DataTablesPDF/vfs_fonts.js"></script>
    -->

    <script src="~/Content/libs/DataTables/datatables.js"></script>
    <script src="~/Content/libs/DataTables/datatables.min.js"></script>
    <script src="~/Content/js/Views/Finance/families.js"></script>
    

}