@{
    ViewBag.Title = "Cashier Turkeys";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18"> <i class="mdi mdi-food-turkey"></i> Estadisticas de pavos.</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Estadisticas de pavos</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-8">
        <div class="container-fluid">
            <div class="row">

                @if (Permissions.allow("Admin, Practi-AdminTurkey"))
                {
                    <div class="col-xl-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Total de pavos entregados</h4>
                            </div>
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-sm">
                                        <div id="total" data-colors='["#ffbf53", "#4ba6ef", "#fd625e", "#4ba6ef", "#fd625e"]' class="apex-charts" dir="ltr"></div>
                                        <div class="resize-triggers"><div class="expand-trigger"><div style="width: 305px; height: 211px;"></div></div><div class="contract-trigger"></div></div>
                                    </div>
                                    <div class="col-sm align-self-center">
                                        <div class="mt-4 mt-sm-0">
                                            <div>
                                                <p class="mb-2">
                                                    <i class="mdi mdi-circle align-middle font-size-10 me-2 text-info"></i>
                                                    Pavos entregados
                                                </p>
                                                <h6>
                                                    TOTAL ENTREGADOS = <span id="totalamount" class="text-muted font-size-14 fw-normal"></span>
                                                </h6>
                                            </div>
                                            <div class="mt-4 pt-2">
                                                <p class="mb-2">
                                                    <i class="mdi mdi-circle align-middle font-size-10 me-2 text-success"></i>
                                                    Pavos por entregar
                                                </p>
                                                <h6>
                                                </h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Total de cupones expedidos</h4>
                            </div>
                            <div class="card-body">
                                <div id="cashier" data-colors='["#2ab57d", "#5156be", "#fd625e", "#4ba6ef", "#ffbf53"]' class="apex-charts" dir="ltr"></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Total de cupones expedidos</h4>
                            </div>
                            <div class="card-body">
                                <div id="cashier" data-colors='["#2ab57d", "#5156be", "#fd625e", "#4ba6ef", "#ffbf53"]' class="apex-charts" dir="ltr"></div>
                            </div>
                        </div>
                    </div>

                }

            </div>

            <div class="row">
                <div class="col-xl-6">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Entrega de pavos socios</h4>
                        </div>
                        <div class="card-body">
                            <div id="Linechart" data-colors='["#5156be", "#2ab57d"]' class="apex-charts" dir="ltr"></div>
                        </div>
                    </div><!--end card-->
                </div>

                <div class="col-xl-6">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Pavos pendientes/entregados socios</h4>
                        </div>
                        <div class="card-body">
                            <div id="ticketvsdeliver" data-colors='["#5156be", "#2ab57d"]' class="apex-charts" dir="ltr"></div>
                        </div>
                    </div><!--end card-->
                </div>




            </div>
            <!-- end row -->



            <div class="row">
                <div class="col-xl-6">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Pavos pendientes/entregados operadores</h4>
                        </div>
                        <div class="card-body">
                            <div id="ticketvsdeliverop" data-colors='["#2ab57d", "#5156be"]' class="apex-charts" dir="ltr"></div>
                        </div>
                    </div><!--end card-->
                </div>


                <div class="col-xl-6">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Entrega de pavos operadores</h4>
                        </div>
                        <div class="card-body">
                            <div id="Linechartop" data-colors='["#2ab57d", "#5156be"]' class="apex-charts" dir="ltr"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- end row -->

        </div> <!-- container-fluid -->
    </div>
</div>

@section scripts{
    <script src="~/Content/js/Views/Turkeys/TurkeysCharts.js"></script>
}