@model radiotaxi.Model.report

@{
    ViewBag.Title = "Detalles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div id="content-header">
    <div id="breadcrumb"> <a href="/" title="Go to Home" class="tip-bottom"><i class="icon-home"></i> Home</a> <a href="#" class="tip-bottom">Agregar Reporte</a>  </div>
    <h1>Detalles Reporte</h1>
</div>
<div class="container-fluid">
    <hr>
    <div class="row-fluid">
        <div class="span12">
            <div class="widget-box">
                <div class="widget-title">
                    <span class="icon"> <i class="icon-align-justify"></i> </span>
                    <h5>Información de reporte</h5>
                </div>
                <div class="widget-content nopadding">
                    <dl class="dl-horizontal">
                        <dt>
                            Nombre
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.name)
                        </dd>

                        <dt>
                            Teléfono
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.phone)
                        </dd>

                        <dt>
                            Dirección
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.address)
                        </dd>

                        <dt>
                            Descripción
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.description)
                        </dd>

                        <dt>
                            Fecha de creación
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.dateCreated)
                        </dd>


                        <dt>
                            Creado Por
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.createdBy)
                        </dd>

                        <dt>
                            Taxi(s) Involucrado(s)
                        </dt>

                        <dd>
                            @{
                                string numeros = "*";
                                if (Model.taxiReports.Count > 0)
                                {
                                    foreach (var rtItem in Model.taxiReports)
                                    {
                                        numeros = rtItem.taxiNumber + ", " + numeros;
                                    }
                                    numeros = numeros.Replace(", *", "");
                                    @Html.Raw(numeros);
                                }
                                else
                                {
                                    @Html.Raw("");
                                }
                            }
                        </dd>

                    </dl>
                    
                </div>
            </div>
        </div>
    </div>
    <div class="row-fluid">
        <div class="col-md-12">
            <p>
                @Html.ActionLink("Editar", "Edit", new { id = Model.id }) |
                @Html.ActionLink("Regresar", "Index")
            </p>
        </div>
    </div>
</div>
