@{
    ViewBag.Title = "Pay Coupons";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-8">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-sm-0 font-size-18"><i class="bx bxs-coupon"></i> Pago de cupones</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-horizontal">
                                    <div class="row">
                                        <div v-if="user != null" class="col-2">
                                            <div class="d-flex flex-column align-items-center mt-3 mt-sm-0">
                                                <div class="row">
                                                    <div class="flex-lg-shrink-0">
                                                        <div class="avatar-xl">
                                                            <img :src="user.urlImage" alt="" class="avatar-xl rounded-circle img-thumbnail">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row text-center">
                                                    <div class="flex-grow-1">
                                                        <div>
                                                            <h4 class="font-size-18 mb-1 mt-3 fw-bolder">
                                                                {{user.CHOFER}}
                                                            </h4>
                                                            <h6 class="font-size-14 mb-1 mt-2">
                                                                {{user.NOMBRE}} {{user.APELLIDOS}}
                                                            </h6>
                                                            <h6 class="font-size-14 mb-1 mt-2">
                                                                {{user.STATUS}}
                                                            </h6>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div v-else class="col-2">
                                            <div class="d-flex flex-column align-items-center mt-3 mt-sm-0">
                                                <div class="row">
                                                    <div class="flex-lg-shrink-0">
                                                        <div class="avatar-xl">
                                                            <img src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle img-thumbnail">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row text-center">
                                                    <div class="flex-grow-1">
                                                        <div>
                                                            <h4 class="font-size-18 mb-1 mt-3 fw-bolder">
                                                            </h4>
                                                            <h6 class="font-size-14 mb-1 mt-2">
                                                            </h6>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-10">
                                            <div class="row control-group">
                                                <div class="col-md-1 mb-2">
                                                    <input class="form-check-input" type="radio" name="type" id="OP" value="OP" checked>
                                                    <label class="form-check-label" for="check-op">
                                                        OP
                                                    </label>
                                                </div>
                                                <div class="col-md-1 mb-1">
                                                    <input class="form-check-input" type="radio" name="type" id="SOC" value="SOC">
                                                    <label class="form-check-label" for="check-eco">
                                                        SOC
                                                    </label>
                                                </div>
                                            </div>
                                            <!-- DIVISION FORM -->
                                            <div class="row control-group">

                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Eco/Gafet</label>
                                                    <input v-model="reference" type="text" class="form-control span11" name="reference" id="reference" value="" placeholder="Ingrese el número eco o gafet" />
                                                </div>
                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Nombre</label>
                                                    <input v-model="name" type="text" class="form-control span11" placeholder="NOMBRE DEL SOCIO U OP" name="name" id="name" value="" />
                                                </div>
                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Apellidos</label>
                                                    <input v-model="lastname" type="text" class="form-control span11" placeholder="NOMBRE DEL SOCIO U OP" name="lastname" id="lastname" value="" />
                                                </div>

                                                <div class="col-md-3 mb-3 text-end">
                                                    <button v-on:click="search" type="button" class="btn btn-success waves-effect btn-label waves-light"><i class="bx bx-check-double label-icon"></i> BUSCAR </button>
                                                    <input v-model="cajera" type="hidden" class="form-control span11" placeholder="NOMBRE O ID DE LA CAJERA" name="cajera" id="cajera" value="" />
                                                </div>

                                            </div>


                                            <!-- DIVISION FORM -->
                                            <div class="row control-group">
                                                <div class="col-md-2 mb-2 ">
                                                    <label class="form-label control-label">Sector</label>
                                                    <select class="form-control form-select span11" name="sector" id="sector">
                                                        @foreach (var item in ViewBag.sectores)
                                                        {
                                                            <option value="@(item)">@(item)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Número</label>
                                                    <input type="text" class="form-control span11" placeholder="" name="numero" id="numero" value="" />
                                                </div>
                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Perforación</label>
                                                    <select class="form-control span11 form-select" name="perforacion" id="perforacion">
                                                        @foreach (var item in ViewBag.perforaciones)
                                                        {
                                                            <option value="@(item)">@(item)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3 mb-3 ">
                                                    <label class="form-label control-label">Pago</label>
                                                    <input type="text" class="form-control span11" name="pago" id="pago" v-model="pago" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4 form-actions text-end">
                                        <button v-on:click="searchTicket" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class=" bx bxs-add-to-queue label-icon "></i>Buscar</button>
                                        <button value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class=" bx bxs-add-to-queue label-icon "></i>Agregar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <!-- CABECERAS -->

                        <div class="row g-1 align-items-center">

                            <div class="col-8 col-md-8">

                            </div>
                            <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                <p class="mb-0 p-0 fw-bolder h5">Total:</p>
                            </div>
                            <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                <p class="mb-0 fw-bolder h5 p-0">$ {{total}} MXN</p>
                            </div>
                        </div>

                        <div class="row justify-content-end m-3">
                            <div class="col-3 col-md-12 text-end text-md-end align-items-end text-end">
                                <div v-if="loading" role="status" class="spinner-border text-success" style="width: 30px;height: 30px;margin: 0px 14px -10px 1px;"><span class="sr-only">Loading...</span></div>
                                <button type="submit" class="btn btn-success waves-effect btn-label waves-light">
                                    <i class="bx bx-wallet label-icon"></i>
                                    Pagar
                                </button>
                            </div>
                        </div>

                        <hr class="divider">

                        <div class="row g-1 align-items-center">
                            <div class="col-12 col-md-3 d-flex text-center text-md-start justify-content-center">
                                <p class="fw-bold font-size-13">Eco/Gafet</p>
                            </div>
                            <div class="col-12 col-md-2 d-flex justify-content-center">
                                <p class="fw-bold font-size-13">Sector</p>
                            </div>
                            <!---->
                            <div class="col-12 col-md-3 d-flex justify-content-center">
                                <p class="fw-bold font-size-13">Número</p>
                            </div>
                            <!---->
                            <div class="col-12 col-md-1 d-flex justify-content-center">
                                <p class="fw-bold font-size-13">Perforacion</p>
                            </div>
                            <div class="col-12 col-md-1 d-flex justify-content-center">
                                <p class="fw-bold font-size-13">Pago</p>
                            </div>
                            <div class="col-12 col-md-1 d-flex justify-content-center">
                                <p class="fw-bold font-size-13">Cajera</p>
                            </div>
                        </div>
                        <hr class="divider">
                        <!-- FIN CABECERAS -->
                        <div class="row g-1 align-items-center">
                            <div class="col-12 col-md-3 text-aling-center text-md-center ">
                                <p>ECO/GAFET</p>
                            </div>
                            <div class="col-12 col-md-2 text-center text-md-center ">
                                <p>SECTOR</p>
                            </div>
                            <div class="col-12 col-md-3 text-center text-md-center ">
                                <p>NÚMERO</p>
                            </div>
                            <div class="col-12 col-md-1 text-center text-md-center ">
                                <p>PERFORACIÓN</p>
                            </div>
                            <div class="col-12 col-md-1 text-center text-md-center ">
                                <p>PAGO</p>
                            </div>
                            <div class="col-12 col-md-1 text-center text-md-center ">
                                <p>CAJERA</p>
                            </div>

                            <!---->
                        </div>

                        <div class="row" v-for="Cuppon in Cuppons">
                            <div class="col-md-12">
                                <hr class="divider">

                                <div class="row g-1 align-items-center">
                                    <div class="col-12 col-md-3 text-aling-center text-md-center ">
                                        <p>{{Cuppon.reference}}</p>
                                    </div>
                                    <div class="col-12 col-md-2 text-center text-md-center ">
                                        <p>{{Cuppon.sector}}</p>
                                    </div>
                                    <div class="col-12 col-md-3 text-center text-md-center ">
                                        <p>{{Cuppon.numero}}</p>
                                    </div>
                                    <div class="col-12 col-md-1 text-center text-md-center ">
                                        <p>{{Cuppon.perforacion}}</p>
                                    </div>
                                    <div class="col-12 col-md-1 text-center text-md-center ">
                                        <p>{{Cuppon.pago}}</p>
                                    </div>
                                    <div class="col-12 col-md-1 text-center text-md-center ">
                                        <p>{{Cuppon.cajera}}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="divider">

                        <div class="row g-1 align-items-center">
                            <div class="col-8 col-md-8">
                            </div>
                            <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                <p class="mb-0 p-0 fw-bolder h5">Total:</p>
                            </div>
                            <div class="col-2 col-md-2 text-end text-md-end align-content-end">
                                <p class="mb-0 fw-bolder h5 p-0">$ {{total}} MXN</p>
                            </div>
                        </div>

                        <div class="row justify-content-end m-3 ">
                            <div class="col-3 col-md-12 text-end text-md-end align-items-end ">

                                <div v-if="loading" role="status" class="spinner-border text-success" style="width: 30px;height: 30px;margin: 0px 14px -10px 1px;"><span class="sr-only">Loading...</span></div>
                                <button type="submit" class="btn btn-success waves-effect btn-label waves-light">
                                    <i class="bx bx-wallet label-icon"></i>
                                    Pagar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="col-md-4">
        <table class="table table-responsive">
            <tbody>
                <tr>
                    <th>Gafet</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th></th>
                </tr>

                <tr v-for="(item, index) in data.Data">
                    <td>{{item.CHOFER}}</td>
                    <td>{{item.NOMBRE}}</td>
                    <td>{{item.APELLIDOS}}</td>
                    <td>
                        <button v-on:click="add(index)" type="button" class="btn btn-success waves-effect btn-label waves-light">
                            <i class="bx bx-check-double label-icon"></i> Agregar
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/Views/Coupons/PayCoupon.js"></script>
}