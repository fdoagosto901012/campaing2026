@{
    ViewBag.Title = "Block";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-sm-0 font-size-18"><i class=" bx bxs-coupon"></i> Bloqueo de cupones</h4>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="" method="POST" class="form-horizontal">
                                <!-- DIVISION FORM -->
                                <div class="row">
                                    <div class="col-xl-6">
                                        <div class="row control-group pb-4">
                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Sector</label>
                                                <input type="text" class="form-control span11" placeholder="SECTOR" name="sector" id="sector" value="" />
                                            </div>

                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Cupon</label>
                                                <input type="text" class="form-control span11" placeholder="CUPON" name="cupon" id="cupon" value="" />
                                            </div>
                                        </div>
                                        <div class="row control-group">
                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Bloquea</label>
                                                <input type="text" class="form-control span11" placeholder="¿Quien bloquea?" name="blockedBy" id="blockedBy" value="" />
                                            </div>
                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Razón</label>
                                                <!--<input type="text" class="form-control span11" placeholder="RAZÓN DE BLOQUEO" name="blockReason" id="blockReason" value="" />-->
                                                <textarea name="blockReason" id="blockReason" class="form-control span11"></textarea>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-xl-6">
                                        <div class="row control-group pb-4">
                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Fecha  alta:</label>
                                                <input type="date" class="form-control span11" name="date" id="date" value="" disabled/>
                                            </div>

                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Usuario alta:</label>
                                                <input type="text" class="form-control span11" placeholder="Alta de cupon por" name="userCoupon" id="userCoupon" value="" disabled />
                                            </div>
                                        </div>
                                        <div class="row control-group">
                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Fecha modificacion:</label>
                                                <input type="date" class="form-control span11" name="date" id="date" value=""  disabled/>
                                            </div>

                                            <div class="col-md-6 mb-6 ">
                                                <label class="form-label control-label">Usuario editor:</label>
                                                <input type="text" class="form-control span11" placeholder="Alta de cupon por" name="userCoupon" id="userCoupon" value="" disabled />
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <!-- DIVISION FORM -->
                                <div class="mt-4 form-actions">
                                    <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class=" bx bx-printer label-icon "></i>Generar</button>
                                </div>
                            </form>
                        </div>

                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

