@using System.Linq
@model List<radiotaxi.Model.Hotel>

@{
    ViewBag.Title = "Tarifas de cupones";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalHoteles = Model != null ? Model.Count : 0;

    var totalTarifas = Model != null
        ? Model.Sum(x => x.Couponrates != null ? x.Couponrates.Count : 0)
        : 0;
}

<div class="row">
    <div class="col-12">

        <div class="page-title-box d-sm-flex align-items-center justify-content-between">

            <div>
                <h4 class="mb-sm-0 font-size-18">
                    <i class="bx bx-purchase-tag text-primary me-1"></i>
                    Tarifas de cupones
                </h4>

                <p class="text-muted mb-0 mt-1">
                    Consulta y administra las tarifas registradas por cliente.
                </p>
            </div>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a href="/">Inicio</a>
                    </li>

                    <li class="breadcrumb-item active">
                        Tarifas
                    </li>
                </ol>
            </div>

        </div>

    </div>
</div>

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header border-bottom">

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">

                    <div>
                        <h5 class="card-title mb-1">
                            Tarifas por cliente
                        </h5>

                        <p class="text-muted mb-0">
                            Selecciona un cliente para visualizar sus tarifas.
                        </p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge bg-primary-subtle text-primary px-3 py-2 font-size-13">
                            <i class="bx bx-building-house me-1"></i>
                            @totalHoteles clientes
                        </span>

                        <span class="badge bg-success-subtle text-success px-3 py-2 font-size-13">
                            <i class="bx bx-purchase-tag me-1"></i>
                            @totalTarifas tarifas
                        </span>

                    </div>

                </div>

            </div>

            <div class="card-body">

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5">

                        <div class="avatar-md mx-auto mb-3">
                            <div class="avatar-title bg-light text-muted rounded-circle font-size-24">
                                <i class="bx bx-purchase-tag"></i>
                            </div>
                        </div>

                        <h5 class="mb-1">
                            No hay clientes disponibles
                        </h5>

                        <p class="text-muted mb-0">
                            No se encontraron clientes con tarifas registradas.
                        </p>

                    </div>
                }
                else
                {
                    <div class="accordion"
                         id="accordionRateList">

                        @foreach (radiotaxi.Model.Hotel hotel in Model)
                        {
                            var accordionId = "hotel-" + hotel.HotelID;
                            var headingId = "heading-" + hotel.HotelID;

                            var cantidadTarifas = hotel.Couponrates != null
                                ? hotel.Couponrates.Count
                                : 0;

                            <div class="accordion-item border rounded mb-3">

                                <h2 class="accordion-header"
                                    id="@headingId">

                                    <button class="accordion-button collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@accordionId"
                                            aria-expanded="false"
                                            aria-controls="@accordionId">

                                        <div class="d-flex align-items-center justify-content-between w-100 me-3">

                                            <div class="d-flex align-items-center">

                                                <div class="avatar-xs me-3">
                                                    <div class="avatar-title bg-primary-subtle text-primary rounded-circle">
                                                        <i class="bx bx-building-house"></i>
                                                    </div>
                                                </div>

                                                <div>
                                                    <h6 class="mb-0">
                                                        @hotel.Name
                                                    </h6>

                                                    <small class="text-muted">
                                                        Cliente / Hotel
                                                    </small>
                                                </div>

                                            </div>

                                            @if (cantidadTarifas > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    @cantidadTarifas
                                                    @(cantidadTarifas == 1 ? "tarifa" : "tarifas")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning">
                                                    Sin tarifas
                                                </span>
                                            }

                                        </div>

                                    </button>

                                </h2>

                                <div id="@accordionId"
                                     class="accordion-collapse collapse"
                                     aria-labelledby="@headingId"
                                     data-bs-parent="#accordionRateList">

                                    <div class="accordion-body p-0">

                                        @if (hotel.Couponrates == null ||
                                             !hotel.Couponrates.Any())
                                        {
                                            <div class="text-center py-4">

                                                <i class="bx bx-info-circle text-muted font-size-22"></i>

                                                <p class="text-muted mb-0 mt-2">
                                                    Este cliente no tiene tarifas registradas.
                                                </p>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">

                                                <table class="table table-hover align-middle mb-0">

                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Nombre</th>
                                                            <th>Perforación</th>
                                                            <th>Valor</th>
                                                            <th>Estado</th>
                                                            <th class="text-end">Acciones</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>

                                                        @foreach (radiotaxi.Model.Couponrate rate in hotel.Couponrates)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    <div class="d-flex align-items-center">

                                                                        <div class="avatar-xs me-2">
                                                                            <div class="avatar-title bg-light text-primary rounded-circle">
                                                                                <i class="bx bx-receipt"></i>
                                                                            </div>
                                                                        </div>

                                                                        <span class="fw-medium">
                                                                            @(string.IsNullOrWhiteSpace(rate.Name)
                                                                                ? "Sin nombre"
                                                                                : rate.Name)
                                                                        </span>

                                                                    </div>
                                                                </td>

                                                                <td>
                                                                    <span class="badge bg-primary-subtle text-primary">
                                                                        @rate.Cupontype.Name
                                                                    </span>
                                                                </td>

                                                                <td>
                                                                    <span class="fw-semibold text-success">
                                                                        @rate.Valor.ToString("$#,##0.00") MXN
                                                                    </span>
                                                                </td>

                                                                <td>
                                                                    @if (rate.active)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success">
                                                                            <i class="bx bx-check-circle me-1"></i>
                                                                            Activa
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-danger-subtle text-danger">
                                                                            <i class="bx bx-x-circle me-1"></i>
                                                                            Inactiva
                                                                        </span>
                                                                    }
                                                                </td>

                                                                <td class="text-end">

                                                                    <a href="/cupones/tarifas/editar/@rate.CouponrateID"
                                                                       class="btn btn-sm btn-success waves-effect btn-label waves-light">

                                                                        <i class="bx bx-edit-alt label-icon"></i>
                                                                        Editar

                                                                    </a>

                                                                </td>

                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>
</div>