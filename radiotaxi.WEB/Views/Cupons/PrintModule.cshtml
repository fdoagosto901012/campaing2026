                                                    </p>
                                                    <h5 class="fw-medium">{{item.Cupons[0].Couponrate.Cupontype.Name}} - $ {{item.Cupons[0].Couponrate.Valor}} MXN</h5>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class=" d-sm-flex align-items-end justify-content-end my-3">
                <a v-bind:href="'/cupones/exportpdf/' + key" style="margin-right: 12px;" type="button" class="btn btn-success waves-effect btn-label waves-light" target="_blank"><i class="mdi mdi-microsoft-excel me-1 label-icon" ></i> PDF</a> 
                <a v-bind:href="'/cupones/exportexcel/' + key" style="margin-right: 12px;" type="button" class="btn btn-success waves-effect btn-label waves-light" target="_blank"><i class="mdi mdi-microsoft-excel me-1 label-icon"></i> Excel</a> 
                <button v-on:click="disableorder($event,key)" type="button" class="btn btn-success waves-effect btn-label waves-light"><i class=" bx bx-check-double me-1 label-icon"></i> Finalizar</button>
            </div>
        </div>
    </div>
</div>

<div v-else class="row">
    <div class="col-md-12">
        <h2>CARGANDO LOS DATOS</h2>
    </div>
</div>

<!-- end table responsive -->
