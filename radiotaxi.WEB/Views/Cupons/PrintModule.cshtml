    <!--Oredenes de impresion-->
    <div class="col-xl-3">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0 font-size-18">Ordenes de impresión</h4>
                </div>
            </div>
        </div>
        <div class="card-body" v-for="[key, groups] in Object.entries(orders)" :key="clave">
            <div class="accordion accordion-flush" id="accordionFlushExample">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="flush-headingOne">
                        <button class="accordion-button fw-medium" type="button" data-bs-toggle="collapse" v-bind:data-bs-target="'#'+key" aria-expanded="true" aria-controls="flush-collapseOne">
                            Codigo: {{ key | truncate(13) }}
                        </button>
                    </h2>
                    <div :id="key" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample" style="">
                        <div class="accordion-body text-muted">
                            <div v-for="item in groups" class="row ">
                                <div class="col-md-12 align-self-center" style="padding: 30px;">
                                    <div class="mt-4 mt-sm-0">
                                        <p class="mb-1"><i class="bx bx-user"></i> Cliente / Hotel</p>
