        </div>
    </div>

    <!--CUPONES PRE IMPRESOS-->
    <div class="col-xl-3">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0 font-size-18">Grupos de cupones en impresión</h4>
                    <button v-on:click="print($event)" type="button" class="btn btn-success waves-effect btn-label waves-light"><i class="mdi mdi-microsoft-excel me-1 label-icon"></i> Excel</button>
                </div>
            </div>
        </div>
        <div class="card" v-for="item in CupponsPrinted ">
            <div class="card-header align-items-center d-flex">
