@{
    ViewBag.Title = "Print Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-sm-0 font-size-18"><i class=" bx bxs-coupon"></i> Reimpresión de relación de facturación de cupones</h4>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="" method="POST" class="form-horizontal">
                                <!-- DIVISION FORM -->
                                <div class="row control-group">
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Cliente</label>
                                        <input type="text" class="form-control span11" placeholder="Código de cliente" name="idClient" id="idClient" value="" />
                                    </div>
                                    <div class="col-md-4 mb-4 ">
                                        <label class="form-label control-label">Nombre</label>
                                        <input type="text" class="form-control span11" placeholder="NOMBRE DE LA CAJERA" name="clientName" id="clientName" value="" />
                                    </div>
                                </div>
                                <div class="row control-group">
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">N°. Factura:</label>
                                        <input type="text" class="form-control span11" placeholder="Código de cliente" name="invoiceNumber" id="invoiceNumber" value="" />
                                    </div>
                                </div>
                                <!-- DIVISION FORM -->
                                <div class="mt-4 form-actions">
                                    <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class=" bx bx-printer label-icon "></i>Imprimir</button>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

