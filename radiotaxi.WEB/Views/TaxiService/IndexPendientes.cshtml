    <!--End-Action boxes-->
    <!--Chart-box-->
    <div class="row-fluid">
        <div class="span12">
            <div class="widget-box">
                <div class="widget-title">
                    <span class="icon"><i class="icon-th"></i></span>
                    <h5>Servicios Radio Taxi</h5>
                </div>
                <div class="widget-content nopadding">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>
                                    Tel&eacute;fono Cliente
                                </th>
                                <th>
                                    Nombre Cliente
                                </th>
                                <th>
                                    Fecha solicitado
                                </th>
                                <th>
                                    Hora del Servicio
                                </th>
                                <th>
                                    Origen
                                </th>
                                <th>
                                    Observaci&oacute;n
                                </th>
                                <th>
                                    N&uacute;mero RT
                                </th>
                                <th>
                                    Base
                                </th>
                                <th>
                                    Estado
                                </th>
                                <th>
                                    Renovaci&oacute;n Autom&aacute;tica
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr @(item.AppService != null ? " class=appService " : " class=clasicService ")>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.phoneId)
                                    </td>

                                    <td>
                                        @(item.client1.name + " " + item.client1.lastname1 + " " + item.client1.lastname2)
                                    </td>
                                    <td>
                                        @item.dateRequested.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @item.datePickUp.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.AppService != null)
                                        {
                                            <div>
                                                <p>
                                                    @Html.DisplayFor(modelItem => item.startPoint)
                                                </p>
                                                <br />
                                            </div>  
                                            <div>
                                                <a class="btn btn-mini btn-primary" target="_blank" href="@("https://www.google.com.mx/maps/dir/" + item.AppService.start_lat + "," + item.AppService.start_lng + "/" + item.AppService.end_lat + "," + item.AppService.end_lng + "/@21.1548364,-86.872597,13.5z")">Google maps</a>
                                                
                                            </div>
                                        }
                                        else
                                        {
                                            @Html.DisplayFor(modelItem => item.startPoint)
                                        }
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.note)
                                    </td>
                                    <td>
                                        @{
                                            string numeros = "*";
                                            if (item.rtNumberServices.Count > 0)
                                            {
                                                if (item.AppService != null)
                                                {
                                                    <div class="ui-widget">
                                                        <select name="@Html.Raw("rtNumberServices"+item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="rtNumberServices" value="" style="width:70px;">
                                                            @foreach (var _item in (List<unit_taxi>)ViewBag.unit_taxis_app)
                                                            {
                                                                <option @(item.rtNumberServices.FirstOrDefault().rtNumber == @_item.rtNumber ? " selected " : "")>@_item.rtNumber</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }else{
                                                    <div class="ui-widget">
                                                        <select name="@Html.Raw("rtNumberServices"+item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="rtNumberServices" value="" style="width:70px;">
                                                            @foreach (var _item in (List<unit_taxi>)ViewBag.unit_taxis)
                                                            {
                                                                <option @(item.rtNumberServices.FirstOrDefault().rtNumber == @_item.rtNumber ? " selected " : "")>@_item.rtNumber</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                if (item.AppService != null)
                                                {
                                                    <div class="ui-widget">
                                                        <select name="@Html.Raw("rtNumberServices"+item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="rtNumberServices" value="" style="width:70px;">
                                                            @foreach (var _item in (List<unit_taxi>)ViewBag.unit_taxis_app)
                                                            {
                                                                <option>@_item.rtNumber</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="ui-widget">
                                                        <select name="@Html.Raw("rtNumberServices"+item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="rtNumberServices" value="" style="width:70px;">
                                                            @foreach (var _item in (List<unit_taxi>)ViewBag.unit_taxis)
                                                            {
                                                                <option>@_item.rtNumber</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }


                                            }
                                            <span class="@Html.Raw("error alert-input-" + item.id)" style="color:red;"></span>
                                        }
                                    </td>
                                    <td>
                                        <select name="@Html.Raw("baseServiceId" + item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="baseServiceId" style="width:70px;">
                                            @foreach (var baseServiceId in ViewBag.baseService)
                                            {
                                                <option @if (item.baseServiceId == baseServiceId.id)
                                                { @Html.Raw("selected")      } value="@Html.Raw(baseServiceId.id)">@Html.Raw(baseServiceId.name)</option>
                                            }
                                        </select>

                                    </td>
                                    <td>
                                        <select name="@Html.Raw("statusServiceId"+item.id.ToString())" data-id="@Html.Raw(item.id)" data-attribute="statusServiceId" style="width:100px;">
                                            @foreach (var statusServices in ViewBag.status)
                                            {
                                                <option @if (item.statusServiceId == statusServices.id) { @Html.Raw("selected")     } value="@Html.Raw(statusServices.id)">@Html.Raw(statusServices.name)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.autoRenew)
                                    </td>
                                    <td>
                                        <a href="/TaxiService/Edit/@item.id" class="btn btn-mini btn-primary"><i class="icon-edit"></i></a>
                                        <a href="/TaxiService/Details/@item.id" class="btn btn-mini btn-primary"><i class="icon-cog"></i></a>
                                        <a href="/TaxiService/Delete/@item.id" class=" btn btn-mini btn-primary"><i class="icon-remove"></i></a>
                                        <a data-object="@Html.Raw(item.id)" href="#" class=" btn btn-mini btn-primary fast-update"><i class="icon-refresh"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
            @Html.PagedListPager(Model, page => Url.Action("IndexPendientes",new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
        </div>
        <!--End-Chart-box-->
        <hr />
    </div>
</div>


@section Scripts {
    <script>
        //$('.textarea_editor').wysihtml5();
        fastUpdate();

        function fastUpdate() {
            $(document).on("click", ".fast-update", function (event) {
                event.preventDefault();

                var objectService = $(this).data("object");
                var rtNumberServices = $("select[name='rtNumberServices" + objectService + "']").val();
                var baseServiceId = $("select[name='baseServiceId" + objectService + "']").val();
                var statusServiceId = $("select[name='statusServiceId" + objectService + "']").val();


                if (!$.isNumeric(rtNumberServices)) {
                    //Check if phone is numeric
                    $(".alert-input-" + objectService).html("Ingrese valores num&eacute;ricos");
                    $('*[data-object="' + objectService + '"]').removeClass("btn-primary");
                    $('*[data-object="' + objectService + '"]').removeClass("btn-success");
                    $('*[data-object="' + objectService + '"]').addClass("btn-danger");
                } else {
                    $(".alert-input-" + objectService).html("");
                    $.ajax({
                        type: "POST",
                        url: '/TaxiService/fastUpdate/',
                        data: {
                            objectService: objectService,
                            rtNumberServices: rtNumberServices,
                            baseServiceId: baseServiceId,
                            statusServiceId: statusServiceId
                        },
                        success: function (data) {
                            if (data == "OK") {
                                console.log(data);
                                $('*[data-object="' + objectService + '"]').removeClass("btn-primary");
                                $('*[data-object="' + objectService + '"]').removeClass("btn-danger");
                                $('*[data-object="' + objectService + '"]').addClass("btn-success");
                            } else {
                                $('*[data-object="' + objectService + '"]').removeClass("btn-primary");
                                $('*[data-object="' + objectService + '"]').removeClass("btn-success");
                                $('*[data-object="' + objectService + '"]').addClass("btn-danger");
                            }
                        }
                    });
                }
            });
            
        }



        $(function () {
            $.widget("custom.combobox", {
                _create: function () {
                    this.wrapper = $("<span>")
                      .addClass("custom-combobox")
                      .insertAfter(this.element);

                    this.element.hide();
                    this._createAutocomplete();
                    this._createShowAllButton();
                },

                _createAutocomplete: function () {
                    var selected = this.element.children(":selected"),
                      value = selected.val() ? selected.text() : "";

                    this.input = $("<input>")
                      .appendTo(this.wrapper)
                      .val(value)
                      .attr("title", "")
                      .addClass("custom-combobox-input ui-widget ui-widget-content ui-state-default ui-corner-left")
                      .autocomplete({
                          delay: 0,
                          minLength: 0,
                          source: $.proxy(this, "_source")
                      })
                      .tooltip({
                          classes: {
                              "ui-tooltip": "ui-state-highlight"
                          }
                      });

                    this._on(this.input, {
                        autocompleteselect: function (event, ui) {
                            ui.item.option.selected = true;
                            this._trigger("select", event, {
                                item: ui.item.option
                            });
                        },

                        autocompletechange: "_removeIfInvalid"
                    });
                },

                _createShowAllButton: function () {
                    var input = this.input,
                      wasOpen = false;

                    $("<a>")
                      .attr("tabIndex", -1)
                      .attr("title", "Show All Items")
                      .tooltip()
                      .appendTo(this.wrapper)
                      .button({
                          icons: {
                              primary: "ui-icon-triangle-1-s"
                          },
                          text: false
                      })
                      .removeClass("ui-corner-all")
                      .addClass("custom-combobox-toggle ui-corner-right")
                      .on("mousedown", function () {
                          wasOpen = input.autocomplete("widget").is(":visible");
                      })
                      .on("click", function () {
                          input.trigger("focus");

                          // Close if already visible
                          if (wasOpen) {
                              return;
                          }

                          // Pass empty string as value to search for, displaying all results
                          input.autocomplete("search", "");
                      });
                },

                _source: function (request, response) {
                    var matcher = new RegExp($.ui.autocomplete.escapeRegex(request.term), "i");
                    response(this.element.children("option").map(function () {
                        var text = $(this).text();
                        if (this.value && (!request.term || matcher.test(text)))
                            return {
                                label: text,
                                value: text,
                                option: this
                            };
                    }));
                },

                _removeIfInvalid: function (event, ui) {

                    // Selected an item, nothing to do
                    if (ui.item) {
                        return;
                    }

                    // Search for a match (case-insensitive)
                    var value = this.input.val(),
                      valueLowerCase = value.toLowerCase(),
                      valid = false;
                    this.element.children("option").each(function () {
                        if ($(this).text().toLowerCase() === valueLowerCase) {
                            this.selected = valid = true;
                            return false;
                        }
                    });

                    // Found a match, nothing to do
                    if (valid) {
                        return;
                    }

                    // Remove invalid value
                    this.input
                      .val("")
                      .attr("title", value + " didn't match any item")
                      .tooltip("open");
                    this.element.val("");
                    this._delay(function () {
                        this.input.tooltip("close").attr("title", "");
                    }, 2500);
                    this.input.autocomplete("instance").term = "";
                },

                _destroy: function () {
                    this.wrapper.remove();
                    this.element.show();
                }
            });

           
        });

    </script>

}