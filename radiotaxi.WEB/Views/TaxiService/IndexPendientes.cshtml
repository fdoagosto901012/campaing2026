<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = "Servicios pendientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .appService {
        background: #47ce45;
        color: white;
    }

        .appService:hover {
            background: #72da71;
            color: white;
        }

    .clasicService {
        background: #47515b;
        color: white;
    }

    .clasicService:hover {
        background: #474a4e;
        color: white;
    }


    .custom-combobox {
        position: relative;
        display: inline-block;
    }

    .custom-combobox-toggle {
        position: absolute;
        top: 0;
        bottom: 0;
        margin-left: -1px;
        padding: 0;
    }

    .custom-combobox-input {
        margin: 0;
        padding: 5px 10px;
    }
</style>

