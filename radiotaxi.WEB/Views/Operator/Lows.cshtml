@{
    ViewBag.Title = "Lows";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Operadores dados de baja</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                    <li class="breadcrumb-item active">Operadores</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title  bx bx-search-alt-2"> Búsqueda</h4>
                <p class="card-title-desc">La búsqueda se puede realizar con cualquiera de los siguientes campos.</p>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div>
                            <form action="/Operator/" method="POST" class="form-horizontal">
                                <div class="row control-group">
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Gafet</label>
                                        <input type="text" class="form-control span11" name="gafet" id="phoneNumber" value=""@*(ViewBag.parameters.gafet != null ? ViewBag.parameters.gafet : "")"*@ placeholder="Ingrese el número de gafet" />
                                    </div>
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Nombre</label>
                                        <input type="text" class="form-control span11" placeholder="Ingrese el nombre" name="name" id="name" value=""@*(ViewBag.parameters.name != null ? ViewBag.parameters.name : "")"*@ />
                                    </div>
                                    <div class="col-md-3 mb-3 ">
                                        <label class="form-label control-label">Apellidos</label>
                                        <input type="text" class="form-control span11" placeholder="Ingrese los apellidos" name="lastName1" id="lastName1" value=""@*(ViewBag.parameters.lastName1 != null ? ViewBag.parameters.lastName1 : "")"*@ />
                                    </div>
                                    <div class="col-md-3 mb-3 mt-4 pt-1 form-actions">
                                        <button type="submit" value="Buscar" class="btn btn-success waves-effect btn-label waves-light"> <i class="bx bx-search label-icon "></i>Buscar</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

