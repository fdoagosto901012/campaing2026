@{
    ViewBag.Title = "Padron | Generar contraseña ";
}


<div id="main" class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header card-header-primary">
                        <h4 class="card-title">Registro de contraseña para : @ViewBag.User.partnerReference @ViewBag.User.firstName @ViewBag.User.lastNameF  @ViewBag.User.lastNameM</h4>
                        <p class="card-category">Contraseña para entrar a plataforma o app.</p>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.exist)
                        {
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="alert alert-success">
                                        <h3>El usuario ya cuenta con contraseña</h3>
                                        <p>Si desea cambiar la contraseña favor de comunicarse con el departamento de sistemas.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 text-right">
                                    <a href="/Operator/register/edit/@ViewBag.User.partnerReference" class="btn btn-default">Editar contraseña</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-12">
                                    @if (ViewBag.error != null)
                                    {
                                        <span>@(ViewBag.error)</span>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <form v-on:submit="submit($event)" action="/Operator/register/@ViewBag.User.partnerReference" method="post" class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="Email">Dirección de correo / Usuario</label>
                                        <input v-on:change="confirmEmail()" v-validate="'required'" type="text" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('Email')}" id="Email" name="Email" aria-describedby="emailHelp" placeholder="Ingresa un correo eletrónico o Usuario" value="@(ViewBag.email)">
                                        <small id="emailHelp" class="form-text text-muted"></small>
                                        <span class="text-danger" v-show="this.errors.has('Email')">{{ this.errors.first('Email') }}</span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="Emailconfirm">Confirme la dirección de correo / Usuario</label>
                                        <input v-on:change="confirmEmail()" v-validate="'required'" type="text" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('Emailconfirm')}" id="Emailconfirm" name="Emailconfirm" aria-describedby="emailHelp" placeholder="Ingresa un correo eletrónico o Usuario" value="@(ViewBag.email)">
                                        <small id="emailHelp" class="form-text text-muted"></small>
                                        <span class="text-danger" v-show="this.errors.has('Emailconfirm')">{{ this.errors.first('Emailconfirm') }}</span>
                                        <span class="Emailconfirm has-error text-danger"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="Password">Contraseña</label>
                                        <input v-validate="'required|min:8'" v-on:change="confirmPassword()" type="password" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('Password')}" id="Password" name="Password">
                                        <ul class="list-unstyled">
                                            <li>
                                                <small id="emailHelp" class="form-text text-muted">La contraseña debe contener un mínimo de 4 caracteres.</small>
                                            </li>
                                            <li>
                                                <span class="text-danger" v-show="this.errors.has('Password')">{{ this.errors.first('Password') }}</span>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="Passwordconfirm">Confirmar Contraseña</label>
                                        <input v-on:change="confirmPassword()" v-validate="'required|min:8'" type="password" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('Passwordconfirm')}" id="Passwordconfirm" name="Passwordconfirm">
                                        <span class="text-danger" v-show="this.errors.has('Passwordconfirm')">{{ this.errors.first('Passwordconfirm') }}</span>
                                        <span class="confirmPassword has-error text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label for="Phone">Número Teléfonico</label>
                                        <input v-validate="'required|numeric|min:10|max:10'" type="tel" class="form-control" id="Phone" name="Phone" aria-describedby="emailHelp" placeholder="Ingrese los 10 digítos del número teléfonico" value="@(ViewBag.password)">
                                        <ul class="list-unstyled">
                                            <li>
                                                <small id="emailHelp" class="form-text text-muted">El número de teléfono proporcionado sera usado para tener una comunicación mas rápida en caso de ser necesario.</small>
                                            </li>
                                            <li>
                                                <span class="text-danger" v-show="this.errors.has('Phone')">{{ this.errors.first('Phone') }}</span>
                                            </li>
                                        </ul>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Registrar</button>
                                </form>
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <h4>Registro de usuario</h4>
                                            <p>El registro de usuario permite iniciar sessión en las diferentes plataformas de inforamción del sindicato de Taxistas Andres Quintana Roo.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div>
                                                <label style="font-size: 20px; font-weight: bold;">Contraseña sugerida</label>
                                                <div class="input input-ex-1">
                                                    <input style="padding: 7px; font-size: 20px; font-weight: bold;" type="text" class="input-generator-pass">
                                                    <button class="btn btn-success">Actualizar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/Views/Operator/generate-password.js"></script>
    <script src="~/Content/js/Views/Operator/GeneratePassword.js"></script>
}