                                                                                {
                                                                                    <tr>
                                                                                        <td>@(pay.Id_Op ?? "")</td>
                                                                                        <td>@(pay.FechaOp ?? "")</td>
                                                                                        <td>@(pay.Familia ?? "")</td>
                                                                                        <td>@(pay.Id_Cliente ?? "")</td>
