@model radiotaxi.Model.Operator
@{
    ViewBag.Title = Model.partnerReference;
}

<!-- DATOS DE CONTROL JS -->
<input id="gafet" name="gafet" type="hidden" value="@Model.partnerReference" />
<input id="userId" name="userId" type="hidden" value="@Model.userId" />
<input id="porcentaje" name="porcentaje" type="hidden" value="@(ViewBag.Porcentaje)" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18"><i class="bx bx-car"></i> @Model.CHOFER</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0"></ol>
            </div>
        </div>
    </div>
</div>

<!-- end page title -->
<div class="row">
    <div class="col-xl-9 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-start mt-3 mt-sm-0">
                            <div class="flex-lg-shrink-0">
                                <div class="avatar-xl me-3">
                                    @if (!string.IsNullOrEmpty(Model.urlImage))
                                    {
                                        if (Model.STATUS == "B")
                                        {
                                            <img title="Operador dado de baja" src="@(Model.urlImage)" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail" style="background-color: red;">
                                        }
                                        else
                                        {
                                            <img src="@(Model.urlImage)" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                        }
                                    }
                                    else
                                    {
                                        if (Model.STATUS == "B")
                                        {
                                            <img title="Operador dado de baja" src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail" style="background-color: red;">
                                        }
                                        else
                                        {
                                            <!-- Fallback cuando no hay imagen registrada -->
                                            <img src="~/Content/images/users/empty.png" alt="" class="avatar-xl rounded-circle me-2 img-thumbnail">
                                        }
                                    }
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div>
                                    <div class="d-flex flex-wrap align-items-start gap-2 gap-lg-3 text-muted font-size-13">
                                        @if (Model.express == true)
                                        {
                                            <div>
                                                <i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>
                                                <span class="badge rounded-pill bg-success">Pregafet</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>
                                                <span class="badge rounded-pill bg-primary">Entrada convencional</span>
                                            </div>
                                        }
                                    </div>

                                    <h4 class="font-size-18 mb-1 fw-bolder">@(Model.CHOFER ?? "")</h4>
                                    <h6 class="font-size-14 mb-1">@(Model.NOMBRE != null ? Model.NOMBRE.ToUpper() : "") @(Model.APELLIDOS != null ? Model.APELLIDOS.ToUpper() : "")</h6>
                                    <p class="text-muted font-size-13 mb-0">
                                        <span class="fw-bold">Fecha de ingreso:</span> @(Model.FECHAING != null ? Model.FECHAING.Value.ToString("dd/MM/yyyy") : "")
                                    </p>
                                    @if (Permissions.allow("Admin, Archivo"))
                                    {
                                        <p class="text-muted font-size-13 ">
                                            <span class="fw-bold">Número telefónico:</span> @(Model.TELEFONO ?? "")
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div> <!-- FIN PERFIL-->
                </div>

                <ul class="nav nav-tabs-custom card-header-tabs border-top mt-4" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link px-3 active" data-bs-toggle="tab" href="#general" role="tab">General</a>
                    </li>

                    @if (Permissions.allow("Admin, Practi-Plusvalia, Practi-AutoS"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#permisos" role="tab">PERMISOS EXP.</a>
                        </li>
                    }

                    @if (Permissions.allow("Admin, Practi-AdminTurkey, Practi-Cajas"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#pavos" role="tab">Pavos</a>
                        </li>
                    }

                    @if (Permissions.deny("Practi-AutoS, Practi-AdminTurkey, Practi-Actas, Practi-Cajas, Clinica, Practi-Plusvalia, Practi-Prevision, Practi-Tte"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#tarjeton" role="tab">Tarjetón</a>
                        </li>
                    }
                    @if (Permissions.deny("Clinica, Practi-Plusvalia, Practi-Prevision"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#finanzas" role="tab">Finanzas</a>
                        </li>
                    }

                    @if (Permissions.allow("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#cupones" role="tab">Cupones</a>
                        </li>
                    }


                    <li class="nav-item">
                        <a class="nav-link px-3" data-bs-toggle="tab" href="#bloqueos" role="tab">Bloqueos</a>
                    </li>

                    @if (Permissions.deny("tarjeton, Clinica, Practi-Plusvalia, Practi-Prevision"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#reportes" role="tab">Reportes</a>
                        </li>
                    }
                    @if (Permissions.deny("Clinica, Practi-Plusvalia, Practi-Prevision"))
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" data-bs-toggle="tab" href="#convenios" role="tab">Convenios</a>
                        </li>
                    }

                    <!-- Botonera SIEMPRE visible; cada botón se controla con permisos individuales -->
                    <li class="nav-item ms-auto my-auto ">
                        @if (Permissions.allow("Admin, Archivo"))
                        {
                            <a href="/Operator/Edit/@Model.partnerReference" class="btn btn-success btn-label ">
                                <i class="bx bx-edit-alt label-icon"></i> Editar
                            </a>
                        }
                        @if (Model.urlImage != null && Permissions.allow("Admin, Credenciales"))
                        {
                            <a href="/credential/view/@Model.partnerReference" class="btn btn-success btn-label" target="_blank">
                                <i class="bx bx-printer label-icon"></i> Imprimir credencial
                            </a>
                        }

                        @if (Permissions.allow("Admin,Archivo, Practi-Prevision, Practi-Plusvalia, Practi-Tte, Practi-Trabajo, Practi-AutoS"))
                        {
                            <div class="btn-group">
                                <button type="button" class="btn btn-success waves-light waves-effect dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Más <i class="mdi mdi-dots-vertical ms-2"></i>
                                </button>
                                <div class="dropdown-menu">
                                    @if (Permissions.allow("Admin"))
                                    {
                                        <a class="dropdown-item" href="/Operator/faltas/sindicales/@Model.partnerReference">Quitar faltas</a>
                                    }
                                    @if (Permissions.allow("Admin,Archivo, Practi-Prevision, Practi-Plusvalia, Practi-Tte, Practi-Trabajo, Practi-AutoS"))
                                    {
                                        <a class="dropdown-item" href="/Operator/Bloqueos/@Model.partnerReference">Bloquear</a>
                                    }
                                    @if (Permissions.allow("Admin"))
                                    {
                                        <a class="dropdown-item" href="/Operator/correctivo/@Model.partnerReference">Correctivo Disciplinario</a>
                                    }
                                </div>
                            </div>
                        }
                    </li>
                </ul>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="tab-content">
            <!-- GENERAL -->
            <div class="tab-pane active" id="general" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"><i class="bx bx-info-circle"></i> Información general</h5>
                    </div>

                    <div class="card-body">
                        <div class="pb-3">

                            <!-- Fecha nacimiento -->
                            <div class="row g-2 align-items-start mb-2">
                                <div class="col-12 col-md-3">
                                    <h6 class="font-size-15 mb-0">Fecha de nacimiento:</h6>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="text-muted">
                                        @if (Model.birthDate != null)
                                        {
                                            <p class="mb-0">@(((DateTime)Model.birthDate).ToString("dd/MM/yyyy"))</p>
                                        }
                                        else
                                        {
                                            <p class="mb-0">NO REGISTRADO</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Lugar nacimiento -->
                            <div class="row g-2 align-items-start mb-2">
                                <div class="col-12 col-md-3">
                                    <h6 class="font-size-15 mb-0">Lugar de nacimiento:</h6>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="text-muted">
                                        @if (Model.LUGARNAC != null)
                                        {<p class="mb-0">@Model.LUGARNAC.ToUpper()</p> }
                                    else
                                    { <p class="mb-0">NO REGISTRADO</p>}
                                    </div>
                                </div>
                            </div>

                            <!-- Sexo -->
                            <div class="row g-2 align-items-start mb-2">
                                <div class="col-12 col-md-3">
                                    <h6 class="font-size-15 mb-0">Sexo:</h6>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="text-muted">
                                        @if (Model.SEXO != null)
                                        {
                                            <p class="mb-0">@(Model.SEXO == "" ? "No registrado" : Model.sex == 1 ? "Masculino" : "Femenino")</p>
                                        }
                                        else
                                        { <p class="mb-0">NO REGISTRADO</p>}
                                    </div>
                                </div>
                            </div>

                            <!-- Ciudad -->
                            <div class="row g-2 align-items-start mb-2">
                                <div class="col-12 col-md-3">
                                    <h6 class="font-size-15 mb-0">Ciudad actual:</h6>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="text-muted">
                                        @if (Model.CIUDADACT != null)
                                        {<p class="mb-0">@Model.CIUDADACT</p> }
                                    else
                                    { <p class="mb-0">NO REGISTRADO</p>}
                                    </div>
                                </div>
                            </div>

                            <!-- Domicilio -->
                            @if (Permissions.deny("Clinica, Practi-BasicView"))
                            {
                                <div class="row g-2 align-items-start mb-2">
                                    <div class="col-12 col-md-3">
                                        <h6 class="font-size-15 mb-0">Domicilio actual:</h6>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="text-muted">
                                            @if (Model.userAddresses != null && Model.userAddresses.Count() > 0)
                                            {
                                                try
                                                {
                                                    <p class="mb-0 text-break">
                                                        @(Model.userAddresses.FirstOrDefault().address + ", "
                                            + Model.userAddresses.FirstOrDefault().address2 + ", "
                                            + Model.userAddresses.FirstOrDefault().colony + ", SM "
                                            + Model.userAddresses.FirstOrDefault().supermanzana + ", MZ "
                                            + Model.userAddresses.FirstOrDefault().manzana + ", LT "
                                            + Model.userAddresses.FirstOrDefault().lote + ", Calle "
                                            + Model.userAddresses.FirstOrDefault().street + ", CP "
                                            + Model.userAddresses.FirstOrDefault().postalCode)
                                                    </p>
                                                }
                                                catch (Exception)
                                                {
                                                    <span>Error al cargar la dirección</span>
                                                }
                                            }
                                            else
                                            {
                                                <p class="mb-0">NO REGISTRADO</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- Estado civil -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0"><i class="fas fa-user-friends"></i> Estado civil</h5>
                            </div>
                            <div class="card-body">
                                <div class="pb-1">

                                    <div class="row g-2 align-items-start mb-2">
                                        <div class="col-12 col-md-4">
                                            <h6 class="font-size-15 mb-0">Estado civil:</h6>
                                        </div>
                                        <div class="col-12 col-md-8">
                                            <div class="text-muted">
                                                @if (Model.realtionship != null)
                                                {<p class="mb-0">@Model.realtionship</p> }
                                            else
                                            { <p class="mb-0">NO REGISTRADO</p>}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-2 align-items-start mb-2">
                                        <div class="col-12 col-md-4">
                                            <h6 class="font-size-15 mb-0">Cónyuge:</h6>
                                        </div>
                                        <div class="col-12 col-md-8">
                                            <div class="text-muted">
                                                @if (Model.CONYUGE != null)
                                                {<p class="mb-0">@Model.CONYUGE</p> }
                                            else
                                            { <p class="mb-0">NO REGISTRADO</p>}
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Estudios -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0"><i class="mdi mdi-school-outline"></i> Estudios/Educación</h5>
                            </div>
                            <div class="card-body">
                                <div class="pb-1">
                                    <div class="row g-2 align-items-start mb-2">
                                        <div class="col-12 col-md-4">
                                            <h6 class="font-size-15 mb-0">Escolaridad:</h6>
                                        </div>
                                        <div class="col-12 col-md-8">
                                            <div class="text-muted">
                                                @if (Model.ESCOLARIDAD != null)
                                                {<p class="mb-0">@Model.ESCOLARIDAD</p> }
                                            else
                                            { <p class="mb-0">NO REGISTRADO</p>}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- /GENERAL -->
            <!-- PAVOS -->
            <div class="tab-pane" id="pavos" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"><i class="mdi mdi-food-turkey"></i> Pavos (Generar Cupón)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4 mb-3">
                                @if (ViewBag.amountdebs <= ViewBag.maxdeb)
                                {
                                    <div class="card bg-success border-success text-white-50">
                                        <div class="card-body">
                                            <h5 class="mb-4 text-white"><i class="mdi mdi-food-turkey me-3"></i>Deuda</h5>
                                            <p class="mb-3 fw-bolder h2 p-0 text-white">@(ViewBag.amountdebs.ToString("C", new System.Globalization.CultureInfo("es-MX"))) MXN</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card bg-danger border-danger text-white-50">
                                        <div class="card-body">
                                            <h5 class="mb-4 text-white"><i class="mdi mdi-block-helper me-3"></i>Deuda</h5>
                                            <p class="mb-3 fw-bolder h2 p-0 text-white">@(ViewBag.amountdebs.ToString("C", new System.Globalization.CultureInfo("es-MX"))) MXN</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="col-md-4 mb-3">
                                <span class="text-muted mb-3 lh-1 d-block text-truncate">Información de entrega</span>
                                <div class="px-3" data-simplebar="init" style="max-height: 352px;">
                                    <div class="simplebar-wrapper" style="margin: 0 -16px;">
                                        <div class="simplebar-height-auto-observer-wrapper"><div class="simplebar-height-auto-observer"></div></div>
                                        <div class="simplebar-mask">
                                            <div class="simplebar-offset" style="right: -17px; bottom: 0;">
                                                <div class="simplebar-content-wrapper" style="height:auto; overflow:hidden scroll;">
                                                    <div class="simplebar-content" style="padding:0 16px;">
                                                        <ul class="list-unstyled activity-wid mb-0">
                                                            @foreach (radiotaxi.Model.ChristmasgiftPrinted printed in ViewBag.christmasgiftPrinted)
                                                            {
                                                                <li class="activity-list activity-border">
                                                                    <div class="activity-icon avatar-md">
                                                                        <span class="avatar-title bg-warning-subtle text-warning rounded-circle">
                                                                            <i class="bx bx-bitcoin font-size-24"></i>
                                                                        </span>
                                                                    </div>
                                                                    <div class="timeline-list-item">
                                                                        <div class="d-flex">
                                                                            <div class="flex-grow-1 overflow-hidden me-4">
                                                                                <h5 class="font-size-14 mb-1">@(printed.PrintedDate)</h5>
                                                                                <p class="text-truncate text-muted font-size-13">
                                                                                    <strong>Ticket Expedido</strong><br />
                                                                                    <strong>@(printed.PrintedBy)</strong>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </li>
                                                            }
                                                            @if (ViewBag.christmasgift != null)
                                                            {
                                                                <li class="activity-list">
                                                                    <div class="activity-icon avatar-md">
                                                                        <span class="avatar-title bg-primary-subtle text-primary rounded-circle">
                                                                            <i class="mdi mdi-litecoin font-size-24"></i>
                                                                        </span>
                                                                    </div>
                                                                    <div class="timeline-list-item">
                                                                        <div class="d-flex">
                                                                            <div class="flex-grow-1 overflow-hidden me-4">
                                                                                <h5 class="font-size-14 mb-1">@(((radiotaxi.Model.Christmasgift)(ViewBag.christmasgift)).DeliveryDate)</h5>
                                                                                <p class="text-truncate text-muted font-size-13">
                                                                                    <strong>Pavo Entregado</strong><br />
                                                                                    <strong>@(((radiotaxi.Model.Christmasgift)(ViewBag.christmasgift)).DeliveryBy)</strong>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="simplebar-placeholder" style="width:auto; height:438px;"></div>
                                    </div>
                                    <div class="simplebar-track simplebar-horizontal" style="visibility:hidden;"><div class="simplebar-scrollbar" style="display:none;"></div></div>
                                    <div class="simplebar-track simplebar-vertical" style="visibility:visible;"><div class="simplebar-scrollbar" style="height:282px; transform: translate3d(0,0,0); display:block;"></div></div>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                @if (Model.STATUS == "B")
                                {
                                    <div class="alert alert-danger alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-block-helper d-block display-4 mt-2 mb-3 text-danger"></i>
                                        <h5 class="text-danger">Sin derecho a pavo por baja</h5>
                                        <p>Lamentablemente, no podemos hacerte entrega del pavo que se había previsto, ya que tu cuenta no se encuentra al corriente de los pagos correspondientes.</p>
                                    </div>
                                }
                                else if ((ViewBag.christmasgiftPrinted).Count > 0 && ViewBag.christmasgift == null)
                                {
                                    <div class="alert alert-success alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-qrcode d-block display-4 mt-2 mb-3 text-success"></i>
                                        <h5 class="text-success">Felicidades, pavo entregado</h5>
                                        <p>El pavo fue entregado, usando el tikcet con el QR único correspondiente.</p>
                                        <h3>NOTA:</h3>
                                        <p>
                                            <strong>
                                                @(ViewBag.christmasgift.note)
                                            </strong>
                                        </p>
                                        @if (Permissions.allow("Admin,Practi-AdminTurkey"))
                                        {
                                            <a v-on:click="generateTicket('D','@(Model.partnerReference)')" href="#" class="btn btn-success waves-effect btn-label waves-light"><i class="bx bxs-paper-plane label-icon"></i> Reimprimir Cupón</a>
                                        }
                                    </div>
                                }
                                else if ((ViewBag.christmasgiftPrinted).Count > 0 && ViewBag.christmasgift != null)
                                {
                                    <div class="alert alert-success alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-qrcode d-block display-4 mt-2 mb-3 text-success"></i>
                                        <h5 class="text-success">Felicidades, pavo entregado</h5>
                                        <p>El pavo fue entregado, usando el ticket con el QR único correspondiente.</p>
                                        <p>
                                            NOTA: <br />
                                            @(ViewBag.christmasgift.note)
                                        </p>
                                    </div>
                                }
                                else if (ViewBag.amountdebs <= ViewBag.maxdeb || Permissions.allow("Admin,Practi-AdminTurkey"))
                                {
                                    <div class="alert alert-info alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-check-all d-block display-4 mt-2 mb-3 text-success"></i>
                                        <h5 class="text-success">Felicidades</h5>
                                        <p>Gracias por mantener tu cuenta al corriente de los pagos.</p>
                                        <label for="note" class="form-label">Nota</label>
                                        <textarea class="form-control mb-3" id="note" name="note" rows="2" placeholder="Agregar nota a la entrega."></textarea>
                                        <a v-on:click="generateTicket('D','@(Model.partnerReference)')" href="#" class="btn btn-success waves-effect btn-label waves-light mb-3"><i class="bx bxs-paper-plane label-icon"></i> Entregar Pavo</a>
                                        @*@if (Permissions.allow("Admin"))
                                    {
                                        <a v-on:click="generateTicket('D','@(Model.partnerReference)')" href="#" class="btn btn-success waves-effect btn-label waves-light mb-3"><i class="mdi mdi-food-turkey label-icon"></i> Entregar Pavo</a>
                                    }
                                        *@
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger alert-dismissible fade show px-4 mb-0 text-center" role="alert">
                                        <i class="mdi mdi-block-helper d-block display-4 mt-2 mb-3 text-danger"></i>
                                        <h5 class="text-danger">Sin derecho a pavo</h5>
                                        <p>No podemos hacerte entrega del pavo, ya que tu cuenta no está al corriente de pagos.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /PAVOS -->
            <!-- TARJETÓN -->
            <div class="tab-pane" id="tarjeton" role="tabpanel">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header"><h5 class="card-title mb-0"><i class="bx bx-id-card"></i> Nuevo tarjetón</h5></div>
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <div class="col">
                                    <div class="mt-1">
                                        <div class="row container">
                                            <div class="col-6 row">
