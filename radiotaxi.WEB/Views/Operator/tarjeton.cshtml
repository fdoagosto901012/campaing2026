                                            </thead>
                                            <tbody id="t-contet">
                                                @foreach (radiotaxi.Model.C_permissionsDTO permiss in ViewBag.permissions)
                                                {
                                                    <tr>
                                                        <td>@(permiss.id)</td>
                                                        <td>@(permiss.Descripcion)</td>
                                                        <td>@(permiss.dateStart)</td>
                                                        <td>@(permiss.dateEnd)</td>
                                                        @if (permiss.Exist == 0)
                                                        {
                                                            <td>PAGADO</td>
                                                        }
                                                        else
                                                        {
                                                            <td>POR PAGAR</td>
                                                        }
                                                        <td>
                                                            @if (permiss.Exist == 0)
                                                            {
                                                                <a href="/Operator/permiso/detalle/@(permiss.id)/@(Model.partnerReference)" class="btn btn-success waves-effect btn-label waves-light" target="_blank">
                                                                    <i class="bx bx-show label-icon"></i> Imprimir
                                                                </a>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th data-priority="2">Folio</th>
                                                    <th data-priority="2">Descripción</th>
                                                    <th data-priority="2">Fecha inicio</th>
                                                    <th data-priority="1">Fecha final</th>
                                                    <th data-priority="2">Status</th>
                                                    <th data-priority="2">Acciones</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- end col -->
                </div>
            </div>
            <!-- /PERMISOS -->
            <!-- CONVENIOS -->
            <div class="tab-pane" id="convenios" role="tabpanel">
                <div class="card">
                    <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-hands-helping"></i> Convenios</h5></div>
                    <div class="card-body">
                        <div class="table-rep-plugin">
                            <div class="table-responsive mb-0" data-pattern="priority-columns">
                                <table id="tconvenios" class="table table-striped display" style="width:100%" data-page-length='100'>
                                    <thead>
                                        <tr>
                                            <th class="text-center" data-priority="2">Acciones</th>
                                            <th data-priority="2">Convenio</th>
                                            <th data-priority="2">Concepto</th>
                                            <th data-priority="1">Fecha</th>
                                            <th data-priority="3">A favor</th>
                                            <th data-priority="4">Nombre</th>
                                            <th data-priority="2">Operador</th>
                                            <th data-priority="3">Nombre operador</th>
                                            <th class="text-center" data-priority="2">Partidas</th>
                                            <th class="text-end" data-priority="2">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody id="t-contet">
                                        @foreach (radiotaxi.Model.Convenio convenio in ViewBag.agreements)
                                        {
                                            <tr>
                                                <td class="text-center">
                                                    <a href="/Agreements/Details/@convenio.Id_Op"
                                                       class="btn btn-success waves-effect btn-label waves-light"
                                                       title="Ver detalles del convenio">

                                                        <i class="bx bx-show label-icon"></i>
                                                        Ver

                                                    </a>
                                                </td>
                                                <td>@(convenio.Id_Op)</td>
                                                <td>@(convenio.Concepto)</td>
                                                <td>@(convenio.FechaOp)</td>
                                                <td>@(convenio.AfavordeNum)</td>
                                                <td>@(convenio.AfavordeNombre)</td>
                                                <td>@(convenio.CargoANum)</td>
                                                <td>@(convenio.CargoANombre)</td>
                                                <td>@(convenio.Partidas.Value.ToString("0.##"))</td>
                                                <td>@((convenio.Monto ?? 0).ToString("C", new System.Globalization.CultureInfo("es-MX")))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th data-priority="2">N° Convenio</th>
                                            <th data-priority="2">Concepto</th>
                                            <th data-priority="2">Fecha</th>
                                            <th data-priority="2">A favor</th>
                                            <th data-priority="2">A favor nombre</th>
                                            <th data-priority="2">Cargo a operador</th>
                                            <th data-priority="1">Nombre</th>
                                            <th data-priority="2">Partidas</th>
                                            <th data-priority="2">Importe</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div> <!-- end card -->
            </div>
            <!-- /CONVENIOS -->
        </div>
        <!-- end tab content -->
    </div>
    <!-- end col -->

    <div class="col-xl-3 col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Porcentaje</h5>
                <div class="flex-wrap gap-2 font-size-14">
                    <div class="col-sm order-2 order-sm-1">
                        <div class="d-flex align-items-start mt-sm-0">
                            <div class="col-sm">
                                <div id="invested-overview" data-colors='["#5156be", "#34c38f"]' class="apex-charts"></div>
                            </div>
                        </div>
                    </div> <!-- FIN PORCENTAJE-->
                </div>
            </div>
            <!-- end card body -->
            <div class="card-footer text-center ">
                <div class="alert @(ViewBag.faltas != 0 ? "alert-danger" : "alert-success") alert-dismissible alert-label-icon label-arrow fade show" role="alert">
                    <i class="mdi @(ViewBag.faltas != 0 ? "mdi-block-helper" : "mdi-check-all") label-icon"></i>Faltas: <strong>@(ViewBag.faltas)</strong>
                </div>

                <div class="alert @(ViewBag.noPays != 0 ? "alert-danger" : "alert-success") alert-dismissible alert-label-icon label-arrow fade show" role="alert">
                    <i class="mdi @(ViewBag.noPays != 0 ? "mdi-block-helper" : "mdi-check-all") label-icon"></i>Permisos no pagados: <strong>@(ViewBag.noPays)</strong>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bx bx-folder"></i> Documentación importante</h5>
                <div class="flex-wrap gap-1 font-size-14">
                    <ul class="list-unstyled mb-0">
                        <li>
                            @if (Model.ine != null)
                            {<p class="my-0"><span class="fw-bold">INE:</span> @Model.ine.ToUpper()</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">INE:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @if (Model.urfc != null)
                            {<p class="my-0"><span class="fw-bold">RFC:</span> @Model.urfc.ToUpper()</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">RFC:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @if (Model.curp != null)
                            {<p class="my-0"><span class="fw-bold">CURP:</span> @Model.curp.ToUpper()</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">CURP:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @if (Model.LUGARNAC != null)
                            {<p class="my-0"><span class="fw-bold">Lugar de nacimiento:</span> @Model.LUGARNAC.ToUpper()</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">Lugar de nacimiento:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @if (Model.birthDate != null)
                            {<p class="my-0"><span class="fw-bold">Fecha de nacimiento:</span> @(((DateTime)Model.birthDate).ToString("dd/MM/yyyy"))</p> }
                            else
                            { <p class="my-0"><span class="fw-bold">Fecha de nacimiento:</span> NO REGISTRADO</p>}
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bx bx-id-card"></i> Licencia de conducir</h5>
                <div>
                    <ul class="list-unstyled mb-0">
                        <li>
                            @if (Model.LICENCIA != null)
                            {<p class="my-0"><span class="fw-bold">Licencia:</span> @Model.LICENCIA.ToUpper()</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">Licencia:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @* Mostrar con formato cuando exista *@
                            @if (Model.LICVENCE != null)
                            {<p class="my-0"><span class="fw-bold">Expira:</span> @* @Model.LICVENCE.Value.ToString("dd/MM/yyyy") *@</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">Expira:</span> NO REGISTRADO</p>}
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="mdi mdi-hospital"></i> Información médica</h5>
                <div>
                    <ul class="list-unstyled mb-0">
                        <li>
                            @if (Model.TIPOSANGRE != null)
                            {<p class="my-0"><span class="fw-bold">Tipo de sangre:</span> @Model.TIPOSANGRE</p> }
                        else
                        { <p class="my-0"><span class="fw-bold">Tipo de sangre:</span> NO REGISTRADO</p>}
                        </li>
                        <li>
                            @if (Model.allergies != null)
                            {<p class="my-0"><span class="fw-bold">Alergias:</span> @(Model.allergies == "Si" ? "Si" : "No")</p> }
                            else
                            { <p class="my-0"><span class="fw-bold">Alergias:</span> NO REGISTRADO</p>}
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div> <!-- end sidebar col -->
</div> <!-- end row principal -->

@section Scripts {
    <script src="~/Content/libs/DataTables/datatables.js"></script>
    <script src="~/Content/libs/DataTables/datatables.min.js"></script>
    <script src="~/Content/js/Views/Operator/tarjeton.js"></script>
    <!-- Importante para gráfico Porcentaje -->
    <script src="~/Content/libs/apexcharts/apexcharts.min.js"></script>
}
