                                                <tr>
                                                    <th data-priority="2">Taxi</th>
                                                    <th data-priority="2">Turno</th>
                                                    <th data-priority="1">Fecha de reporte</th>
                                                    <th data-priority="2">Fecha de pago</th>
                                                    <th data-priority="2">Ticket</th>
                                                    <th data-priority="2">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="t-contet">
