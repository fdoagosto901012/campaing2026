                                                                                    @if (Permissions.allow("Admin, tarjeton"))
                                                                                    {
                                                                                        <a href="~/card/edit/@(item.id)" class="btn btn-success waves-effect btn-label waves-light">
                                                                                            <i class="bx bx-edit-alt label-icon"></i> Editar
                                                                                        </a>
                                                                                        <a href="~/card/details/@(item.id)" class="btn btn-success waves-effect btn-label waves-light">
                                                                                            <i class="bx bx-detail label-icon"></i> Detalles
                                                                                        </a>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div> <!-- end col -->

                                            <div class="col-4">
                                                <div class="card">
                                                    <div class="card-header"><h5 class="card-title mb-0">Tarjetones pagados</h5></div>
                                                    <div class="card-body">
                                                        <div class="row justify-content-center">
                                                            <div class="col">
                                                                <div class="mt-1">
                                                                    <div class="row container">
                                                                        <table id="tech-companies-1" class="table table-striped">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th data-priority="1">Ticket</th>
                                                                                    <th data-priority="3">Fecha</th>
                                                                                    <th data-priority="1">Concepto</th>
                                                                                    <th data-priority="3">Taxi</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody id="t-content">
