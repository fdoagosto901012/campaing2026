            <!-- CUPONES -->

            <div class="tab-pane" id="cupones" role="tabpanel">
                <div class="row">

                    <div class="col-lg-12">

                        <div class="card">

                            <div class="card-header">

                                <div class="row align-items-center">

                                    <div class="col-md-6">

                                        <div class="mb-3 mb-md-0">

                                            <h5 class="card-title mb-1">
                                                <i class="bx bx-money"></i>
                                                Historial de pagos
                                            </h5>

                                            <p class="card-title-desc mb-0">
                                                Pagos realizados correspondientes a los cupones.
                                            </p>

                                        </div>

                                    </div>


                                    <div class="col-md-6">

                                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">

                                            <span class="badge bg-primary-subtle text-primary fs-6">

                                                <i class="bx bx-receipt me-1"></i>

                                                @ViewBag.Cuponspayments.Count

                                                @if (ViewBag.Cuponspayments.Count == 1)
                                                {
                                                    @:pago
                                                }
                                                else
                                                {
                                                    @:pagos
                                                }

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <div class="card-body">

                                <div class="table-rep-plugin">

                                    <div class="table-responsive mb-0"
                                         data-pattern="priority-columns">

                                        <table class="table table-striped table-hover">

                                            <thead>

                                                <tr>

                                                    <th data-priority="1">
                                                        Folio de pago
                                                    </th>

                                                    <th data-priority="1">
                                                        Fecha de pago
                                                    </th>

                                                    <th data-priority="1">
                                                        Cantidad cupones
                                                    </th>

                                                    <th data-priority="1">
                                                        Valor
                                                    </th>

                                                    <th data-priority="1"
                                                        class="text-center">
                                                        Acciones
                                                    </th>

                                                </tr>

                                            </thead>


                                            <tbody>

                                                @if (ViewBag.Cuponspayments != null &&
                                                     ViewBag.Cuponspayments.Count > 0)
                                                {
                                                    foreach (radiotaxi.Model.CouponPayment cuponpayment in ViewBag.Cuponspayments)
                                                    {
                                                        <tr>

                                                            <!-- FOLIO -->
                                                            <td>

                                                                <span class="fw-semibold">
                                                                    #@cuponpayment.CouponPaymentId
                                                                </span>

                                                            </td>


                                                            <!-- FECHA -->
                                                            <td>

                                                                <div>
                                                                    @cuponpayment.CreatedDate.ToString("dd/MM/yyyy")
                                                                </div>

                                                                <small class="text-muted">
                                                                    @cuponpayment.CreatedDate.ToString("hh:mm tt")
                                                                </small>

                                                            </td>


                                                            <!-- CANTIDAD DE CUPONES -->
                                                            <td>

                                                                <span class="badge bg-primary-subtle text-primary">

                                                                    <i class="bx bxs-coupon me-1"></i>

                                                                    @cuponpayment.Cupons.Count()

                                                                </span>

                                                            </td>


                                                            <!-- VALOR -->
                                                            <td>

                                                                <span class="badge bg-success-subtle text-success fs-6">
                                                                    @cuponpayment.TotalAmount.ToString("$#,##0.00") MXN
                                                                </span>

                                                            </td>


                                                            <!-- ACCIONES -->
                                                            <td class="text-center">

                                                                <a href="/cupones/pago/@cuponpayment.CouponPaymentId"
                                                                   class="btn btn-success waves-effect btn-label waves-light">

                                                                    <i class="bx bx-show label-icon"></i>

                                                                    Ver más

                                                                </a>

                                                            </td>

                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>

                                                        <td colspan="5"
                                                            class="text-center py-5">

                                                            <div class="text-muted">

                                                                <i class="bx bx-receipt font-size-24"></i>

                                                                <p class="mt-2 mb-0">
                                                                    No se encontraron pagos registrados.
                                                                </p>

                                                            </div>

                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>


                                            @if (ViewBag.Cuponspayments != null &&
                                                 ViewBag.Cuponspayments.Count > 0)
                                            {
                                                decimal totalPagos = 0;

                                                foreach (radiotaxi.Model.CouponPayment pago in ViewBag.Cuponspayments)
                                                {
                                                    totalPagos += pago.TotalAmount;
                                                }

                                                <tfoot>

                                                    <tr>

                                                        <td colspan="5">

                                                            <div class="d-flex justify-content-end align-items-center py-2">

                                                                <span class="fw-semibold me-3">
                                                                    Total pagado:
                                                                </span>

                                                                <span class="badge bg-success-subtle text-success fs-6">
                                                                    @totalPagos.ToString("$#,##0.00") MXN
                                                                </span>

                                                            </div>

                                                        </td>

                                                    </tr>

                                                </tfoot>
                                            }

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

            <!-- FIN CUPONES -->
