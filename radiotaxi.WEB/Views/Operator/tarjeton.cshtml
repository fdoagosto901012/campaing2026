                                                                    <li><p class="my-0"><span class="fw-bold">Marca:</span> {{data.Marca}}</p></li>
                                                                    <li><p class="my-0"><span class="fw-bold">Modelo:</span> {{data.Modelo}}</p></li>
                                                                    <li><p class="my-0"><span class="fw-bold">Año:</span> {{data.AutoAno}}</p></li>
                                                                    <li><p class="my-0"><span class="fw-bold">Serie:</span> {{data.No_Serie}}</p></li>
                                                                </ul>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <ul class="list-unstyled mb-0">
                                                                    <li><p class="my-0"><span class="fw-bold">Póliza:</span> {{data.poliza}}</p></li>
                                                                    <li><p class="my-0"><span class="fw-bold">Vencimiento de la póliza:</span> {{data.vencepoliza}}</p></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-2" />

                                        <div class="row">
                                            <div class="col-8">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h4 class="card-title">Historial de tarjetones del operador: @(Model.NOMBRE ?? "") @(Model.APELLIDOS ?? "")</h4>
                                                        <h4 class="card-title">Historial de tarjetones del operador No.: @(Model.CHOFER ?? "")</h4>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="table-rep-plugin">
                                                            <div class="table-responsive mb-0" data-pattern="priority-columns">
                                                                <table id="tech-companies-1" class="table table-striped">
                                                                    <thead>
                                                                        <tr>
                                                                            <th data-priority="1">Taxi</th>
                                                                            <th data-priority="3">Fecha de alta</th>
                                                                            <th data-priority="1">Fecha de baja</th>
                                                                            <th data-priority="3">Horario</th>
                                                                            <th data-priority="3">Acciones</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody id="t-content">
                                                                        @foreach (var item in ViewBag.cars)
                                                                        {
                                                                            <tr>
                                                                                <td>@(item.taxi ?? "")</td>
                                                                                <td>@(item.asignedDate != null ? item.asignedDate.ToString("yyyy/MM/dd") : "")</td>
                                                                                <td>@(item.expiration_date != null ? item.expiration_date.ToString("yyyy/MM/dd") : "")</td>
                                                                                <td>
                                                                                    @(item.turn == 1 ? "Matutino" : " ")
                                                                                    @(item.turn == 2 ? "Vespertino" : " ")
                                                                                    @(item.turn == 3 ? "Ambos" : " ")
                                                                                </td>
