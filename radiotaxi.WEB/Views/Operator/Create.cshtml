@{
    ViewBag.Title = "Crear operador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0"><i class="bx bxs-user-plus"></i> Alta operador</h4>
            </div>
            <div class="card-body">
                <div id="progrss-wizard" class="twitter-bs-wizard">
                    <ul class="twitter-bs-wizard-nav nav nav-pills nav-justified">
                        <li class="nav-item">
                            <a href="#informacionGeneral" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Información general">
                                    <i class="bx bx-list-ul"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#foto" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Foto">
                                    <i class="bx bx-list-ul"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#informacionContacto" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Información de contacto">
                                    <i class="bx bxs-contact"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#datosSindicales" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Datos sindicales">
                                    <i class="bx bx-book-bookmark"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#informacionMedica" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Informacion médica">
                                    <i class="bx bx-plus-medical"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#redesSociales" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Redes sociales">
                                    <i class="bx bx-group"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#direccion" class="nav-link" data-toggle="tab">
                                <div class="step-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Dirección">
                                    <i class="bx bx-map-pin"></i>
                                </div>
                            </a>
                        </li>
                    </ul>
                    <!-- wizard-nav -->
                    <div id="bar" class="progress mt-4">
                        <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"></div>
                    </div>
                    <form id="form6" class="formjs" v-on:submit="onSubmit" action="" method="POST" enctype="multipart/form-data">
                        <div class="tab-content twitter-bs-wizard-tab-content">
                            <div class="tab-pane active" id="informacionGeneral">
                                <div class="text-center mb-4">
                                    <h5>Información general del operador</h5>
                                    <p class="card-title-desc">Favor de llenar toda la información solicitada</p>
                                </div>

                                <div class="row">
                                    <div class="col-lg-2">
                                        <div class="mb-3">
                                            <label for="partnerReference">Gafet</label>
                                            <input type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('partnerReference')}" id="partnerReference" name="partnerReference" placeholder="Ingrese el No. de gafet" @(Permissions.allow("Admin") ? " " : " disabled ")>
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('partnerReference')">{{ this.errors.first('partnerReference') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="mb-3">
                                            <label for="partnerReference">RULETERO/TTE</label>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-check mb-3">
                                                        <input class="form-check-input" type="radio" name="typeoperator" id="ruletero" checked="" value="ruletero">
                                                        <label class="form-check-label" for="typeoperator">
                                                            Ruletero
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-check mb-3">
                                                        <input class="form-check-input" type="radio" name="typeoperator" id="tte" value="tte">
                                                        <label class="form-check-label" for="typeoperator">
                                                            TTE
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('partnerReference')">{{ this.errors.first('partnerReference') }}</span>
                                        </div>
                                    </div>

                                    <div class="col-lg-2">
                                        <div class="mb-3">
                                            <label for="partnerReference">NORMAL/FLASH</label>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-check mb-3">
                                                        <input class="form-check-input" type="radio" name="typeentrance" id="flash" checked="" value="flash">
                                                        <label class="form-check-label" for="typeentrance">
                                                            Flash
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-check mb-3">
                                                        <input class="form-check-input" type="radio" name="typeentrance" id="normal" value="normal">
                                                        <label class="form-check-label" for="typeentrance">
                                                            Normal
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('partnerReference')">{{ this.errors.first('partnerReference') }}</span>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="firstName">Nombre</label>
                                            <input v-validate="'required'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('firstName')}" id="firstName" name="firstName" placeholder="Ingrese el nombre del operador">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('firstName')">{{ this.errors.first('firstName') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="lastNameF">Apellido Paterno</label>
                                            <input v-validate="'required'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('lastNameF')}" id="lastNameF" name="lastNameF" placeholder="Ingrese el apellido paterno">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('lastNameF')">{{ this.errors.first('lastNameF') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="lastNameM">Apellido Materno</label>
                                            <input v-validate="'required'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('lastNameM')}" id="lastNameM" name="lastNameM" placeholder="Ingrese el apellido materno">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('lastNameM')">{{ this.errors.first('lastNameM') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="birthDate">Fecha de nacimiento</label>
                                            <input v-validate="'required'" type="date" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('birthDate')}" id="birthDate" name="birthDate">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('birthDate')">{{ this.errors.first('birthDate') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="birthPlace">Lugar de nacimiento</label>
                                            <input v-validate="'required'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('birthPlace')}" id="birthPlace" name="birthPlace" placeholder="Ingrese el lugar de nacimiento">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('birthPlace')">{{ this.errors.first('birthPlace') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="relationShipStatusId">Estado civil</label>
                                            <select id="relationShipStatusId" name="relationShipStatusId" class="form-select" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('relationShipStatusId')}">
                                                <option selected value="">Seleccione el estado civil</option>
                                                @foreach (var relationship in ViewBag.relationships)
                                                {
                                                    <option value="@relationship.id">@relationship.name</option>
                                                }
                                            </select>
                                            <span class="text-danger" v-show="this.errors.has('relationShipStatusId')">{{ this.errors.first('relationShipStatusId') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label for="sex">Sexo</label>
                                            <select id="sex" name="sex" class="form-select " v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('sex')}">
                                                <option selected value="">Seleccione el sexo</option>
                                                <option value="1">Masculino</option>
                                                <option value="2">Femenino</option>
                                            </select>
                                            <span class="text-danger" v-show="this.errors.has('sex')">{{ this.errors.first('sex') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <label for="rfc">RFC</label>
                                            <input v-validate="'required|alpha_num|min:12|max:13'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('rfc')}" id="rfc" name="rfc" placeholder="Ingrese el RFC">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('rfc')">{{ this.errors.first('rfc') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <label for="ine">INE</label>
                                            <input v-validate="'required|alpha_num|min:18|max:18'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('ine')}" id="ine" name="ine" placeholder="Ingrese el INE">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('ine')">{{ this.errors.first('ine') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <label for="curp">CURP</label>
                                            <input v-validate="'required|alpha_num|min:18|max:18'" type="text" class="form-control text-uppercase" v-bind:class="{ 'border-danger' : this.errors.has('curp')}" id="curp" name="curp" placeholder="Ingrese el CURP">
                                            <small id="emailHelp" class="form-text text-muted"></small>
                                            <span class="text-danger" v-show="this.errors.has('curp')">{{ this.errors.first('curp') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <!-- </form> FIN FORM 1 -->
                                <ul class="pager wizard twitter-bs-wizard-pager-link">
                                    <li class="next">
                                        <a v-on:click="next('foto')" class="btn btn-primary">
                                            Siguiente <i class="bx bx-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <!-- FIN TAB 1 -->
                            

                            <div class="tab-pane" id="foto">
                                <div class="text-center mb-4">
                                    <h5>Foto del operador</h5>
                                    <p class="card-title-desc">Favor de tomar la fotografía del operador</p>
                                </div>

                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <div class="row mb-3">
                                                <div class="col-md-12">
                                                    <video id="video" autoplay style="display: block; background: black; width: 100%; height: 0; padding-bottom: 75%;"></video>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6 text-center">
                                                    <a class="btn btn-primary" id="start-camera">Iniciar Camera</a>
                                                </div>
                                                <div class="col-6 text-center">
                                                    <a class="btn btn-primary" id="click-photo">Tomar Foto</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <div class="row mb-3">
                                                <div class="col-md-12">
                                                    <div class="img-container">
                                                        <canvas class="img-fluid" id="canvas" width="714" height="515"></canvas>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-12 text-center">
                                                    <a class="btn btn-primary" id="save-photo">Cortar Foto</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <div class="row mb-3">
                                                <div class="col-md-12 text-center">
                                                    <img class="thumbnails" id="cropped" src="https://dummyimage.com/500x600/000/000003" style="display: block; background: black; width: 66%; height: auto; margin: 0 auto;">
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-12 text-center">
                                                    <input id="file" type="file" name="file">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                
                                </div>

                                <!-- </form> FIN FORM 1 -->
                                <ul class="pager wizard twitter-bs-wizard-pager-link">
                                    <li class="previous">
                                        <a v-on:click="prev('informacionGeneral')" class="btn btn-primary">
                                            <i class="bx bx-chevron-left me-1"></i> Anterior
                                        </a>
                                    </li>
                                    <li class="next">
                                        <a v-on:click="next('informacionContacto')" class="btn btn-primary">
                                            Siguiente <i class="bx bx-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- FIN TAB FOTO -->
                            <div class="tab-pane" id="informacionContacto">
                                <div>
                                    <div class="text-center mb-4">
                                        <h5>Información de contacto</h5>
                                        <p class="card-title-desc">Favor de llenar toda la información solicitada</p>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-6">
                                            <div class="mb-3">
                                                <label for="phone">Teléfono</label>
                                                <!-- <input v-validate="'required|numeric|min:10|max:10'" type="tel" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('phone')}" id="phone" name="phone" placeholder="Ingrese el número de teléfono" /> -->
                                                <input v-on:input="setAndFilter($event)" v-validate="{ required: true, regex: /\(\d\d\d\)\s+\d\d\d\s+\d\d\d\d/i }" type="tel" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('userPhones[0].phone')}" id="userPhones[0].phone" name="userPhones[0].phone" placeholder="Ingrese el número de teléfono" />
                                                <small id="emailHelp" class="form-text text-muted"></small>
                                                <span class="text-danger" v-show="this.errors.has('userPhones[0].phone')">{{ this.errors.first('userPhones[0].phone') }}</span>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="mb-3">
                                                <label for="email">Correo</label>
                                                <input v-validate="'required|email'" type="email" class="form-control" v-bind:class="{ 'border-danger' : this.errors.has('emails[0].email1')}" id="emails[0].email1" name="emails[0].email1" placeholder="Ingrese el correo" />
                                                <small id="emailHelp" class="form-text text-muted"></small>
                                                <span class="text-danger" v-show="this.errors.has('emails[0].email1')">{{ this.errors.first('emails[0].email1') }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- </form> FIN FORM 2 -->
                                    <ul class="pager wizard twitter-bs-wizard-pager-link">
                                        <li class="previous">
                                            <a v-on:click="prev('foto')" class="btn btn-primary">
                                                <i class="bx bx-chevron-left me-1"></i> Anterior
                                            </a>
                                        </li>
                                        <li class="next">
                                            <a v-on:click="next('datosSindicales')" class="btn btn-primary">
                                                Siguiente <i class="bx bx-chevron-right ms-1"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <!-- FIN TAB 2 -->
                            <div class="tab-pane" id="datosSindicales">
                                <div>
                                    <div class="text-center mb-4">
                                        <h5>Datos sindicales</h5>
                                        <p class="card-title-desc">Favor de llenar toda la información solicitada</p>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                <label for="createdDt" class="form-label">Fecha de ingreso</label>
                                                <input type="date" class="form-control" id="createdDt" name="createdDt" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('createdDt')}">
                                                <span class="text-danger" v-show="this.errors.has('partnerTypeId')">{{ this.errors.first('partnerTypeId') }}</span>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                <label for="recommendedBy" class="form-label">Recomendado</label>
                                                <input type="text" class="form-control" id="recommendedBy" name="recommendedBy" placeholder="">
                                            </div>
                                        </div>

                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                <label for="partnerTypeId">Tipo de asociación</label>
                                                <select disabled id="partnerTypeId" name="partnerTypeId" class="form-select" v-validate="'required'" v-bind:class="{ 'border-danger' : this.errors.has('partnerTypeId')}">
                                                    <option selected value="">Seleccione el tipo de asociación</option>
                                                    @foreach (var partnerType in ViewBag.partnerTypes)
                                                    {
                                                        <option @(partnerType.id == 2 ? " selected " : "") value="@partnerType.id">@partnerType.name</option>
                                                    }
                                                </select>
                                                <span class="text-danger" v-show="this.errors.has('partnerTypeId')">{{ this.errors.first('partnerTypeId') }}</span>
                                            </div>
                                        </div>

