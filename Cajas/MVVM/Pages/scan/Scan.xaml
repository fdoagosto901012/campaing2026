<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cajas.MVVM.Pages.scan.Scan"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:scan="clr-namespace:Cajas.MVVM.ViewModels.scan"
             Title="Escanear">

    <ContentPage.BindingContext>
        <scan:ScanViewModel />
    </ContentPage.BindingContext>
    <Grid>
        <Grid RowDefinitions="1*,3*,1*">
            <zxing:CameraBarcodeReaderView
		Grid.Row="0" Grid.RowSpan="3"
		x:Name="barcodeView"
		BarcodesDetected="BarcodesDetected"
		 />

            <Grid
		        Grid.Row="0"
		        BackgroundColor="#aa000000">
                <Label x:Name="ResultLabel" Grid.Row="2" Text="" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
            </Grid>

            <Grid
		        Grid.Row="3"
		        BackgroundColor="#aa000000"
		        Padding="20"
		        ColumnDefinitions="Auto,*,Auto">

                <Button Text="🔄️" Grid.Column="0" BackgroundColor="#aa000000" CornerRadius="8" BorderColor="Black" Clicked="SwitchCameraButton_Clicked" />

                <zxing:BarcodeGeneratorView
			x:Name="barcodeGenerator"
			Grid.Column="1"
			HorizontalOptions="Center"
			VerticalOptions="Center"
			HeightRequest="100"
			WidthRequest="100"
			ForegroundColor="{StaticResource base}"
			Format="QrCode"
			Value="hola mundo"
			BarcodeMargin="1" />

                <Button Text="💡" Grid.Column="2" BackgroundColor="#aa000000" CornerRadius="8" BorderColor="Black" Clicked="TorchButton_Clicked" />
            </Grid>
        </Grid>



        <!-- Overlay with ActivityIndicator -->
        <Grid x:Name="Overlay" BackgroundColor="#80000000" IsVisible="{Binding Isbusy}">
            <Image Source="loading.gif"
               x:Name="imgLoader"
               HeightRequest="150" 
               HorizontalOptions="Center" 
               IsAnimationPlaying="False" />

        </Grid>


    </Grid>
    
    
    
    
    
</ContentPage>