<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cajas.MVVM.Pages.Home"
             xmlns:viewmodel="clr-namespace:Cajas.MVVM.ViewModels"
             BackgroundColor="{StaticResource complement}"
             Title="Home">
    <ContentPage.BindingContext>
        <viewmodel:HomeViewModel/>
    </ContentPage.BindingContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="1" Margin="30,30,30,10">
            <Label Text="Hola," TextColor="Gray" HorizontalOptions="Start" FontSize="18"/>
            <Label Text="{Binding Name}" TextColor="Black" FontAttributes="Bold" FontFamily="LatoBold"
                    HorizontalOptions="Start" FontSize="24"/>
        </VerticalStackLayout>

        <StackLayout  Grid.Row="2" Margin="30,10,30,10">
            <Grid RowSpacing="10">
                <Grid.ColumnSpacing>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="iOS" Value="30"/>
                        <On Platform="Android" Value="10"/>
                    </OnPlatform>
                </Grid.ColumnSpacing>

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.6*"/>
                </Grid.ColumnDefinitions>

                <Frame
                   Padding="0" 
                   Grid.Row="0" 
                   Grid.RowSpan="2" 
                   Grid.Column="0"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   HasShadow="True"
                   BackgroundColor="Transparent">
                    <AbsoluteLayout 
                        Padding="0"
                        Margin="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                        <Image
                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional,WidthProportional,PositionProportional"
                            
                            Margin="0,0,0,0"
                            Scale="1.1"
                            Source="{Binding Imgs}"
                            Aspect="AspectFit"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand" />
                    </AbsoluteLayout>
                </Frame>


                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource base}"
                        BorderColor="Transparent" CornerRadius="20" Padding="0">

                    <Grid ColumnSpacing="5" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Margin="10" Padding="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BackgroundColor="White"
                                HeightRequest="40" WidthRequest="40" CornerRadius="20" BorderColor="Transparent">
                        </Frame>

                        <Image Margin="5" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="taxi.svg"></Image>

                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding User.partner.partnerReference}" TextColor="{StaticResource complement}" FontFamily="LatoBold"
                                FontSize="24"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Type}" TextColor="{StaticResource complement}"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource base}"
                        BorderColor="Transparent" CornerRadius="20" Padding="0">
                    <Grid ColumnSpacing="5" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"  Margin="10" Padding="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BackgroundColor="White"
                                HeightRequest="40" WidthRequest="40" CornerRadius="20" BorderColor="Transparent">
                        </Frame>

                        <Image Margin="5" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="money.svg"></Image>

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label  Text="100,100" TextColor="{StaticResource complement}" FontFamily="LatoBold" FontSize="18"/>
                            <!--<Label  Text="MXN" TextColor="{StaticResource complement}" FontFamily="LatoBold" FontSize="18"/>-->
                        </HorizontalStackLayout>

                        <Label Grid.Row="1" Grid.Column="1" Text="Saldo" TextColor="{StaticResource complement}"/>
                    </Grid>


                </Frame>

            </Grid>
        </StackLayout>

        <StackLayout Grid.Row="5" Margin="30,10,30,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Text="Mis datos" Grid.Row="0" Grid.Column="0" TextColor="Black" FontSize="18" FontAttributes="None"
                        HorizontalOptions="Start" VerticalOptions="Center" FontFamily="LatoBold" />

                <Frame BorderColor="Transparent" CornerRadius="15" BackgroundColor="{StaticResource Gray300}" Grid.Row="0" Grid.Column="1" Padding="10">
                    <HorizontalStackLayout >
                        <Label Text="Ingreso "  TextColor="White" FontSize="16" HorizontalOptions="End" VerticalOptions="Center" />
                        <Label Text="{Binding Partner.fechaingreso, StringFormat='{0:MMMM dd, yyyy}'}"  TextColor="White" FontSize="16" HorizontalOptions="End" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>
            </Grid>

        </StackLayout>

        <Frame Grid.Row="6" Margin="20,0,20,20" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="{StaticResource base}" BorderColor="Transparent" CornerRadius="20" Padding="0" VerticalOptions="StartAndExpand">
            <Grid Margin="20,20,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0"
                Style="{StaticResource TagLabel}"
                Text="N° Serie"
                   TextColor="white"
                HorizontalOptions="StartAndExpand"/>

                <Label Grid.Column="1" Grid.Row="0"
                Style="{StaticResource TagLabelR}"
                Text="{Binding Car.No_Serie}" 
                   TextColor="white"
                HorizontalOptions="EndAndExpand"/>

                <Label Grid.Column="0" Grid.Row="1"
                Style="{StaticResource TagLabel}"
                Text="Motor"  
                   TextColor="white"
                HorizontalOptions="StartAndExpand"/>

                <Label Grid.Column="1" Grid.Row="1"
                Style="{StaticResource TagLabelR}"
                Text="{Binding Car.Motor}"
                   TextColor="white"
                HorizontalOptions="EndAndExpand"/>

                <Label Grid.Column="0" Grid.Row="2"
                Style="{StaticResource TagLabel}"
                Text="Póliza"  
                   TextColor="white"
                HorizontalOptions="StartAndExpand"/>

                <Label Grid.Column="1" Grid.Row="2"
                Style="{StaticResource TagLabelR}"
                Text="{Binding Car.poliza}" 
                   TextColor="white"
                HorizontalOptions="EndAndExpand"/>

                <Label Grid.Column="0" Grid.Row="3"
                Style="{StaticResource TagLabel}"
                Text="Aseguradora"  
                   TextColor="white"
                HorizontalOptions="StartAndExpand"/>

                <Label Grid.Column="1" Grid.Row="3"
                Style="{StaticResource TagLabelR}"
                Text="{Binding Car.aseguradora}"  
                   TextColor="white"
                HorizontalOptions="EndAndExpand"/>

                <Label Grid.Column="0" Grid.Row="4"
                Style="{StaticResource TagLabel}"
                Text="Vence" 
                   TextColor="white"
                HorizontalOptions="StartAndExpand"/>

                <Label Grid.Column="1" Grid.Row="4"
                Style="{StaticResource TagLabelR}"
                Text="{Binding Car.vencepoliza}"
                   TextColor="white"
                HorizontalOptions="EndAndExpand"/>
            </Grid>
        </Frame>


    </Grid>
</ContentPage>