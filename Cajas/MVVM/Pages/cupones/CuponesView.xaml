<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    Title="Cajas"
    x:Class="Cajas.MVVM.Pages.cupones.CuponesView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:cupones="clr-namespace:Cajas.MVVM.ViewModels.cupones" 
    Style="{StaticResource ApplicationPageStyle}"
	xmlns:viewModels="clr-namespace:Cajas.MVVM.ViewModels.cupones"
	xmlns:Models="clr-namespace:radiotaxi.Model;assembly=radiotaxi.Model"
    x:DataType="viewModels:CuponesViewModel"
	xmlns:utils="clr-namespace:Cajas.Utils"
	xmlns:behaviors="clr-namespace:Cajas.Behaviors">
    <Grid
        ColumnDefinitions="370,*"
        RowDefinitions="*,58">
        <!-- ===================================================== -->
        <!-- PANEL IZQUIERDO -->
        <!-- ===================================================== -->

        <Button Command="{Binding ReprintPaymentCommand}"></Button>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            BackgroundColor="{StaticResource PanelGreen}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1">
            <ScrollView
                Orientation="Vertical"
                VerticalScrollBarVisibility="Default">
                <Grid
                    Padding="0"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Grid
                        Padding="26,25,26,20"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
                        <!-- LOGOS -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Margin="0,0,0,22"
                            HorizontalOptions="Center"
                            Spacing="20">
                            <Image
                                Source="logotc.png"
                                HeightRequest="80"
                                WidthRequest="100"
                                Aspect="AspectFit" />
                            <BoxView
                                WidthRequest="1"
                                HeightRequest="75"
                                BackgroundColor="#D6DDD6"
                                VerticalOptions="Center" />
                            <Image
                                Source="adm.png"
                                HeightRequest="80"
                                WidthRequest="100"
                                Aspect="AspectFit" />
                        </HorizontalStackLayout>
                        <!-- SEPARADOR -->
                        <BoxView
                            Grid.Row="1"
                            Margin="0,0,0,25"
                            HeightRequest="1"
                            BackgroundColor="#DCE3DC" />
                        <!-- OPERADOR / SOCIO -->
                        <HorizontalStackLayout
                            Grid.Row="2"
                            Margin="0,0,0,14"
                            Spacing="9">
                            <Label
                                Text="&#xf007;"
                                FontFamily="FASolid"
                                FontSize="18"
                                TextColor="{StaticResource PrimaryGreen}"
                                VerticalTextAlignment="Center" />
                            <Label
                                Style="{StaticResource SectionTitle}"
                                Text="OPERADOR / SOCIO" />
                        </HorizontalStackLayout>
                        <!-- BUSCADOR DE OPERADOR -->
                        <VerticalStackLayout
                            Grid.Row="3"
                            Spacing="8">
                            <Label
                                Text="ID o Número de identificación"
                                Style="{StaticResource FieldLabel}" />
                            <Grid ColumnDefinitions="*,52">
                                <Border
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource InputBorder}">
                                    <Entry
                                        x:Name="OperatorEntry"
                                        Text="{Binding OperatorCredential, Mode=TwoWay}"
                                        Style="{StaticResource InputEntry}"
                                        Placeholder="Ingrese ID o número"
                                        ReturnType="Search"
                                        utils:WindowsTabNavigation.Order="1"
                                        ReturnCommand="{ Binding SearchOperatorCommand}"
                                        />
                                </Border>
                                <ImageButton
                                    x:Name="SearchOperatorButton"
                                    Grid.Column="1"
                                    behaviors:HandCursor.Enabled="True"
                                    Command="{Binding SearchOperatorCommand}"
                                    Style="{StaticResource SquarePrimaryImageButton}">
                                    <ImageButton.Source>
                                        <FontImageSource
                                            FontFamily="FASolid"
                                            Glyph="&#xf002;"
                                            Size="19"
                                            Color="White" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </VerticalStackLayout>
                        <!-- TARJETA DEL OPERADOR -->
                        <Border
                            Grid.Row="4"
                            Margin="0,18,0,24"
                            Style="{StaticResource CardBorder}">
                            <Grid
                                ColumnDefinitions="82,*"
                                RowDefinitions="Auto,Auto,Auto">
                                <!-- AVATAR -->
                                <Border
                                    Grid.RowSpan="3"
                                    WidthRequest="72"
                                    HeightRequest="72"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    BackgroundColor="#E8F5E4"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="36" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image
                                            Source="{Binding Imgs}"
                                            Aspect="AspectFill"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill" />
                                        <ActivityIndicator
                                            IsRunning="{Binding IsLoadingImage}"
                                            IsVisible="{Binding IsLoadingImage}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Color="{StaticResource PrimaryGreen}" />
                                    </Grid>
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding OperatorName}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding OperatorCredential, StringFormat='Gafete: {0}'}"
                                    FontSize="14"
                                    TextColor="{StaticResource TextSecondary}" />
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Spacing="4">
                                    <Label
                                        Text="Estado:"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}"/>
                                    <Label
                                        Text="{Binding OperatorStatus}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#24803D" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                        <!-- SEPARADOR -->
                        <BoxView
                            Grid.Row="5"
                            Margin="0,0,0,22"
                            HeightRequest="1"
                            BackgroundColor="#DCE3DC" />
                        <!-- TÍTULO RESUMEN -->
                        <HorizontalStackLayout
                            Grid.Row="6"
                            Margin="0,0,0,14"
                            Spacing="9">
                            <Label
                                Text="&#xf080;"
                                FontFamily="FASolid"
                                FontSize="18"
                                TextColor="{StaticResource PrimaryGreen}"
                                VerticalTextAlignment="Center" />
                            <Label
                                Style="{StaticResource SectionTitle}"
                                Text="RESUMEN" />
                        </HorizontalStackLayout>
                        <!-- TARJETAS Y BOTONES -->
                        <VerticalStackLayout
                            Grid.Row="7"
                            Spacing="12">
                            <!-- CUPONES ESCANEADOS -->
                            <Border
                                Style="{StaticResource CardBorder}"
                                Padding="18,14">
                                <Grid
                                    ColumnDefinitions="62,*"
                                    RowDefinitions="Auto,Auto">
                                    <Label
                                        Grid.RowSpan="2"
                                        Text="&#xf145;"
                                        FontFamily="FASolid"
                                        FontSize="28"
                                        TextColor="{StaticResource PrimaryGreen}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Cupones escaneados"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding CouponsCount}"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                            </Border>
                            <!-- TOTAL ACUMULADO -->
                            <Border
                                Style="{StaticResource CardBorder}"
                                Padding="18,14">
                                <Grid
                                    ColumnDefinitions="62,*"
                                    RowDefinitions="Auto,Auto">
                                    <Label
                                        Grid.RowSpan="2"
                                        Text="&#xf0d6;"
                                        FontFamily="FASolid"
                                        FontSize="28"
                                        TextColor="{StaticResource PrimaryGreen}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Total acumulado"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding TotalAmount, StringFormat='${0:N2}'}"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryGreen}" />
                                </Grid>
                            </Border>
                            <!-- COBRAR CUPONES -->
                            <Button
                                Margin="0,10,0,0"
                                HeightRequest="64"
                                Text="PAGAR CUPONES"
                                FontSize="16"
                                Command="{Binding PrePayCuponCommand}"
                                Style="{StaticResource PrimaryButton}"
                                behaviors:HandCursor.Enabled="True"
                                ContentLayout="Left,12">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FASolid"
                                        Glyph="&#xf0d6;"
                                        Size="20"
                                        Color="White" />
                                </Button.ImageSource>
                            </Button>
                            <!-- LIMPIAR TODO -->
                            <Button
                                HeightRequest="58"
                                Text="LIMPIAR TODO"
                                Style="{StaticResource SecondaryButton}"
                                behaviors:HandCursor.Enabled="True"
                                ContentLayout="Left,12"
                                Command="{Binding CleanCommand}"
                                >
                                
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FASolid"
                                        Glyph="&#xf0e2;"
                                        Size="18"
                                        Color="{StaticResource TextPrimary}" />
                                </Button.ImageSource>
                            </Button>
                            <!-- ===================================================== -->
                            <!-- AQUI EMPIEZA MI MODIFICACION MI INTENDO DE MVVM PARA LO DEL SLIDE BOTON -->
                            <!-- ===================================================== -->
                            <Button
                                HeightRequest="58"
                                Text="HISTORIAL DE PAGOS"
                                Command="{Binding ShowHistoryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                behaviors:HandCursor.Enabled="True"
                                ContentLayout="Left,12">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FASolid"
                                        Glyph="&#xf1da;"
                                        Size="18"
                                        Color="{StaticResource TextPrimary}" />
                                </Button.ImageSource>
                            </Button>
                            <!-- ===================================================== -->
                            <!-- FIN BOTÓN OFFCANVAS - HISTORIAL DE PAGOS -->
                            <!-- ===================================================== -->
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </ScrollView>
        </Border>
        <!-- ===================================================== -->
        <!-- PANEL DERECHO -->
        <!-- ===================================================== -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Padding="40,38,40,30"
            RowDefinitions="Auto,Auto,Auto,*"
            BackgroundColor="#FFFFFF">
            <!-- ===================================================== -->
            <!-- TÍTULO -->
            <!-- ===================================================== -->
            <Label
                Grid.Row="0"
                Text="ESCANEAR CUPÓN"
                Style="{StaticResource SectionTitle}"
                FontSize="17" />
            <!-- ===================================================== -->
            <!-- ENTRADA DEL CUPÓN -->
            <!-- ===================================================== -->
            <!-- ===================================================== -->
            <!-- PROVEEDOR + ESCANEAR CUPÓN -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="1"
                Margin="0,18,0,0"
                ColumnDefinitions="1*,4*"
                ColumnSpacing="16">

                <!-- ================================================= -->
                <!-- PROVEEDOR -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="8">

                    <HorizontalStackLayout
                        Spacing="7"
                        VerticalOptions="Center">

                        <Label
                            Text="&#xf007;"
                            FontFamily="FASolid"
                            FontSize="14"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center" />

                        <Label
                            Text="Proveedor"
                            Style="{StaticResource FieldLabel}"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                    <Border
                        HeightRequest="61"
                        Style="{StaticResource InputBorder}">

                        <Picker
                            Margin="10,0"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center"
                            ItemsSource="{Binding Hotels}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedHotel}"
                            SelectedIndex="0">
                   
                        </Picker>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- CUPÓN -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="8">

                    <HorizontalStackLayout
                        Spacing="7"
                        VerticalOptions="Center">

                        <Label
                            Text="&#xf02b;"
                            FontFamily="FASolid"
                            FontSize="14"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center" />

                        <Label
                            Text="Código del cupón"
                            Style="{StaticResource FieldLabel}"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                    <Border
                        HeightRequest="61"
                        Style="{StaticResource InputBorder}">

                        <Grid ColumnDefinitions="*,65">

                            <!-- Entry oculto, necesario para mantener compatibilidad -->
                            <Entry
                                x:Name="CouponCodeEntry"
                                Grid.Column="0"
                                Placeholder=""
                                ReturnType="Done"
                                Opacity="0.01"
                                FontSize="1"
                                IsVisible="True"
                                TranslationX="-5000"
                                WidthRequest="1"
                                HeightRequest="1" />

                            <!-- Entry visible -->
                            <Entry
                                x:Name="CoupontTextInsertEntry"
                                Grid.Column="0"
                                Style="{StaticResource InputEntry}"
                                Text="{Binding CouponCode}"
                                Margin="15,0"
                                HeightRequest="61"
                                FontSize="16"
                                Placeholder="Escanee o ingrese el código del cupón..."
                                ReturnType="Done"
                                utils:WindowsTabNavigation.Order="2"
                                ReturnCommand="{Binding AddCouponCommand}" />

                            <!-- Separador -->
                            <BoxView
                                Grid.Column="1"
                                WidthRequest="1"
                                BackgroundColor="#E3E3E3"
                                HorizontalOptions="Start" />

                            <!-- Botón buscar -->
                            <ImageButton
                                Grid.Column="1"
                                WidthRequest="58"
                                HeightRequest="58"
                                Padding="17"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                behaviors:HandCursor.Enabled="True"
                                Command="{Binding AddCouponCommand}">

                                <ImageButton.Source>
                                    <FontImageSource
                                        FontFamily="FASolid"
                                        Glyph="&#xf002;"
                                        Size="21"
                                        Color="{StaticResource PrimaryGreen}" />
                                </ImageButton.Source>

                            </ImageButton>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </Grid>
            <!-- ===================================================== -->
            <!-- TEXTO DE AYUDA -->
            <!-- ===================================================== -->
            <HorizontalStackLayout
                Grid.Row="2"
                Margin="0,14,0,35"
                Spacing="8">
                <Label
                    Text="El lector de código QR agregará el cupón automáticamente."
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalTextAlignment="Center" />
                <Label
                    Text="&#xf05a;"
                    FontFamily="FASolid"
                    FontSize="14"
                    TextColor="{StaticResource PrimaryGreen}"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <!-- ===================================================== -->
            <!-- TABLA -->
            <!-- ===================================================== -->
            <Grid
            Grid.Row="3"
            RowDefinitions="Auto,*">
                <!-- ===================================================== -->
                <!-- TÍTULO -->
                <!-- ===================================================== -->
                <Label
                Grid.Row="0"
                Margin="0,0,0,17"
                Text="CUPONES ESCANEADOS"
                Style="{StaticResource SectionTitle}"
                FontSize="17" />
                <!-- ===================================================== -->
                <!-- CONTENEDOR DE LA TABLA -->
                <!-- ===================================================== -->
                <Border
                Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="0">
                    <Grid RowDefinitions="57,*">
                        <!-- ===================================================== -->
                        <!-- ENCABEZADO -->
                        <!-- ===================================================== -->
                        <Grid
                        Grid.Row="0"
                        Padding="20,0"
                        ColumnDefinitions="1.5*,0.8*,1.2*,1*,1.1*,75"
                        BackgroundColor="{StaticResource TableHeaderBackground}">
                            <Label
                            Grid.Column="0"
                            Style="{StaticResource TableHeader}"
                            Text="Serie del cupón"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Column="1"
                            Style="{StaticResource TableHeader}"
                            Text="Valor"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Column="2"
                            Style="{StaticResource TableHeader}"
                            Text="Vigencia"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Column="3"
                            Style="{StaticResource TableHeader}"
                            Text="Pago"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Column="4"
                            Style="{StaticResource TableHeader}"
                            Text="Estado"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Column="5"
                            Style="{StaticResource TableHeader}"
                            Text="Acciones"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                        </Grid>
                        <!-- ===================================================== -->
                        <!-- LISTADO -->
                        <!-- ===================================================== -->
                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding Cupons}"
                            SelectionMode="None"
                            BackgroundColor="White"
                            VerticalScrollBarVisibility="Always"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                            <!-- ================================================= -->
                            <!-- VISTA VACÍA -->
                            <!-- ================================================= -->
                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                Margin="0,80,0,0"
                                HorizontalOptions="Center"
                                Spacing="8">
                                    <Label
                                    Text="&#xf029;"
                                    FontFamily="FASolid"
                                    FontSize="42"
                                    TextColor="#D5D5D5"
                                    HorizontalTextAlignment="Center" />
                                    <Label
                                    Text="No hay cupones escaneados"
                                    FontSize="16"
                                    TextColor="{StaticResource TextMuted}"
                                    HorizontalTextAlignment="Center" />
                                    <Label
                                    Text="Escanea un código QR para comenzar"
                                    FontSize="13"
                                    TextColor="{StaticResource TextLight}"
                                    HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <!-- ================================================= -->
                            <!-- FILAS -->
                            <!-- ================================================= -->
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="Models:Cupon">
                                    <Grid
                                    RowDefinitions="64,1"
                                    BackgroundColor="White"
                                    IsClippedToBounds="True">
                                        <!-- ===================================== -->
                                        <!-- CONTENEDOR DE LA FILA -->
                                        <!-- ===================================== -->
                                        <Border
                                        Grid.Row="0"
                                        BackgroundColor="White"
                                        StrokeThickness="0">
                                            <!-- Fondo y sombra cuando está pagado -->
                                            <Border.Triggers>
                                                <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Paid}"
                                                Value="True">
                                                    <Setter
                                                    Property="BackgroundColor"
                                                    Value="#FFF1F1" />
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow
                                                            Brush="#80D32F2F"
                                                            Offset="0,2"
                                                            Radius="7"
                                                            Opacity="0.28" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding Paid}"
                                                    Value="False">
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="White" />
                                                    <Setter
                                                        Property="Shadow"
                                                        Value="{x:Null}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <!-- ================================= -->
                                            <!-- CONTENIDO DE LA FILA -->
                                            <!-- ================================= -->
                                            <Grid ColumnDefinitions="5,1.5*,0.8*,1.2*,1*,1.1*,75">
                                                <!-- Línea lateral roja -->
                                                <BoxView
                                                Grid.Column="0"
                                                BackgroundColor="Transparent">
                                                    <BoxView.Triggers>
                                                        <DataTrigger
                                                        TargetType="BoxView"
                                                        Binding="{Binding Paid}"
                                                        Value="True">
                                                            <Setter
                                                            Property="BackgroundColor"
                                                            Value="#D32F2F" />
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                                <!-- ================================= -->
                                                <!-- SERIE DEL CUPÓN -->
                                                <!-- ================================= -->
                                                <Label
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Style="{StaticResource TableCell}"
                                                FontAttributes="Bold"
                                                LineBreakMode="NoWrap"
                                                VerticalTextAlignment="Center">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0}-{1}-{2}">
                                                            <Binding Path="Couponrate.Hotel.shortname" />
                                                            <Binding Path="DisplayFolio" />
                                                            <Binding Path="Couponrate.Cupontype.Name" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding Paid}"
                                                        Value="True">
                                                            <Setter
                                                            Property="TextColor"
                                                            Value="#7A4040" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <!-- ================================= -->
                                                <!-- VALOR -->
                                                <!-- ================================= -->
                                                <Label
                                                Grid.Column="2"
                                                Style="{StaticResource TableCell}"
                                                Text="{Binding Couponrate.Valor, StringFormat='${0:N2}'}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding Paid}"
                                                        Value="True">
                                                            <Setter
                                                            Property="TextColor"
                                                            Value="#7A4040" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <!-- ================================= -->
                                                <!-- VIGENCIA -->
                                                <!-- ================================= -->
                                                <Label
                                                Grid.Column="3"
                                                Style="{StaticResource TableCell}"
                                                Text="{Binding CreateDate, StringFormat='{0:dd/MM/yyyy}'}"
                                                TextColor="{StaticResource TextSecondary}"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding Paid}"
                                                        Value="True">
                                                            <Setter
                                                            Property="TextColor"
                                                            Value="#9A6666" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <!-- ================================= -->
                                                <!-- PAGO -->
                                                <!-- ================================= -->
                                                <Border
                                                Grid.Column="4"
                                                Padding="10,5"
                                                StrokeThickness="1"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="5" />
                                                    </Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <!-- PAGADO EN ROJO -->
                                                        <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding Paid}"
                                                        Value="True">
                                                            <Setter
                                                            Property="BackgroundColor"
                                                            Value="#FDE4E4" />
                                                            <Setter
                                                            Property="Stroke"
                                                            Value="#D32F2F" />
                                                        </DataTrigger>
                                                        <!-- PENDIENTE EN AMARILLO -->
                                                        <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding Paid}"
                                                        Value="False">
                                                            <Setter
                                                            Property="BackgroundColor"
                                                            Value="{StaticResource WarningBackground}" />
                                                            <Setter
                                                            Property="Stroke"
                                                            Value="{StaticResource Warning}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center">
                                                        <Label.Triggers>
                                                            <!-- Texto pagado -->
                                                            <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Paid}"
                                                            Value="True">
                                                                <Setter
                                                                Property="Text"
                                                                Value="PAGADO" />
                                                                <Setter
                                                                Property="TextColor"
                                                                Value="#C62828" />
                                                            </DataTrigger>
                                                            <!-- Texto pendiente -->
                                                            <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Paid}"
                                                            Value="False">
                                                                <Setter
                                                                Property="Text"
                                                                Value="PENDIENTE" />
                                                                <Setter
                                                                Property="TextColor"
                                                                Value="{StaticResource Warning}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                                <!-- ================================= -->
                                                <!-- ESTADO ACTIVO / INACTIVO -->
                                                <!-- ================================= -->
                                                <Border
                                                Grid.Column="5"
                                                Padding="10,5"
                                                StrokeThickness="1"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="5" />
