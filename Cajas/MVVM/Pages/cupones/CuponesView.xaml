                        Text="&#xf1da;"
                        FontFamily="FASolid"
                        FontSize="19"
                        TextColor="{StaticResource PrimaryGreen}"
                        VerticalTextAlignment="Center" />
                                    <Label
                        Text="HISTORIAL DE PAGOS"
                        Style="{StaticResource SectionTitle}"
                        FontSize="20"
                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Label
                    Text="Consulta y reimprime comprobantes de pagos realizados."
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <!-- CERRAR DRAWER -->
                            <ImageButton
                                Grid.Column="1"
                                WidthRequest="38"
                                HeightRequest="38"
                                Padding="10"
                                BackgroundColor="Transparent"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                behaviors:HandCursor.Enabled="True"
                                Command="{Binding HideHistoryCommand}"
                                >
                                <ImageButton.Source>
                                    <FontImageSource
                        FontFamily="FASolid"
                        Glyph="&#xf00d;"
                        Size="18"
                        Color="{StaticResource TextPrimary}" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                        <!-- ================================================= -->
                        <!-- BUSCADOR -->
                        <!-- ================================================= -->
                        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8">
                            <Label
                Text="Buscar por folio de pago"
                Style="{StaticResource FieldLabel}" />
                            <Border
                HeightRequest="54"
                Style="{StaticResource InputBorder}">
                                <Grid
                    ColumnDefinitions="*,52">
                                    <Entry
                        Grid.Column="0"
                        Margin="14,0,0,0"
                        Style="{StaticResource InputEntry}"
                        Placeholder="Ingrese el folio de pago..."
                        Keyboard="Numeric"
                        ReturnType="Search" />
                                    <BoxView
                        Grid.Column="1"
                        WidthRequest="1"
                        HorizontalOptions="Start"
                        BackgroundColor="#E3E3E3" />
                                    <ImageButton
                        Grid.Column="1"
                        WidthRequest="50"
                        HeightRequest="50"
                        Padding="15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        behaviors:HandCursor.Enabled="True">
                                        <ImageButton.Source>
                                            <FontImageSource
                                FontFamily="FASolid"
                                Glyph="&#xf002;"
                                Size="18"
                                Color="{StaticResource PrimaryGreen}" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <!-- ================================================= -->
                        <!-- CONTADOR -->
                        <!-- ================================================= -->
                        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto">
                            <Label
                Text="REGISTRO DE PAGOS"
                Style="{StaticResource SectionTitle}"
                FontSize="15"
                VerticalTextAlignment="Center" />
                            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="5"
                VerticalOptions="Center">
                                <Label
                    Text="{Binding Payments.Count}"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryGreen}" />
                                <Label
                    Text="registro(s)"
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <!-- ================================================= -->
                        <!-- TABLA HISTORIAL -->
                        <!-- ================================================= -->
                        <Border
            Grid.Row="3"
            Padding="0"
            Style="{StaticResource CardBorder}">
                            <Grid
                RowDefinitions="56,*">
                                <!-- ============================================= -->
                                <!-- CABECERA -->
                                <!-- ============================================= -->
                                <Grid
                    Grid.Row="0"
                    Padding="16,0"
                    ColumnDefinitions="0.75*,1.75*,0.85*,0.95*,1.35*,1.05*"
                    BackgroundColor="{StaticResource TableHeaderBackground}">
                                    <Label
                        Grid.Column="0"
                        Text="Folio"
                        Style="{StaticResource TableHeader}"
                        VerticalTextAlignment="Center" />
                                    <Label
                        Grid.Column="1"
                        Text="Operador / Socio"
                        Style="{StaticResource TableHeader}"
                        VerticalTextAlignment="Center" />
                                    <Label
                        Grid.Column="2"
                        Text="Cupones"
                        Style="{StaticResource TableHeader}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                                    <Label
                        Grid.Column="3"
                        Text="Total"
                        Style="{StaticResource TableHeader}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                                    <Label
                                    Grid.Column="4"
                                    Text="Fecha de pago"
                                    Style="{StaticResource TableHeader}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                                    <Label
                                        
                                    Grid.Column="5"
                                    Text="Acción"
                                    Style="{StaticResource TableHeader}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                                </Grid>
                                <!-- ============================================= -->
                                <!-- COLLECTION VIEW -->
                                <!-- ============================================= -->
                                <CollectionView
                                    
                                    Grid.Row="1"
                                    ItemsSource="{Binding Payments}"
                                    BackgroundColor="White"
                                    VerticalOptions="FillAndExpand"
                                    HorizontalOptions="FillAndExpand"
                                    SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="0" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <VerticalStackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                                            <Label
                                Text="No hay pagos registrados."
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:CouponPaymentItemViewModel">
                                            <VerticalStackLayout
                                                Spacing="0"
                                                BackgroundColor="White">
                                                <!-- ================================================= -->
                                                <!-- FILA PRINCIPAL DEL PAGO -->
                                                <!-- ================================================= -->
                                                <Grid
                                                    Background="White"
                                                    HeightRequest="66"
                                                    Padding="16,0"
                                                    ColumnDefinitions="0.75*,1.75*,0.85*,0.95*,1.35*,1.05*">
                                                    <!-- FOLIO -->
                                                    <Label
                                                        Grid.Column="0"
                                                        Text="{Binding Payment.CouponPaymentId}"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        VerticalTextAlignment="Center" />
                                                    <!-- OPERADOR / SOCIO -->
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Payment.user.partnerReference}"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalTextAlignment="Center" />
                                                    <!-- TOTAL DE CUPONES -->
                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding Payment.Cupons.Count}"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center" />
                                                    <!-- TOTAL -->
                                                    <Label
                                                        Grid.Column="3"
                                                        Text="{Binding Payment.TotalAmount, StringFormat='${0:N2}'}"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource PrimaryGreen}"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center" />
                                                    <!-- FECHA DE PAGO -->
                                                    <Label
                                                        Grid.Column="4"
                                                        Text="{Binding Payment.CreatedDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center" />
                                                    <!-- ACCIÓN -->
                                                    <!-- ACCIONES -->
                                                    <HorizontalStackLayout
                                                        Grid.Column="5"
                                                        Spacing="10"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">

                                                        <!-- ============================================= -->
                                                        <!-- VER DETALLE -->
                                                        <!-- FontAwesome: Eye -->
                                                        <!-- ============================================= -->
                                                        <ImageButton
                                                            WidthRequest="38"
                                                            HeightRequest="38"
                                                            Padding="10"
                                                            BackgroundColor="Transparent"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TogglePaymentCommand}"
                                                            CommandParameter="{Binding .}"
                                                            behaviors:HandCursor.Enabled="True">

                                                            <ImageButton.Source>
                                                                <FontImageSource
                                                                    FontFamily="FASolid"
                                                                    Glyph="&#xf06e;"
                                                                    Size="17"
                                                                    Color="{StaticResource PrimaryGreen}" />
                                                            </ImageButton.Source>

                                                        </ImageButton>


                                                        <!-- ============================================= -->
                                                        <!-- REIMPRIMIR TICKET -->
                                                        <!-- FontAwesome: Print -->
                                                        <!-- ============================================= -->
                                                        <ImageButton
                                                            WidthRequest="38"
                                                            HeightRequest="38"
                                                            Padding="10"
                                                            BackgroundColor="Transparent"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReprintPaymentCommand}"
                                                            CommandParameter="{Binding .}"
                                                            behaviors:HandCursor.Enabled="True">

                                                            <ImageButton.Source>
                                                                <FontImageSource
                                                                    FontFamily="FASolid"
                                                                    Glyph="&#xf02f;"
                                                                    Size="17"
                                                                    Color="{StaticResource TextPrimary}" />
                                                            </ImageButton.Source>

                                                        </ImageButton>

                                                    </HorizontalStackLayout>
                                                </Grid>
                                                <!-- ================================================= -->
                                                <!-- SUBLISTA DE CUPONES -->
                                                <!-- ================================================= -->
                                                <!-- ================================================= -->
                                                <!-- SUBLISTA DE CUPONES DEL PAGO -->
                                                <!-- ================================================= -->

                                                <Border
                                                    IsVisible="{Binding IsExpanded}"
                                                    Margin="16,8,16,12"
                                                    Padding="0"
                                                    BackgroundColor="#F8FAF8"
                                                    Stroke="{StaticResource BorderColor}"
                                                    StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>

                                                    <VerticalStackLayout Spacing="0">

                                                        <!-- ============================================= -->
                                                        <!-- CABECERA DE LA SUBLISTA -->
                                                        <!-- ============================================= -->

                                                        <Grid
                                                            HeightRequest="42"
                                                            Padding="14,0"
                                                            BackgroundColor="#EEF5EF"
                                                            ColumnDefinitions="0.75*,1.60*,0.90*,1.10*">

                                                            <Label
                                                                Grid.Column="0"
                                                                Text="ID"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{StaticResource PrimaryGreen}"
                                                                VerticalTextAlignment="Center" />

                                                            <Label
                                                                Grid.Column="1"
                                                                Text="Cupón"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{StaticResource PrimaryGreen}"
                                                                VerticalTextAlignment="Center" />

                                                            <Label
                                                                Grid.Column="2"
                                                                Text="Valor"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{StaticResource PrimaryGreen}"
                                                                HorizontalTextAlignment="Center"
                                                                VerticalTextAlignment="Center" />

                                                            <Label
                                                                Grid.Column="3"
                                                                Text="Fecha"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{StaticResource PrimaryGreen}"
                                                                HorizontalTextAlignment="Center"
                                                                VerticalTextAlignment="Center" />

                                                        </Grid>

                                                        <!-- ============================================= -->
                                                        <!-- CUPONES DEL PAGO -->
                                                        <!-- ============================================= -->

                                                        <VerticalStackLayout
                                                            Padding="14,0"
                                                            Spacing="0">

                                                            <BindableLayout.ItemsSource>
                                                                <Binding Path="Payment.Cupons" />
                                                            </BindableLayout.ItemsSource>

                                                            <BindableLayout.ItemTemplate>

                                                                <DataTemplate x:DataType="Models:Cupon">

                                                                    <Grid
                                                                        HeightRequest="46"
                                                                        ColumnDefinitions="0.75*,1.60*,0.90*,1.10*">

                                                                        <!-- ID -->

                                                                        <Label
                                                                            Grid.Column="0"
                                                                            Text="{Binding DisplayFolio}"
                                                                            FontSize="12"
                                                                            FontAttributes="Bold"
                                                                            TextColor="{StaticResource TextPrimary}"
                                                                            VerticalTextAlignment="Center" />

                                                                        <!-- CUPÓN -->

                                                                        <Label
                                                                            Grid.Column="1"
                                                                            FontSize="12"
                                                                            TextColor="{StaticResource TextPrimary}"
                                                                            LineBreakMode="TailTruncation"
                                                                            VerticalTextAlignment="Center">

                                                                            <Label.Text>

                                                                                <MultiBinding StringFormat="{}{0}-{1}-{2}">

                                                                                    <Binding Path="Couponrate.Hotel.shortname" />

                                                                                    <Binding Path="DisplayFolio" />

                                                                                    <Binding Path="Couponrate.Cupontype.Name" />

                                                                                </MultiBinding>

                                                                            </Label.Text>

                                                                        </Label>

                                                                        <!-- VALOR -->

                                                                        <Label
                                                                            Grid.Column="2"
                                                                            Text="{Binding Couponrate.Valor, StringFormat='${0:N2}'}"
                                                                            FontSize="12"
                                                                            FontAttributes="Bold"
                                                                            TextColor="{StaticResource PrimaryGreen}"
                                                                            HorizontalTextAlignment="Center"
                                                                            VerticalTextAlignment="Center" />

                                                                        <!-- FECHA -->

                                                                        <Label
                                                                            Grid.Column="3"
                                                                            Text="{Binding PaymentDate, StringFormat='{0:dd/MM/yyyy}'}"
                                                                            FontSize="12"
                                                                            TextColor="{StaticResource TextSecondary}"
                                                                            HorizontalTextAlignment="Center"
                                                                            VerticalTextAlignment="Center" />

                                                                    </Grid>

                                                                </DataTemplate>

                                                            </BindableLayout.ItemTemplate>

                                                        </VerticalStackLayout>

                                                    </VerticalStackLayout>

                                                </Border>
                                                <!-- SEPARADOR ENTRE PAGOS -->
                                                <BoxView
                                                    HeightRequest="1"
                                                    BackgroundColor="{StaticResource SeparatorColor}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <!-- ===================================================== -->
        <!-- MODAL CONFIRMAR COBRO -->
        <!-- ===================================================== -->
        <Grid
        x:Name="ChargeModalOverlay"
        Grid.Row="0"
        Grid.Column="0"
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        ZIndex="100"
        IsVisible="{Binding ShowChargeModal}"
        BackgroundColor="{StaticResource ModalOverlayColor}">
            <Border
            x:Name="ChargeModalCard"
            WidthRequest="520"
            Style="{StaticResource ModalCard}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Scale="0.92">
                <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="14">
                    <!-- CERRAR -->
                    <ImageButton
                    Grid.Row="0"
                    WidthRequest="35"
                    HeightRequest="35"
                    Padding="10"
                    Margin="0,-8,-10,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Command="{Binding CloseChargeModalCommand}">
                        <ImageButton.Source>
                            <FontImageSource
                            FontFamily="FASolid"
                            Glyph="&#xf00d;"
                            Size="17"
                            Color="#333333" />
                        </ImageButton.Source>
                    </ImageButton>
                    <!-- ENCABEZADO -->
                    <VerticalStackLayout
                    Grid.Row="1"
                    Margin="0,-15,0,0"
                    Spacing="9"
                    HorizontalOptions="Center">
                        <Border
                        WidthRequest="66"
                        HeightRequest="66"
                        BackgroundColor="#E4F5E6"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="33" />
                            </Border.StrokeShape>
                            <Label
                            Text="&#xf00c;"
                            FontFamily="FASolid"
                            FontSize="30"
                            TextColor="{StaticResource PrimaryGreen}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                        </Border>
                        <Label
                        Text="¿Confirmar cobro de cupones?"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryGreen}"
                        HorizontalTextAlignment="Center" />
                        <Label
                        Text="Se cobrarán los cupones por un total de:"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />
                        <Label
                        Text="{Binding TotalAmount, StringFormat='${0:N2}'}"
                        FontSize="31"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryGreen}"
                        HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <!-- RESUMEN -->
                    <Border
                    Grid.Row="2"
                    Margin="5,4,5,0"
                    Padding="18,13"
                    BackgroundColor="#F3FAF3"
                    StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>
                        <Grid
                        ColumnDefinitions="32,*,Auto"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="12">
                            <!-- CANTIDAD -->
                            <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="&#xf145;"
                            FontFamily="FASolid"
                            FontSize="17"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Cantidad de cupones:"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Text="{Binding CouponsCount}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalTextAlignment="Center"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                            <!-- TOTAL -->
                            <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="&#xf0d6;"
                            FontFamily="FASolid"
                            FontSize="17"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Total a cobrar:"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="{Binding TotalAmount, StringFormat='${0:N2}'}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                            <!-- OPERADOR -->
                            <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="&#xf007;"
                            FontFamily="FASolid"
                            FontSize="17"
                            TextColor="{StaticResource PrimaryGreen}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="Operador / Socio:"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalTextAlignment="Center" />
                            <Label
                            Grid.Row="2"
                            Grid.Column="2"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End"
                            VerticalTextAlignment="Center"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="OperatorNumber"/>
                                        <Binding Path="OperatorName"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                    </Border>
                    <!-- SEPARADOR -->
                    <BoxView
                    Grid.Row="3"
                    Margin="-28,4,-28,0"
                    HeightRequest="1"
                    BackgroundColor="#E7E7E7" />
                    <!-- BOTONES -->
                    <Grid
                    Grid.Row="4"
                    Margin="0,4,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                        <Button
                        Grid.Column="0"
                        HeightRequest="51"
                        Text="CANCELAR"
                        FontSize="13"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CloseChargeModalCommand}"/>
                        <Button
                        Grid.Column="1"
                        HeightRequest="51"
                        Text="CONFIRMAR PAGO"
                        FontSize="13"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding PayCuponCommand}"
                        ContentLayout="Left,10">
                            <Button.ImageSource>
                                <FontImageSource
                                FontFamily="FASolid"
                                Glyph="&#xf058;"
                                Size="17"
                                Color="White" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- ===================================================== -->
        <!-- MODAL DE ALERTA -->
        <!-- ===================================================== -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            ZIndex="200"
            IsVisible="{Binding ShowAlertModal}"
            BackgroundColor="{StaticResource ModalOverlayColor}">
            <Border
                WidthRequest="430"
                Padding="28,24"
                BackgroundColor="White"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="#70000000"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.45" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Border
                        WidthRequest="66"
                        HeightRequest="66"
                        BackgroundColor="{Binding AlertBackgroundColor}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="33" />
                        </Border.StrokeShape>
                        <Label
                            Text="{Binding AlertIcon}"
                            FontFamily="FASolid"
                            FontSize="30"
                            TextColor="{Binding AlertColor}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                    <Label
                        Text="{Binding AlertTitle}"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="{Binding AlertColor}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding AlertMessage}"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                    <Button
                        Margin="0,8,0,0"
                        HeightRequest="50"
                        Text="ACEPTAR"
                        Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{Binding AlertColor}"
                        Command="{Binding CloseAlertCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>