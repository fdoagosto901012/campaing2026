<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Converter="clr-namespace:Cajas.Converters"
             Title="Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="white"
             x:Class="Cajas.MainPage">
    <ContentPage.Content>
        <Grid Padding="40">
            <Grid.RowDefinitions>
                <RowDefinition  Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout  Grid.Row="0" Grid.Column="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <Image WidthRequest="400" Source="logologin.png" Aspect="AspectFit" HorizontalOptions="Center"/>
                <Label Text="Iniciar sesion en Cajas" FontSize="20" TextColor="Black" FontAttributes="Bold" Margin="0,0,0,20" HorizontalOptions="Center"/>
                <Label Text="Your Email"/>
                <Entry Placeholder="E-mail" Text="{Binding Nickname}" TextColor="Black">
                    <Entry.Triggers>
                        <DataTrigger TargetType="Entry"  Value="True">
                            <Setter Property="TextColor" Value="Black" />
                        </DataTrigger>
                    </Entry.Triggers>
                </Entry>
                <Label Text="Password"/>
                <Entry Placeholder="Contraseña" IsPassword="True" Text="{Binding Password}" TextColor="Black">
                    <Entry.Triggers>
                        <DataTrigger TargetType="Entry" Value="True">
                            <Setter Property="TextColor" Value="Black" />
                        </DataTrigger>
                    </Entry.Triggers>
                </Entry>
                <Button
                    IsEnabled="{Binding Isbusy, Converter={Converter:InverseBoolConverter}}"
                    Text="Iniciar" 
                    BackgroundColor="{StaticResource btnBackgroundcolor}" 
                    TextColor="{StaticResource btntexgcolor}"
                    Margin="0,10,0,0" Command="{Binding ICommandNavToHomePage}"/>

                <Label HorizontalOptions="CenterAndExpand" Margin="0,10,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Create By " TextColor="Gray"/>
                            <Span Text="Tipping Point" TextColor="#7d87f1"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
